<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <DebugType>Full</DebugType>
    <RuntimeIdentifier>win10-x86</RuntimeIdentifier>
    <RuntimeIdentifier>win7-x86</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CodeAnalysisRuleSet>HRP.Website.ruleset</CodeAnalysisRuleSet>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CodeAnalysisRuleSet>HRP.Website.ruleset</CodeAnalysisRuleSet>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\**" />
    <Content Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Data\SPNames.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SPNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net" Version="0.1.0" />
    <PackageReference Include="BuildBundlerMinifier" Version="2.6.375" />
    <PackageReference Include="Dapper" Version="1.50.4" />
    <PackageReference Include="Fanex.Data" Version="2.1.0.1" />
    <PackageReference Include="Fanex.Data.Repository" Version="1.0.2.1" />
    <PackageReference Include="GoogleAuthenticator" Version="1.2.1" />
    <PackageReference Include="Microsoft.AspNetCore" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication" Version="2.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
    <PackageReference Include="NPOI" Version="2.3.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="6.7.1.4347" />
  </ItemGroup>

  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRP.Resources\HRP.Resources.csproj" />
    <ProjectReference Include="..\HRP.Services\HRP.Services.csproj" />
    <ProjectReference Include="..\HRP.Models\HRP.Models.csproj" />
    <ProjectReference Include="..\HRP.Core\HRP.Core.csproj" />
    <ProjectReference Include="..\HRP.Criteria\HRP.Criteria.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\bundles\account\css\" />
    <Folder Include="wwwroot\assets\bundles\account\js\" />
    <Folder Include="wwwroot\assets\bundles\auth\js\" />
    <Folder Include="wwwroot\assets\bundles\auth\css\" />
    <Folder Include="wwwroot\assets\bundles\configuration\js\" />
    <Folder Include="wwwroot\assets\bundles\configuration\css\" />
    <Folder Include="wwwroot\assets\bundles\bank\css\" />
    <Folder Include="wwwroot\assets\bundles\bank\js\" />
    <Folder Include="wwwroot\assets\bundles\currency\js\" />
    <Folder Include="wwwroot\assets\bundles\employee\" />
    <Folder Include="wwwroot\assets\bundles\user\css\" />
    <Folder Include="wwwroot\assets\bundles\user\js\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\lib\fanex-multiselect\HighLightSyntax\scripts\shBrushGroovy.js" />
    <None Include="wwwroot\lib\fanex-multiselect\HighLightSyntax\scripts\shCore.js" />
    <None Include="wwwroot\lib\fanex-multiselect\HighLightSyntax\scripts\shLegacy.js" />
    <None Include="wwwroot\lib\fanex-multiselect\HighLightSyntax\scripts\XRegExp.js" />
    <None Include="wwwroot\lib\jQuery-contextMenu\font\context-menu-icons.woff2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\ExcelTemplates\BankIn.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CreateLogsFolder" AfterTargets="AfterPublish">
    <MakeDir Directories="$(PublishDir)logs" Condition="!Exists('$(PublishDir)logs')" />
    <MakeDir Directories="$(PublishUrl)logs" Condition="!Exists('$(PublishUrl)logs')" />
  </Target>
</Project>