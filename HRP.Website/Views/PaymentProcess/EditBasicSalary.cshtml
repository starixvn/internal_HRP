@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.MonthlyPayroll
@model EditMonthlySalaryViewModel

@section Styles {
    <environment include="Development">
        <link href="~/assets/styles/pages/paymentprocess/payment-process.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/edit-basic-salary.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.PaymentProcess</li>
    <li class="active"></li>
</ol>

@Html.Partial("_Steps", (int)PaymentProcessStep.MonthlyPayroll)

<form class="search-form">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" value="@Html.DisplayFor(x => x.Month)" readonly />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control" disabled>
            <option value="@Model.CompanyId" selected="selected">@Model.CompanyCode</option>
        </select>
    </div>
</form>

<div class="search-form form-filter">
    <input asp-for="CompanyId" hidden />
    <input type="text" asp-for="Month" hidden />
    <div class="group">
        <label class="text">@ViewLang.IDNo</label>
        <input type="text" class="control" placeholder="" readonly />
    </div>
    <div class="group">
        <label class="text">@ViewLang.Employee</label>
        <input type="text" class="control" placeholder="" readonly />
    </div>
    <div class="group">
        <label class="text">Div/Dept/Cost Center</label>
        <select class="control width-200" disabled></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.WorkingDays</label>
        <select class="control width-92" asp-for="WorkingDays" disabled>
            <option value="">@ViewLang.All</option>
            <option value="22">22</option>
            <option value="26">26</option>
        </select>
    </div>
</div>
<div class="group-complex">
    <div>
        <label class="actual">@ViewLang.BasicSalary</label>
    </div>
    <div class="currency-amount">
        <select class="control" disabled>
            <option></option>
        </select>
        <input type="text" class="control" placeholder="" readonly />
    </div>
</div>

<div class="group-complex">
    <label class="bank-type">
        <input type="radio" value="Ebanking" />
        <span>@ViewLang.EBanking</span>
    </label>
    <div class="currency-amount">
        <select class="control">
            <option></option>
        </select>
        <input type="text" class="control" />
    </div>
    <div></div>
    <div class="payment-transaction">
        <label class="bank-type">@ViewLang.EBanking</label>
        <select class="control" name="ebanking">
            <option value="@((int) BankTypes.Ebanking)" selected></option>
        </select>
        <select class="control"></select>
    </div>
</div>
<div class="group-complex">
    <label class="bank-type">
        <input type="radio" />
        <span>@ViewLang.DirectBanking1</span>
    </label>
    <div class="currency-amount">
        <select class="control">
            <option></option>
        </select>
        <input type="text" class="control" />
    </div>
    <div></div>
    <div class="payment-transaction">
        <select class="control">
            <option></option>
        </select>
        <select class="control"></select>
    </div>
</div>
<div class="group-complex">
    <label class="bank-type">
        <input type="radio" />
        <span>@ViewLang.DirectBanking2</span>
    </label>
    <div class="currency-amount">
        <select class="control">
            <option></option>
        </select>
        <input type="text" class="control" />
    </div>
    <div></div>
    <div class="payment-transaction">
        <select class="control">
            <option></option>
        </select>
        <select class="control"></select>
    </div>
</div>
<div class="group-complex">
    <label class="bank-type">
        <input type="radio" />
        <span>@ViewLang.Cash</span>
    </label>
    <div class="currency-amount">
        <select class="control">
            <option></option>
        </select>
        <input type="text" class="control" />
    </div>
    <div></div>
    <div class="payment-transaction">
        <label class="bank-type">@ViewLang.Cash</label>
        <select class="control">
            <option></option>
        </select>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/assets/js/paymentprocess/edit-basic-salary.js"></script>
    </environment>
    <environment exclude="Development">
    </environment>
}