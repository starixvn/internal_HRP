@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.MonthlyPayroll
@model EditMonthlySalaryViewModel

@{
    var bankTypes = Html.GetEnumSelectList<BankTypes>().Where(x => int.Parse(x.Value) != (int)BankTypes.Ebanking);
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/tooltipster/dist/css/tooltipster.bundle.css" rel="stylesheet" />
        <link href="~/lib/tooltipster/dist/css/plugins/tooltipster/sideTip/themes/tooltipster-sideTip-light.min.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/payment-process.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/common.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/edit-basic-salary.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/paymentprocess/css/edit-basic-salary.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.PaymentProcess</li>
    <li class="like-link">
        <a asp-controller="PaymentProcess" asp-action="EmployeeMonthlyPayroll"
           asp-route-companyId="@Model.FilterInfo.CompanyId" asp-route-month="@Model.Month">@ViewLang.ViewEmployeeMonthlyPayroll</a>
    </li>
    <li class="active">@(Model.FilterInfo.IsHost ? ViewLang.EditMonthlyBasicSalary : ViewLang.ViewMonthlyBasicSalary)</li>
</ol>

<form class="search-form">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" value="@Html.DisplayFor(x => x.Month)" readonly />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control width-92 js-select2-disabled" disabled>
            <option value="@Model.FilterInfo.CompanyCode" selected="selected">@Model.FilterInfo.CompanyCode</option>
        </select>
    </div>
    <input type="text" asp-for="Month" hidden />
    <div class="group">
        <label class="text">@ViewLang.IDNo</label>
        <input type="text" class="control id-no" value="@Model.FilterInfo.IdNo" placeholder="" readonly />
    </div>
    <div class="group">
        <label class="text">@ViewLang.Employee</label>
        <input type="text" class="control width-200" value="@Model.FilterInfo.FullName" placeholder="" readonly />
    </div>
    <div class="group">
        <label class="text">Div/Dept/Cost Center</label>
        <select class="control width-140 js-select2-disabled" disabled>
            <option value="@Model.FilterInfo.CostCenter" selected="selected">@Model.FilterInfo.CostCenter</option>
        </select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.WorkingDays</label>
        <select class="control width-92 js-select2-disabled" disabled>
            <option value="@Model.MonthlyBasicSalary.WorkingDays" selected="selected">@Model.MonthlyBasicSalary.WorkingDays</option>
        </select>
    </div>
    @if (Model.FilterInfo.IsHost)
    {
        <div class="group">
            <button type="button" class="button -preset js-btnPreset">@ViewLang.Preset</button>
        </div>
    }
    <div class="group">
        <button type="button" class="button -add js-btnRefresh">@ViewLang.Refresh</button>
    </div>
</form>
<div class="payment-duration">
    <div class="date"><span class="required">*</span> @ViewLang.ThePaymentProcessDuration</div>
    <div class="date">@ViewLang.StartDate: <strong>@Html.DisplayFor(x => x.FilterInfo.StartDate)</strong></div>
    <div class="date">@ViewLang.DueDate: <strong>@Html.DisplayFor(x => x.FilterInfo.DueDate)</strong></div>
</div>

<form id="edit-basic-salary-form" asp-action="EditBasicSalary" asp-controller="PaymentProcess"
      data-ajax-method="post" data-ajax="true"
      data-ajax-success="editBasicSalary.onUpdateSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
    <div class="-has-icon msg-success hidden js-updateSuccess">
        <span>@Message.UpdateMonthlyBasicSalarySuccessfully You will be redirected in </span>
        <span class="count-down">3</span>
        <span> seconds.</span>
    </div>
    <div class="-has-icon msg-success hidden js-presetSuccess">
        <span>@Message.UpdateMonthlyBasicSalarySuccessfully System will be reload data in </span>
        <span class="count-down">3</span>
        <span> seconds.</span>
    </div>
    <div class="-has-border msg-error hidden"></div>

    <input type="checkbox" hidden asp-for="FilterInfo.IsHost" id="IsHost" />

    <input type="checkbox" hidden asp-for="IsRedirectToEditAllowance" />
    <input type="hidden" value="@Model.Month" name="Month" />
    <input type="hidden" asp-for="MonthlyBasicSalary.SalaryPerDay" />
    <input type="hidden" asp-for="FilterInfo.PayrollId" />
    <input type="hidden" asp-for="FilterInfo.EmployeeId" id="EmployeeId" />
    <input type="hidden" asp-for="FilterInfo.CompanyId" />
    <input type="hidden" asp-for="CachingFilter.EmployeeId" />
    <input type="hidden" asp-for="CachingFilter.Employee" />
    <input type="hidden" asp-for="CachingFilter.IDNo" />
    <input type="hidden" asp-for="CachingFilter.WorkingDays" />
    <input type="hidden" asp-for="CachingFilter.CostCenterIds" />
    <div class="list-message-error hidden">
        <span asp-validation-for="MonthlySalary.EbankingCurrencyId" class="message"></span>
        <span asp-validation-for="MonthlySalary.EbankingAmount" class="message"></span>
        <span asp-validation-for="MonthlySalary.EbankingAccountId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking1CurrencyId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking1Amount" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking1BankTypeId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking1AccountId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking2CurrencyId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking2Amount" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking2BankTypeId" class="message"></span>
        <span asp-validation-for="MonthlySalary.DirectBanking2AccountId" class="message"></span>
        <span asp-validation-for="MonthlySalary.CashCurrencyId" class="message"></span>
        <span asp-validation-for="MonthlySalary.CashAmount" class="message"></span>
        <span asp-validation-for="MonthlySalary.CashAccountId" class="message"></span>

        @for (var i = 0; i < Model.Additions.Count; i++)
        {
            <span asp-validation-for="Additions[i].UnitAmount" class="message"></span>
        }

        @for (var i = 0; i < Model.Deductions.Count; i++)
        {
            <span asp-validation-for="Deductions[i].UnitAmount" class="message"></span>
        }
    </div>

    <div class="form-information">
        <div class="d-flex">
            <div class="add">
                <div class="group-complex -layout-add -group-type">
                    <div class="group-title -no-space"><span class="icon-group"></span>@ViewLang.Add</div>
                    <div>@ViewLang.Description</div>
                    <div>@ViewLang.UnitAmount</div>
                    <div>@ViewLang.NoOfDays</div>
                    <div>@ViewLang.NetSalary</div>
                </div>
                <div class="group-complex -layout-add">
                    <div class="like-group-title">@ViewLang.BackPay</div>
                    <input hidden asp-for="Additions[0].Type" />
                    <input type="text" class="control js-description" asp-for="Additions[0].Description" readonly />
                    <input type="text" class="control number js-positiveNumberOnly" asp-for="Additions[0].UnitAmount" readonly>
                    <input type="text" class="control number -start-col-5 js-positiveNumberOnly js-addition-netSalaryDisplay" asp-for="Additions[0].NetSalaryDisplay" readonly>
                    <input hidden class="js-addition-netSalary" asp-for="Additions[0].NetSalary" />
                </div>
                <div class="group-complex -layout-add">
                    <div class="like-group-title">@ViewLang.Adjustments</div>
                    <input hidden asp-for="Additions[1].Type" />
                    <input type="text" class="control js-description" asp-for="Additions[1].Description">
                    <input type="text" class="control number js-positiveNumberOnly js-addition-unitAmount" asp-for="Additions[1].UnitAmount">
                    <input type="text" class="control js-positiveNumberOnly js-addition-noOfDays" asp-for="Additions[1].NoOfDays" maxlength="5" />
                    <input type="text" class="control number js-positiveNumberOnly js-addition-netSalaryDisplay" asp-for="Additions[1].NetSalaryDisplay" readonly>
                    <input hidden class="js-addition-netSalary" asp-for="Additions[1].NetSalary" />
                </div>
                <div class="group-complex -layout-add">
                    <div class="like-group-title">@ViewLang.Others</div>
                    <input hidden asp-for="Additions[2].Type" />
                    <input type="text" class="control js-description" asp-for="Additions[2].Description">
                    <input type="text" class="control number js-positiveNumberOnly js-addition-unitAmount" asp-for="Additions[2].UnitAmount">
                    <input type="text" class="control js-positiveNumberOnly js-addition-noOfDays" asp-for="Additions[2].NoOfDays" maxlength="5" />
                    <input type="text" class="control number js-positiveNumberOnly js-addition-netSalaryDisplay" asp-for="Additions[2].NetSalaryDisplay" readonly>
                    <input hidden class="js-addition-netSalary" asp-for="Additions[2].NetSalary" />
                </div>
                <div class="group-complex -layout-add">
                    <input hidden asp-for="Additions[3].Type" />
                    <input type="text" class="control -start-col-2 js-description" asp-for="Additions[3].Description">
                    <input type="text" class="control number js-positiveNumberOnly js-addition-unitAmount" asp-for="Additions[3].UnitAmount">
                    <input type="text" class="control js-positiveNumberOnly js-addition-noOfDays" asp-for="Additions[3].NoOfDays" maxlength="5" />
                    <input type="text" class="control number js-positiveNumberOnly js-addition-netSalaryDisplay" asp-for="Additions[3].NetSalaryDisplay" readonly>
                    <input hidden class="js-addition-netSalary" asp-for="Additions[3].NetSalary" />
                </div>
                <div class="group-complex -layout-add">
                    <div class="text-specific">@ViewLang.TotalAdd</div>
                    <input type="text" class="control number highlighted -start-col-5 bold js-positiveNumberOnly js-addition-totalNetSalaryDisplay"
                           asp-for="MonthlySalary.AdditionAmountDisplay" readonly />
                    <input hidden class="js-addition-totalNetSalary" asp-for="MonthlySalary.AdditionAmount" />
                </div>
            </div>
            <div class="deduction">
                <div class="group-complex -layout-deduction -group-type">
                    <div class="group-deduction m-b-0"><span class="icon-group"></span>@ViewLang.Deduction</div>
                    <div>@ViewLang.Description</div>
                    <div class="-start-col-5">@ViewLang.NetSalary</div>
                </div>
                <div class="group-complex -layout-deduction">
                    <div class="like-group-title">@ViewLang.UPLAbsenteeism</div>
                    <input hidden asp-for="Deductions[0].Type" />
                    <input type="text" class="control js-description" asp-for="Deductions[0].Description" />
                    <input type="text" class="control number js-positiveNumberOnly js-unpaidleave-absenteeism" asp-for="Deductions[0].NoOfDays" maxlength="5" />
                    <div>days</div>
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-netSalaryDisplay" asp-for="Deductions[0].NetSalaryDisplay" readonly />
                    <input hidden class="js-deduction-netSalary" asp-for="Deductions[0].NetSalary" />
                </div>
                <div class="group-complex -layout-deduction">
                    <div class="like-group-title">@ViewLang.Tardiness</div>
                    <input hidden asp-for="Deductions[1].Type" />
                    <input type="text" class="control js-description" asp-for="Deductions[1].Description" />
                    <input type="text" class="control number js-positiveNumberOnly js-tardiness" asp-for="Deductions[1].NoOfDays" maxlength="8" />
                    <div>minutes</div>
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-netSalaryDisplay" asp-for="Deductions[1].NetSalaryDisplay" readonly />
                    <input hidden class="js-deduction-netSalary" asp-for="Deductions[1].NetSalary" />
                </div>
                <div class="group-complex -layout-deduction-2">
                    <div class="like-group-title">@ViewLang.SalaryAdvance</div>
                    <input hidden asp-for="Deductions[2].Type" />
                    <input type="text" class="control js-description" asp-for="Deductions[2].Description">
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-unitAmount" asp-for="Deductions[2].UnitAmount">
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-netSalaryDisplay" asp-for="Deductions[2].NetSalaryDisplay" readonly>
                    <input hidden class="js-deduction-netSalary" asp-for="Deductions[2].NetSalary" />
                </div>
                <div class="group-complex -layout-deduction-2">
                    <div class="like-group-title">@ViewLang.Others</div>
                    <input hidden asp-for="Deductions[3].Type" />
                    <input type="text" class="control js-description" asp-for="Deductions[3].Description">
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-unitAmount" asp-for="Deductions[3].UnitAmount">
                    <input type="text" class="control number js-positiveNumberOnly js-deduction-netSalaryDisplay" asp-for="Deductions[3].NetSalaryDisplay" readonly>
                    <input hidden class="js-deduction-netSalary" asp-for="Deductions[3].NetSalary" />
                </div>
                <div class="group-complex -layout-deduction">
                    <div class="text-specific text-red">@ViewLang.TotalDeduction</div>
                    <input type="text" class="control number -start-col-5 highlighted bold js-positiveNumberOnly js-deduction-totalNetSalaryDisplay"
                           asp-for="MonthlySalary.DeductionAmountDisplay" readonly>
                    <input hidden class="js-deduction-totalNetSalary" asp-for="MonthlySalary.DeductionAmount" />
                </div>
            </div>
        </div>
        <div class="group-complex">
            <div class="group-title -no-space"><span class="icon-group"></span>@ViewLang.BasicSalary</div>
        </div>
        <div class="d-flex">
            <div class="setting">
                <div class="group-complex -layout-setting">
                    <div class="bold">@ViewLang.Setting</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.CurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.CurrencyId">@Model.MonthlyBasicSalary.CurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted js-numberOnly" asp-for="MonthlyBasicSalary.Salary" readonly>
                </div>
                <div class="group-complex -layout-setting">
                    <div class="like-group-title">@ViewLang.EBanking</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.EbankingCurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.EbankingCurrencyId">@Model.MonthlyBasicSalary.EbankingCurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted js-numberOnly" asp-for="MonthlyBasicSalary.EbankingAmount" readonly>
                </div>
                <div class="group-complex -layout-setting">
                    <div class="like-group-title">@ViewLang.DirectBanking1</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.DirectBanking1CurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.DirectBanking1CurrencyId">@Model.MonthlyBasicSalary.DirectBanking1CurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted js-numberOnly" asp-for="MonthlyBasicSalary.DirectBanking1Amount" readonly>
                </div>
                <div class="group-complex -layout-setting">
                    <div class="like-group-title">@ViewLang.DirectBanking2</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.DirectBanking2CurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.DirectBanking2CurrencyId">@Model.MonthlyBasicSalary.DirectBanking2CurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted js-numberOnly" asp-for="MonthlyBasicSalary.DirectBanking2Amount" readonly>
                </div>
                <div class="group-complex -layout-setting">
                    <div class="like-group-title">@ViewLang.Cash</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.CashCurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.CashCurrencyId">@Model.MonthlyBasicSalary.CashCurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted js-numberOnly" asp-for="MonthlyBasicSalary.CashAmount" readonly>
                </div>
                <div class="group-complex -layout-setting">
                    <div class="bold">@ViewLang.AfterAdjustment</div>
                    <select class="control js-select2-disabled" asp-for="MonthlyBasicSalary.CashCurrencyId" disabled>
                        <option value="@Model.MonthlyBasicSalary.CurrencyId">@Model.MonthlyBasicSalary.CurrencyCode</option>
                    </select>
                    <input type="text" class="control number highlighted bold js-numberOnly" asp-for="MonthlyBasicSalary.AfterAdjustmentAmount" disabled>
                </div>
                <div class="group-complex -layout-setting-2">
                    <div>@ViewLang.Reason</div>
                    <textarea class="control text-reason js-afterAdjustmentReason" asp-for="MonthlyBasicSalary.AfterAdjustmentReason" readonly></textarea>
                </div>
            </div>
            <div class="monthly-payroll">
                <div class="group-complex -layout-payroll">
                    <div class="bold">@ViewLang.MonthlyBasicSalary</div>
                    <select class="control js-select2-disabled" asp-for="MonthlySalary.CurrencyId" asp-items="Model.Currencies" disabled>
                        <option></option>
                    </select>
                    <input type="text" class="control number highlighted total-monthly-payroll js-numberOnly" asp-for="MonthlySalary.Salary" readonly>
                </div>
                <div class="group-complex -layout-payroll js-monthlySalary">
                    <label>
                        <input type="radio" asp-for="MonthlySalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.Ebanking" />
                        <span class="like-group-title">@ViewLang.EBanking</span>
                    </label>
                    <select class="control js-select2-validation js-select2-allowclear js-selectCurrency" data-group="ebanking"
                            asp-for="MonthlySalary.EbankingCurrencyId" asp-items="Model.Currencies">
                        <option></option>
                    </select>
                    <input type="text" class="control number js-numberOnly js-autoCalculateAmount" data-group="ebanking"
                           asp-for="MonthlySalary.EbankingAmount" />
                </div>
                <div class="group-complex -layout-payroll js-monthlySalary">
                    <label>
                        <input type="radio" asp-for="MonthlySalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking1" />
                        <span class="like-group-title">@ViewLang.DirectBanking1</span>
                    </label>
                    <select class="control js-select2-validation js-select2-allowclear js-selectCurrency" data-group="directbanking1"
                            asp-for="MonthlySalary.DirectBanking1CurrencyId" asp-items="Model.Currencies">
                        <option></option>
                    </select>
                    <input type="text" class="control number js-numberOnly js-autoCalculateAmount" data-group="directbanking1"
                           asp-for="MonthlySalary.DirectBanking1Amount" />
                </div>
                <div class="group-complex -layout-payroll js-monthlySalary">
                    <label>
                        <input type="radio" asp-for="MonthlySalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking2" />
                        <span class="like-group-title">@ViewLang.DirectBanking2</span>
                    </label>
                    <select class="control js-select2-validation js-select2-allowclear js-selectCurrency" data-group="directbanking2"
                            asp-for="MonthlySalary.DirectBanking2CurrencyId" asp-items="Model.Currencies">
                        <option></option>
                    </select>
                    <input type="text" class="control number js-numberOnly js-autoCalculateAmount" data-group="directbanking2"
                           asp-for="MonthlySalary.DirectBanking2Amount" />
                </div>
                <div class="group-complex -layout-payroll js-monthlySalary">
                    <label>
                        <input type="radio" asp-for="MonthlySalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.Cash" />
                        <span class="like-group-title">@ViewLang.Cash</span>
                    </label>
                    <select class="control js-select2-validation js-select2-allowclear js-selectCurrency" data-group="cash"
                            asp-for="MonthlySalary.CashCurrencyId" asp-items="Model.Currencies">
                        <option></option>
                    </select>
                    <input type="text" class="control number js-numberOnly js-autoCalculateAmount" data-group="cash"
                           asp-for="MonthlySalary.CashAmount" />
                </div>
            </div>
            <div class="payment">
                <div class="bold group-payment">@ViewLang.PaymentTransaction</div>
                <div class="group-complex -layout-payment -group-type">
                    <div>@ViewLang.BankType</div>
                    <div>@ViewLang.AccountName</div>
                </div>
                <div class="group-complex -layout-payment">
                    <div class="like-group-title">@ViewLang.EBanking</div>
                    <select class="hidden js-bankType">
                        <option value="@((int) BankTypes.Ebanking)" selected="selected"></option>
                    </select>
                    <select class="control js-select2-validation js-select2-bankAcount" data-group="ebanking"
                            asp-for="MonthlySalary.EbankingAccountId">
                        <option value="@Model.MonthlySalary.EbankingAccountId">@Model.MonthlySalary.EbankingAccountName</option>
                    </select>
                </div>
                <div class="group-complex -layout-payment">
                    <select class="control js-select2-validation js-select2-bankType js-bankType" data-group="directbanking1"
                            asp-for="MonthlySalary.DirectBanking1BankTypeId" asp-items="bankTypes">
                        <option></option>
                    </select>
                    <select class="control js-select2-validation js-select2-bankAcount" data-group="directbanking1"
                            asp-for="MonthlySalary.DirectBanking1AccountId">
                        <option value="@Model.MonthlySalary.DirectBanking1AccountId">@Model.MonthlySalary.DirectBanking1AccountName</option>
                    </select>
                </div>
                <div class="group-complex -layout-payment">
                    <select class="control js-select2-validation js-select2-bankType js-bankType" data-group="directbanking2"
                            asp-for="MonthlySalary.DirectBanking2BankTypeId" asp-items="bankTypes">
                        <option></option>
                    </select>
                    <select class="control js-select2-validation js-select2-bankAcount" data-group="directbanking2"
                            asp-for="MonthlySalary.DirectBanking2AccountId">
                        <option value="@Model.MonthlySalary.DirectBanking2AccountId">@Model.MonthlySalary.DirectBanking2AccountName</option>
                    </select>
                </div>
                <div class="group-complex -layout-payment">
                    <div class="like-group-title">@ViewLang.Cash</div>
                    <select class="control js-select2-validation js-select2-allowclear" data-group="cash"
                            asp-for="MonthlySalary.CashAccountId" asp-items="Model.CashAccounts">
                        <option></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="group-complex -total-salary">
            <div class="text-specific">TOTAL NET</div>
            <input type="text" class="control number total-salary js-numberOnly js-totalNetSalary" value="@Model.MonthlySalary.Salary" disabled>
        </div>
        <div class="list-button">
            <a class="button -second js-btnCancel"
               asp-controller="PaymentProcess" asp-action="EmployeeMonthlyPayroll"
               asp-route-companyId="@Model.FilterInfo.CompanyId" asp-route-month="@Model.Month"
               asp-route-employeeId="@Model.CachingFilter.EmployeeId"
               asp-route-employee="@Model.CachingFilter.Employee"
               asp-route-idNo="@Model.CachingFilter.IDNo"
               asp-route-workingDays="@Model.CachingFilter.WorkingDays"
               asp-route-costCenterIds="@Model.CachingFilter.CostCenterIds">@ViewLang.Cancel</a>
            @if (Model.FilterInfo.IsHost)
            {
                <button class="button -primary js-btnSubmit" type="button">@ViewLang.Save</button>
                <button class="button -primary js-btnSubmitAndEditAllowances" type="button">@ViewLang.SaveAndEditMonthlyAllowances</button>
            }
        </div>
    </div>
</form>
<div class="js-currencyExchangeRates">
    @foreach (var currency in Model.CurrencyExchangeRates)
    {
        <input type="hidden" data-from-currency="@currency.FromCurrencyId" data-to-currency="@currency.ToCurrencyId" value="@currency.ExchangeRate" />
    }
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title">@ViewLang.Confirmation</h4>
            </div>
            <div class="modal-body">
                <form class="form-information" asp-action="Preset" method="post" id="preset-form"
                      data-ajax-method="post" data-ajax="true"
                      data-ajax-failure="commonFunctions.handleAjaxError"
                      data-ajax-success="editBasicSalary.onPresetSuccess">
                    <input type="hidden" name="employeeId" value="@Model.FilterInfo.EmployeeId" />
                    <input type="hidden" name="month" value="@Model.Month" />
                    <input type="hidden" name="companyId" value="@Model.FilterInfo.CompanyId" />
                    <p>@Html.Raw(Message.PayrollPresetConfirmationMessage)</p>
                    <div class="list-button">
                        <button class="button -primary" type="submit" id="btn-yes">@ViewLang.Yes</button>
                        <button type="button" class="button -second" data-dismiss="modal">@ViewLang.No</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/bignumber.js/bignumber.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.numeric.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/jquery.inputmask.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/tooltipster/dist/js/tooltipster.bundle.js"></script>
        <script src="~/assets/js/paymentprocess/edit-basic-salary.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/bignumber.js/bignumber.min.js"></script>
        <script src="~/assets/bundles/paymentprocess/js/edit-basic-salary.min.js"></script>
    </environment>
}