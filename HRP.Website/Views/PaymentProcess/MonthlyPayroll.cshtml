@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.MonthlyPayroll
@model EmployeeMonthlyPayrollViewModel

@{
    ViewData["Title"] = ViewLang.ViewEmployeeMonthlyPayroll;
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/jquery-ui/jquery-ui.css" rel="stylesheet" />
        <link href="~/lib/jQuery-contextMenu/jquery.contextMenu.css" rel="stylesheet" />
        <link href="~/lib/datatables.net/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/datatables.net-fixedcolumns-bs/css/fixedColumns.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" />
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/payment-process.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/monthly-payroll.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/paymentprocess/css/employee-monthly-payroll.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.PaymentProcess</li>
    <li class="active">@ViewLang.ViewEmployeeMonthlyPayroll</li>
</ol>

@Html.Partial("_Steps", (int)PaymentProcessStep.MonthlyPayroll)

<div class="list-message-error hidden">
    <p class="message">@Message.SelectAtLeastOneOption</p>
</div>
<div class="-has-border msg-error hidden"></div>
<div class="search-form">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" value="@Html.DisplayFor(x => x.Month)" readonly />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control js-select2" disabled>
            <option value="@Model.CompanyId" selected="selected">@Model.FilterInfo.CompanyCode</option>
        </select>
    </div>

    <div class="group">
        <label class="text">@ViewLang.IDNo</label>
        <input type="text" class="control id-no" placeholder="" id="SearchIDNo" value="@Model.IDNo" maxlength="20" />
    </div>
    <div class="group">
        <label class="text">@ViewLang.Employee</label>
        <input type="text" class="control" placeholder="Full name or Nickname" id="SearchEmployee" value="@Model.Employee" maxlength="70" />
    </div>
    <div class="group">
        <label class="text">Div/Dept/Cost Center</label>
        <select class="control width-200" id="CostCenterMultiSelect"></select>
    </div>
    <form class="search-form" asp-action="EmployeeMonthlyPayroll" method="get">
        <input asp-for="CompanyId" hidden />
        <input type="text" asp-for="Month" hidden />
        <input asp-for="CostCenterIds" hidden />
        <input asp-for="EmployeeId" hidden>
        <input asp-for="Employee" hidden>
        <input asp-for="IDNo" hidden>
        <div class="group">
            <label class="text">@ViewLang.WorkingDays</label>
            <select class="control js-select2 width-92" asp-for="WorkingDays">
                <option value="">@ViewLang.All</option>
                <option value="22">22</option>
                <option value="26">26</option>
            </select>
        </div>
        <div class="group">
            <button type="submit" class="button -primary">@ViewLang.Submit</button>
        </div>
    </form>
</div>
<div class="payment-duration">
    <div class="date"><span class="required">*</span> @ViewLang.ThePaymentProcessDuration</div>
    <div class="date">@ViewLang.StartDate: <strong>@Html.DisplayFor(x => x.FilterInfo.StartDate)</strong></div>
    <div class="date">@ViewLang.DueDate: <strong>@Html.DisplayFor(x => x.FilterInfo.DueDate)</strong></div>
</div>
<div class="payment-duration">
    <div><span class="required">*</span> @Model.FilterInfo.TotalEmployees employees have been successfullly generated the Monthly Payroll.</div>
</div>

<div class="top-header @(Model.FilterInfo.IsHost ? string.Empty : "-only-search-box")">
    @if (Model.FilterInfo.IsHost)
    {
        <div class="pull-left">
            <button type="button" class="button -preset" data-toggle="modal" data-target="#modalPresetAllPayroll">@ViewLang.PresetAll</button>
        </div>
    }
    <div class="pull-right search-box">
        <input type="search" id="quick-search" class="control" placeholder="@ViewLang.Search" />
        <span class="icon-search"></span>
    </div>
</div>
<table id="monthly-payroll-table" class="table table-bordered table-hover table-striped dataTable" style="width:100%">
    <thead>
        <tr>
            <th rowspan="3">@ViewLang.Check</th>
            <th rowspan="3">@ViewLang.IDNo</th>
            <th rowspan="3">@ViewLang.FullName</th>
            <th rowspan="3">@ViewLang.Nickname</th>
            <th rowspan="3">@ViewLang.CostCenter</th>
            <th colspan="8">@ViewLang.BasicSalary</th>
            <th colspan="6">@ViewLang.Allowances</th>
            <th rowspan="3">@ViewLang.WorkingDays</th>
            <th rowspan="3">@ViewLang.Action</th>
        </tr>
        <tr>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.EBanking</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.DirectBanking1</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.DirectBanking2</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.Cash</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.DirectBanking1</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.DirectBanking2</th>
            <th colspan="2" class="sub-header no-border-top">@ViewLang.Cash</th>
        </tr>
        <tr>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
            <th class="no-border-top">@ViewLang.Currency</th>
            <th class="no-border-top">@ViewLang.Amount</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Employees != null && Model.Employees.Any())
        {
            foreach (MonthlyPayrollEmployeeInfoViewModel employee in Model.Employees)
            {
                decimal amount;
                <tr class="@(employee.IsGenerated ? string.Empty : "row-highlight")">
                    <td class="text-center has-icon">
                        @if (employee.IsGenerated)
                        {
                            switch (employee.Status)
                            {
                                case MonthlyPayrollStatus.Default:
                                    <span class="status-default"></span>
                                    break;

                                case MonthlyPayrollStatus.Satisfied:
                                    <span class="status-done"></span>
                                    break;

                                case MonthlyPayrollStatus.Unsatisfied:
                                    <span class="status-incorrect"></span>
                                    break;
                            }
                        }
                    </td>
                    <td>@employee.IDNo</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Nickname</td>
                    <td>@employee.CostCenter</td>
                    <td>@employee.BasicSalary.EbankingCurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.BasicSalary.EbankingAmount))
                    {
                        decimal.TryParse(employee.BasicSalary.EbankingAmount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.BasicSalary.DirectBanking1CurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.BasicSalary.DirectBanking1Amount))
                    {
                        decimal.TryParse(employee.BasicSalary.DirectBanking1Amount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.BasicSalary.DirectBanking2CurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.BasicSalary.DirectBanking2Amount))
                    {
                        decimal.TryParse(employee.BasicSalary.DirectBanking2Amount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.BasicSalary.CashCurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.BasicSalary.CashAmount))
                    {
                        decimal.TryParse(employee.BasicSalary.CashAmount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.Allowance.DirectBanking1CurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.Allowance.DirectBanking1Amount))
                    {
                        decimal.TryParse(employee.Allowance.DirectBanking1Amount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.Allowance.DirectBanking2CurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.Allowance.DirectBanking2Amount))
                    {
                        decimal.TryParse(employee.Allowance.DirectBanking2Amount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@employee.Allowance.CashCurrencyCode</td>
                    @if (!string.IsNullOrWhiteSpace(employee.Allowance.CashAmount))
                    {
                        decimal.TryParse(employee.Allowance.CashAmount, out amount);

                        <td class="text-right @(amount < 0 ? "negative-amount" : string.Empty)">
                            @string.Format("{0:n}", amount)
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td class="text-center">@employee.WorkingDays</td>
                    <td class="text-center has-icon">
                        @if (employee.Policy != Policy.None)
                        {
                            <div class="js-contextMenu">
                                <span class="icon-configuration"></span>
                                <span class="caret"></span>
                            </div>
                            <div class="js-contextMenuItems hidden">
                                <a class="js-menuItem-basicSalary" asp-action="EditBasicSalary" asp-controller="PaymentProcess"
                                   asp-route-payrollId="@employee.PayrollId" asp-route-companyId="@Model.CompanyId"
                                   asp-route-month="@Model.Month" asp-route-employeeId="@Model.EmployeeId"
                                   asp-route-employee="@Model.Employee" asp-route-idNo="@Model.IDNo"
                                   asp-route-workingDays="@Model.WorkingDays" asp-route-costCenterIds="@Model.CostCenterIds"
                                   data-hasSetting="@employee.HasSettingSalary">
                                    <span class="icon-salary"></span>
                                    @if (employee.Policy == Policy.Host)
                                    {
                                        @ViewLang.EditMonthlyBasicSalary
                                    }
                                    else
                                    {
                                        @ViewLang.ViewMonthlyBasicSalary
                                    }
                                </a>

                                <a class="js-menuItem-allowance" asp-action="EditAllowances" asp-controller="PaymentProcess"
                                   asp-route-payrollId="@employee.PayrollId" asp-route-month="@Model.Month"
                                   asp-route-companyId="@Model.CompanyId" asp-route-employeeId="@Model.EmployeeId"
                                   asp-route-employee="@Model.Employee" asp-route-idNo="@Model.IDNo"
                                   asp-route-workingDays="@Model.WorkingDays" asp-route-costCenterIds="@Model.CostCenterIds"
                                   data-hasSetting="@employee.HasSettingAllowance">
                                    <span class="icon-allowances"></span>
                                    @if (employee.Policy == Policy.Host)
                                    {
                                        @ViewLang.EditMonthlyAllowances
                                    }
                                    else
                                    {
                                        @ViewLang.ViewMonthlyAllowances
                                    }
                                </a>

                                @if (employee.Policy == Policy.Host)
                                {
                                    <a class="js-menuItem-presetMonthlyPayroll" href="javascript:;" data-employeeId="@employee.EmployeeId">
                                        <span class="icon-preset"></span> @ViewLang.Preset
                                    </a>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div class="list-button">
    <a class="button -second" asp-controller="PaymentProcess" asp-action="UploadAttendanceAndSalary"
       asp-route-companyId="@Model.CompanyId" asp-route-month="@Model.Month">@ViewLang.Back</a>
</div>

@if (Model.FilterInfo.IsHost)
{
    <div class="modal fade" tabindex="-1" role="dialog" id="modalPresetPayroll">
        <div class="modal-dialog" role="document">
            <div class="modal-content -has-title">
                <div class="modal-header">
                    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                    <h4 class="modal-title">@ViewLang.Confirmation</h4>
                </div>
                <div class="modal-body">
                    <form class="form-information" asp-controller="paymentprocess" asp-action="Preset" method="post" id="preset-form"
                          data-ajax-method="post" data-ajax="true"
                          data-ajax-failure="commonFunctions.handleAjaxError" data-ajax-success="monthlyPayroll.onPresetSuccess">
                        <input type="hidden" name="employeeId" value="" />
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="companyId" value="@Model.CompanyId" />
                        <p>@Html.Raw(Message.PayrollPresetConfirmationMessage)</p>
                        <div class="list-button">
                            <button class="button -primary" type="submit">@ViewLang.Yes</button>
                            <button type="button" class="button -second" data-dismiss="modal">@ViewLang.No</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" role="dialog" id="modalPresetAllPayroll">
        <div class="modal-dialog" role="document">
            <div class="modal-content -has-title">
                <div class="modal-header">
                    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                    <h4 class="modal-title">@ViewLang.Confirmation</h4>
                </div>
                <div class="modal-body">
                    <form class="form-information" asp-controller="paymentprocess" asp-action="PresetAllMonthlyPayroll" method="post" id="preset-form"
                          data-ajax-method="post" data-ajax="true"
                          data-ajax-failure="commonFunctions.handleAjaxError" data-ajax-success="monthlyPayroll.onPresetAllSuccess">
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="companyId" value="@Model.CompanyId" />
                        <p>@Html.Raw(Message.PayrollPresetConfirmationMessage)</p>
                        <div class="list-button">
                            <button class="button -primary" type="submit">@ViewLang.Yes</button>
                            <button type="button" class="button -second" data-dismiss="modal">@ViewLang.No</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" tabindex="-1" role="dialog" id="modalHasNoPayrollSetting">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <p class="no-basic-salary-setting">@Message.EmployeeHasNoBasicSalarySetting</p>
                <p class="no-allowance-setting">@Message.EmployeeHasNoAllowanceSetting</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-ui/jquery-ui.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/datatables.net-fixedcolumns/js/dataTables.fixedColumns.js"></script>
        <script src="~/lib/jQuery-contextMenu/jquery.contextMenu.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/assets/js/paymentprocess/employee-monthly-payroll.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/paymentprocess/js/employee-monthly-payroll.min.js"></script>
    </environment>
}