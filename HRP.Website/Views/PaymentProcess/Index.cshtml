@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.PaymentProcess
@model SelectWorkingMonthCompanyViewModel
@{
    ViewData["Title"] = ViewLang.SelectWorkingMonthCompany;
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/payment-process/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>

    <environment exclude="Development">
        <link href="~/css/pro/pages/payment-process/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/payment-process/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/payment-process/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">@ViewLang.PaymentProcess</li>
    <li class="active">@ViewLang.SelectWorkingMonthCompany</li>
</ol>

@await Html.PartialAsync("_Steps", (short)PaymentProcessStep.SelectMonthAndCompany)

<form class="search-form" asp-action="Index" method="post">
    <div class="list-message-error @(ViewData.ModelState.IsValid ? "hidden": "")">
        <span asp-validation-for="CompanyId" class="message"></span>
        <span asp-validation-for="SelectedTime" class="message"></span>
        <span asp-validation-for="CommonError" class="message"></span>
    </div>

    <input type="hidden" asp-for="StartDate" />
    <input type="hidden" asp-for="DueDate" />
    <input type="hidden" asp-for="CommonError" />

    <div class="w-100"></div>
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" asp-for="SelectedTime" data-maxdate="@Model.StartDate" />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control select2" asp-for="CompanyId" asp-items="@Model.Companies"></select>
    </div>
    <div class="w-100"></div>
    <div class="payment-duration">
        <div class="date"><span class="required">*</span> @ViewLang.ThePaymentProcessDuration</div>
        <div class="date">@ViewLang.StartDate: <strong>@Html.DisplayFor(x => x.StartDate)</strong></div>
        <div class="date">@ViewLang.DueDate: <strong>@Html.DisplayFor(x => x.DueDate)</strong></div>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Next</button>
    </div>
</form>