@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.PaymentProcess
@model UploadAttendanceAndSalaryViewModel
@{
    var isEmptyAttendanceFilename = string.IsNullOrWhiteSpace(Model.AttendanceFileName);
    var isEmptyDSTNetSalaryFilename = string.IsNullOrWhiteSpace(Model.DSTNetSalaryFileName);
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/payment-process.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/paymentprocess/upload-files.css" rel="stylesheet" />
    </environment>

    <environment exclude="Development">
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.PaymentProcess</li>
    <li class="active">@ViewLang.UploadFiles</li>
</ol>

@Html.Partial("_Steps", (int)PaymentProcessStep.UploadFiles)

<div class="search-form">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" disabled value="@Model.SelectedTime.ToString("MM-yyyy")" />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control" disabled>
            <option value="@Model.CompanyId">@Model.CompanyCode</option>
        </select>
    </div>
    <div class="w-100"></div>
    <div class="payment-duration">
        <div class="date"><span class="required">*</span> The Payment Process Duration</div>
        <div class="date">Start Date: <strong> 02/01/2018</strong></div>
        <div class="date">Due Date: <strong>03/01/2018</strong></div>
    </div>
</div>

<form class="form-information upload-files" id="uploadFilesForm" enctype="multipart/form-data" asp-action="UploadAttendanceAndSalary">
    <div class="list-message-error hidden">
        <span asp-validation-for="CompanyId" class="message"></span>
        <span asp-validation-for="SelectedTime" class="message"></span>
        <span asp-validation-for="AttendanceFile" class="message"></span>
        <span asp-validation-for="DSTNetSalaryFile" class="message"></span>
        <span asp-validation-for="CommonError" class="message"></span>
    </div>

    <input type="hidden" asp-for="CommonError" />
    <input type="hidden" asp-for="CompanyId" />
    <input type="hidden" asp-for="SelectedTime" />
    <input type="file" asp-for="AttendanceFile" class="hidden" />
    <input type="file" asp-for="DSTNetSalaryFile" class="hidden" />
    <input type="hidden" id="isHasAttendanceFileSelected" value="0" />
    <input type="hidden" id="isHasDSTNetSalaryFileSelected" value="0" />
    <input type="hidden" id="isShowBrowseFileWarning" value=@((isEmptyAttendanceFilename && isEmptyDSTNetSalaryFilename) ? "0" : "1") />

    <div class="text width-660">
        @ViewLang.UploadAttendanceFile
        <div class="download-template">
            <span class="icon-excel"></span>
            <a asp-controller="PaymentProcess" asp-action="DownloadAttendance">@ViewLang.DownloadTemplate</a>
        </div>
    </div>
    <div class="group-control width-660">
        <div class="inputfile-box">
            <label for="file" class="file">
                <span id="file-name" class="file-box">
                    <span class="file-name js-attendanceFileName" data-filename-uploaded="@Model.AttendanceFileName">@Model.AttendanceFileName</span>
                    <span class="icon-successful js-attendanceIconSuccess @(isEmptyAttendanceFilename ? "hidden" :"")"></span>
                    <span class="icon-close js-attendanceIconClose hidden"></span>
                </span>
                <span class="button -browser js-browseAttendance">@ViewLang.Browse</span>
            </label>
        </div>
        <button type="button" class="button -delete js-deleteAttendance" @(isEmptyAttendanceFilename ? "disabled" : "")>@ViewLang.Delete</button>
    </div>
    <div class="text width-660">
        @ViewLang.UploadDSTNetSalaryFile
        <div class="download-template">
            <span class="icon-excel"></span>
            <a asp-controller="PaymentProcess" asp-action="DownloadDSTNetSalary">@ViewLang.DownloadTemplate</a>
        </div>
    </div>
    <div class="group-control width-660">
        <div class="inputfile-box">
            <label for="file" class="file">
                <span class="file-box">
                    <span class="file-name js-dstNetSalaryFileName" data-filename-uploaded="@Model.DSTNetSalaryFileName">@Model.DSTNetSalaryFileName</span>
                    <span class="icon-successful js-dstNetSalaryIconSuccess @(isEmptyDSTNetSalaryFilename ? "hidden" :"")"></span>
                    <span class="icon-close js-dstNetSalaryIconClose hidden"></span>
                </span>
                <span class="button -browser js-browseDSTNetSalary">@ViewLang.Browse</span>
            </label>
        </div>
        <button type="button" class="button -delete js-deleteDSTNetSalary" @(isEmptyDSTNetSalaryFilename ? "disabled" : "")>@ViewLang.Delete</button>
    </div>

    <div class="info-list" id="validationFilesResult">
        @Html.Partial("_ValidationFilesResult", Model)
    </div>

    <div class="group-control list-button">
        <a class="button -second" asp-controller="PaymentProcess" asp-action="Index">@ViewLang.Back</a>
        <button type="submit" class="button -add" id="uploadFiles" disabled>@ViewLang.Upload</button>
        <button type="button" class="button -primary" id="nextToMonthlyPayroll">@ViewLang.Next</button>
    </div>
</form>

@*<div class="block-ui">
        <div class="loader02"></div>
    </div>*@

<div class="modal fade in" id="generatePayrollWarning" tabindex="-1" role="dialog">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>@Message.WarningGeneratePayroll</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Discard</button>
                <a class="button -primary js-confirmGeneratePayroll">@ViewLang.Yes</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade in" id="fileNotUploadedWarning" tabindex="-1" role="dialog">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>@Message.WarningFileNotUploaded</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Discard</button>
                <a class="button -primary js-nextAnyway">@ViewLang.NextAnyway</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade in" id="browseFileWarning" tabindex="-1" role="dialog">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <input type="hidden" id="continueToAction" value="0" />
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>@Message.WarningBrowseFile</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Cancel</button>
                <a class="button -primary js-confirmBrowseFile">@ViewLang.OK</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/assets/js/paymentprocess/upload-attendance-salary.js"></script>
    </environment>
    <environment exclude="Development">
    </environment>
}