@using HRP.Resources
@using HRP.Models.SystemSecurity
@model InputPasswordViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = ViewLang.Password;
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/certificate.css" rel="stylesheet" />
}

<section class="block certificate">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    @if (Model.IsHost)
    {
        <h1 class="title">Password Used To Access The Certificate</h1>
        <div class="intro">
            <p class="bold">Dear User,</p>
            <p>
                System cannot find the password on the server's memory.
                Please enter the password used to access the certificate.
            </p>
        </div>

        <form asp-controller="SystemSecurity" asp-action="Password" method="POST">
            <input hidden asp-for="IsHost" />

            <div class="group">
                <span asp-validation-for="Password" class="msg-error"></span>
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input type="password" asp-for="Password" class="form-control" placeholder="Password" />
            </div>

            <div class="group">
                <input type="submit" value="@ViewLang.Save" class="button -primary" />
            </div>
        </form>
    }
    else
    {
        <h1 class="title">System cannot find the password on the server's memory. Please contact your system administrator!</h1>
    }
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
}