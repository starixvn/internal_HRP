@using HRP.Resources
@using HRP.Models.SystemSecurity
@model InputPasswordViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = ViewLang.Password;
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/system-security/certificate.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/system-security/certificate.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/system-security/input-password.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/system-security/input-password.chunk.js" asp-append-version="true"></script>
    </environment>
}
<section class="block certificate">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    @if (Model.IsHost)
    {
        <h1 class="title">Password Used To Access The Certificate</h1>
        <div class="intro">
            <p class="bold">Dear User,</p>
            <p class="intro-detail">
                System cannot find the password on the server's memory.
                Please enter the password used to access the certificate.
            </p>
        </div>

        <form asp-controller="SystemSecurity" asp-action="Password" method="POST" autocomplete="off">
            <input hidden asp-for="IsHost" />
            <input hidden data-val="false" asp-for="RijndaelKey.Key" />
            <input hidden data-val="false" asp-for="RijndaelIV.Key" />

            <div class="group">
                <span asp-validation-for="Password" class="msg-error"></span>
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input type="password" asp-for="Password" class="form-control" placeholder="Password" />
            </div>
            <div class="group">
                <label>
                    <input id="ShowPassword" type="checkbox" class="form-control" />
                    <span>@ViewLang.ShowPassword</span>
                </label>
            </div>

            <div class="group">
                <input type="submit" value="@ViewLang.Save" class="button -primary" />
            </div>
        </form>
        <input hidden value="@Model.RijndaelKey.Value" id="RijndaelKey" />
        <input hidden value="@Model.RijndaelIV.Value" id="RijndaelIV" />
    }
    else
    {
        <h1 class="title">Authorization Required</h1>
        <div class="intro">
            <p class="bold">Dear User,</p>
            <p>
                You cannot access to system because it hasn't launched by the super admin.
                Please contact the super admin if there is any concerns. Thanks.
            </p>
        </div>
        <div class="footer">
            <a class="link action-back" asp-controller="auth" asp-action="logout">@ViewLang.BackToLogin</a>
        </div>
    }
</section>