@using HRP.Models.Certificate
@model GenerateCertificateViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Password";
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/certificate.css" rel="stylesheet" />
}

<section class="block">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    @if (Model.IsSystemAdmin)
    {
        <h1 class="title">Password Used To Access The Certificate</h1>

        <form asp-controller="SystemSecurity" asp-action="Password" method="POST">
            <input hidden asp-for="IsSystemAdmin" />

            <div class="group">
                <span asp-validation-for="Password" class="msg-error"></span>
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input type="text" asp-for="Password" class="form-control" placeholder="Password" />
            </div>

            <div class="group">
                <input type="submit" value="Save" class="button -primary" />
            </div>
        </form>
    }
    else
    {
        <h1 class="title">Please contact your system administrator!</h1>
    }
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
}