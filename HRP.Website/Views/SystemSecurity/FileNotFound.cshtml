@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "File Not Found";
    var isHost = ViewData["IsHost"] != null && bool.Parse(ViewData["IsHost"].ToString());
}

<section class="block certificate">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    <h1 class="title">The certificate file not found.</h1>
    <div class="footer">
        <a class="link action-back" asp-controller="auth" asp-action="logout">Back to Login</a>
    </div>
</section>