@using HRP.Resources
@using HRP.Models.Certificate
@model ChangeCertificatePasswordViewModel

@{ 
    ViewData["Title"] = "Change Password";
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/changepassword.css" rel="stylesheet" />
}

@if (Model.IsSystemAdmin)
{
    <h1 class="title">Change Password Used To Access The Certificate</h1>

    <form class="form-information block" asp-controller="SystemSecurity" asp-action="ChangePassword" method="POST">
        <input hidden asp-for="IsSystemAdmin" />

        <div class="list-message-error hidden" id="validation-summary">
            <span asp-validation-for="OldPassword" class="message"></span>
            <span asp-validation-for="Password" class="message"></span>
        </div>

        <label asp-for="OldPassword" class="text -has-required">@ViewLang.OldPassword</label>
        <div class="group-control">
            <input type="password" class="control" asp-for="OldPassword" />
        </div>

        <label asp-for="Password" class="text -has-required">@ViewLang.Password</label>
        <div class="group-control">
            <input type="password" class="control" asp-for="Password" />
        </div>

        <div class="group-control">
            <label>
                <input type="checkbox" id="ShowPassword" />
                <span>@ViewLang.ShowPassword</span>
            </label>
        </div>

        <div class="group">
            <input type="submit" value="@ViewLang.Save" class="button -primary" />
        </div>
    </form>
}

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
    <script src="~/assets/js/systemsecurity/change-password.js"></script>
}