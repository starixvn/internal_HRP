@using HRP.Resources
@using HRP.Models.SystemSecurity
@model GenerateCertificateViewModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Generate";
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/certificate.css" rel="stylesheet" />
}

<section class="block">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    @if (Model.IsHost)
    {
        if (Model.IsSuccessful)
        {
            <h1 class="title">Download The Certificate</h1>
            <p>
                You can choose to download the certificate physical file from here.
                Keep the certificate physical file will help you to recovery the data in bad situations.
            </p>
            <div class="list-button">
                <a class="button -back" asp-controller="home" asp-action="index">Back to Home</a>
                <a class="button -primary" asp-controller="SystemSecurity" asp-action="download">@ViewLang.Download</a>
            </div>
        }
        else
        {
            <h1 class="title">Password Used To Access The Certificate</h1>
            <div class="intro">
                <p class="bold">Dear User,</p>
                <p>
                    You're here because this is the first time the system is launched.
                    Please set the password used to access the certificate.
                    Password must be at least 8 and maximum 50 characters,
                    including UPPER/lowercase and numbers, and must be remember carefully and safely by yourself.
                </p>
            </div>
            <form asp-controller="SystemSecurity" asp-action="Generate" method="POST">
                <input hidden asp-for="IsHost" />

                <span asp-validation-for="Password" class="msg-error"></span>
                <div class="group">
                    <span class="icon-password"></span>
                    <input type="text" asp-for="Password" class="form-control" placeholder="Password" />
                </div>

                <div class="group">
                    <input type="submit" value="Generate" class="button -primary" />
                </div>
            </form>
        }
    }
    else
    {
        <h1 class="title">The certificate file not found. Please contact your system administrator!</h1>
    }
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
}