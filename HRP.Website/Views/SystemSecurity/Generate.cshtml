@using HRP.Models.Certificate
@model GenerateCertificateViewModel

@{
    Layout = "_LoginLayout";
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/certificate.css" rel="stylesheet" />
}

<section class="block">
    <div class="circle-large">
        <span class="icon-otp"></span>
    </div>
    @if (Model.IsSystemAdmin)
    {
        <h1 class="title">Generate Certificate</h1>

        if (Model.IsIsSuccessful)
        {
            <div class="msg-success -has-icon">
                Generate successful. Please download....
            </div>
            <a class="button -primary" asp-controller="SystemSecurity" asp-action="download">Download</a>
            <a class="button -primary" asp-controller="home" asp-action="index">Back to Home</a>
        }
        else
        {
            <form asp-controller="SystemSecurity" asp-action="Generate" method="POST">
                <input hidden asp-for="IsSystemAdmin" />

                <span asp-validation-for="Password" class="msg-error"></span>
                <div class="group">
                    <span class="icon-password"></span>
                    <input type="text" asp-for="Password" class="form-control" placeholder="Password" />
                </div>

                <div class="group">
                    <input type="submit" value="Generate" class="button -primary" />
                </div>
            </form>
        }
    }
    else
    {
        <h1 class="title">File not found. Please contact your system administrator!</h1>
    }
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
}