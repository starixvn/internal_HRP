@using HRP.Core.Constants
@using HRP.Resources
@using HRP.Models.SystemSecurity
@model ChangeCertificatePasswordViewModel

@{
    ViewData["Title"] = ViewLang.SecuritySetting;
}

@section Styles {
    <link href="~/assets/styles/pages/systemsecurity/changepassword.css" rel="stylesheet" />
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Configuration</li>
    <li class="active">@ViewLang.SecuritySetting</li>
</ol>

@if (Model.IsHost)
{
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="active" role="presentation">
            <a href="#DownloadTab" role="tab" data-toggle="tab">@ViewLang.DownloadCertificate</a>
        </li>
        <li role="presentation">
            <a href="#ChangePasswordTab" role="tab" data-toggle="tab">@ViewLang.ChangeTheProtectionPassword</a>
        </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="DownloadTab">
            <div class="download-file">
                <p class="text-special">* File Name: @Constants.CertificateFileName</p>
                <a class="button -primary" asp-controller="SystemSecurity" asp-action="download">@ViewLang.Download</a>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane" id="ChangePasswordTab">
            @Html.Partial("_ChangePassword", Model)
        </div>
    </div>
}

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/assets/js/systemsecurity/change-password.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/systemsecurity/js/change-password.min.js"></script>
    </environment>
}