@using HRP.Core.Constants
@using HRP.Resources
@using HRP.Models.SystemSecurity
@model ChangeCertificatePasswordViewModel
@{
    ViewData["Title"] = ViewLang.SecuritySetting;
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/system-security/changepassword.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/system-security/changepassword.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/system-security/change-password.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/system-security/change-password.chunk.js" asp-append-version="true"></script>
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Configuration</li>
    <li class="active">@ViewLang.SecuritySetting</li>
</ol>

@if (Model.IsHost)
{
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="active" role="presentation">
            <a href="#DownloadTab" role="tab" data-toggle="tab">@ViewLang.DownloadCertificate</a>
        </li>
        <li role="presentation">
            <a href="#ChangePasswordTab" role="tab" data-toggle="tab">@ViewLang.ChangeTheProtectionPassword</a>
        </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="DownloadTab">
            <div class="download-file">
                <p class="text-special">* File Name: @Constants.CertificateFileName</p>
                <a class="button -primary" asp-controller="SystemSecurity" asp-action="download">@ViewLang.Download</a>
            </div>
        </div>
        <div role="tabpanel" class="tab-pane" id="ChangePasswordTab">
            @await Html.PartialAsync("_ChangePassword", Model)
        </div>
    </div>
}