@using HRP.Resources
@using HRP.Models.SystemSecurity
@model ChangeCertificatePasswordViewModel

@if (Model.IsHost)
{
    <form id="changePasswordForm" asp-controller="SystemSecurity" asp-action="ChangePassword"
          data-ajax-method="post" data-ajax="true" data-ajax-success="changePassword.onChangeSuccess"
          data-ajax-failure="commonFunctions.handleAjaxError" autocomplete="off">
        <input hidden asp-for="IsHost" />

        <div class="form-information block change-password">

            <div class="list-message-error hidden" id="validation-summary">
                <span asp-validation-for="OldPassword" class="message"></span>
                <span asp-validation-for="Password" class="message"></span>
                <span asp-validation-for="ConfirmPassword" class="message"></span>
            </div>

            <div class="-has-icon msg-success hidden">
                @Message.ChangeTheProtectionPasswordSuccessfully
            </div>
            <div class="-has-border msg-error hidden"></div>

            <label asp-for="OldPassword" class="text -has-required">@ViewLang.OldPassword</label>
            <div class="group-control">
                <input type="password" class="control" asp-for="OldPassword" autocomplete="off" />
            </div>

            <label asp-for="Password" class="text -has-required">@ViewLang.NewPassword</label>
            <div class="group-control">
                <input type="password" class="control" asp-for="Password" autocomplete="off" />
            </div>

            <label asp-for="ConfirmPassword" class="text -has-required">@ViewLang.ConfirmPassword</label>
            <div class="group-control">
                <input type="password" class="control" asp-for="ConfirmPassword" autocomplete="off" />
            </div>

            <div class="group-control">
                <label>
                    <input type="checkbox" id="ShowPassword" />
                    <span>@ViewLang.ShowPassword</span>
                </label>
            </div>

            <div class="list-button">
                <button class="button -second js-cancel" type="button">@ViewLang.Cancel</button>
                <input type="submit" value="@ViewLang.Save" class="button -primary" />
            </div>

            <div class="note">
                <p>For the safety and security, you should create a strong password that uses:</p>
                <ul class="list">
                    <li>At least 8 characters and maximum 50 characters in length.</li>
                    <li>Contain UPPER/lowercase letters and numbers.</li>
                </ul>
            </div>
        </div>
    </form>
}