@using HRP.Resources
@using HRP.Models.Employee

@model CreateEmployeeViewModel
@{
    ViewData["Title"] = ViewLang.PersonalDetail;
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/employee/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/employee/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-controller="Employee" asp-action="index">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewLang.CreateNewEmployee</li>
</ol>

<!-- Steps -->
<div class="steps small clearfix">
    <div class="step active" id="PersonalDetailsStep">
        <label class="step-title">@ViewLang.PersonalDetail</label>
    </div>
    <div class="step" id="EmploymentStep">
        <label class="step-title">@ViewLang.Employment</label>
    </div>
</div>

<!-- Nav tabs -->
<ul class="nav nav-tabs display-none" role="tablist">
    <li role="presentation" class="active">
        <a href="#PersonalDetailContentTab" aria-controls="home" role="tab" data-toggle="tab"
           id="PersonalDetailHeaderTab">@ViewLang.PersonalDetail</a>
    </li>
    <li role="presentation">
        <a href="#EmploymentContentTab" aria-controls="profile" role="tab" data-toggle="tab"
           id="EmploymentHeaderTab" data-isFirstLoad="true">@ViewLang.Employment</a>
    </li>
</ul>

<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="PersonalDetailContentTab">
        @Html.Partial("_CreatePersonalDetailsForm", Model)
    </div>
    <div role="tabpanel" class="tab-pane" id="EmploymentContentTab">
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/jquery-ui/jquery-ui.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/assets/js/employee/employee-common-funcs.js"></script>
        <script src="~/assets/js/employee/create-employee.js"></script>
        <script src="~/assets/js/employee/employment-common-funcs.js"></script>
        <script src="~/assets/js/employee/create-employment.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/employee/js/create-employee.min.js"></script>
    </environment>
}