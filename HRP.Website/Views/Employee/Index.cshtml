@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Models.Employee
@model EmployeeManagementViewModel

@{
    ViewData["Title"] = ViewLang.EmployeeList;
}

@section Styles {
    <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" asp-append-version="true" />
    <environment include="Development">
        <link href="~/css/dev/pages/employee/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/employee/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li class="active">@ViewLang.EmployeeList</li>
</ol>
<div class="list-message-error hidden" id="error-alert">
    <p class="message" id="company-validation" hidden>@Message.SelectAtLeastOneCompany</p>
    <p class="message" id="employment-status-validation" hidden>@Message.SelectAtLeastOneEmploymentStatus</p>
</div>
<div class="search-form form-filter">
    <div class="group">
        <label class="text -has-required">@ViewLang.Company</label>
        <select class="control company width-200" id="CompanyMultiSelect"></select>
    </div>
    <div class="group">
        <label class="text -has-required">@ViewLang.EmploymentStatus</label>
        <select class="control service width-200" id="EmploymentStatusMultiSelect"></select>
    </div>
    <form class="search-form form-filter" method="get">
        <input asp-for="DepartmentIds" hidden />
        <input asp-for="EmploymentStatusIds" hidden />
        <div class="group">
            <label class="text">@ViewLang.Employee</label>
            <input type="text" class="control employee" placeholder="Full name or Nickname" asp-for="DisplayName" maxlength="70" />
            <input asp-for="EmployeeId" hidden>
        </div>
        <div class="group">
            <button type="submit" class="button -primary">@ViewLang.Submit</button>
        </div>
    </form>
</div>
<div class="top-header">
    <div class="pull-left">

        @if (Model.IsHostCreateEmployee)
        {
            <a class="button -add create-user" id="create-employee" asp-action="CreateEmployee"
               asp-route-departmentIds="@Model.DepartmentIds" asp-route-employmentStatusIds="@Model.EmploymentStatusIds"
               asp-route-employeeId="@Model.EmployeeId" asp-route-employeeName="@Model.DisplayName">
                <span class="icon-add"></span>
                @ViewLang.CreateNewEmployee
            </a>
        }
    </div>

    <div class="pull-right search-box">
        <input type="search" id="quick-search" class="control" placeholder="Search" />
        <span class="icon-search"></span>
    </div>
</div>
<table id="employee-table" class="table table-bordered table-hover table-striped dataTable">
    <thead>
        <tr>
            <th class="col-number">@ViewLang.SymbolCount</th>
            <th>@ViewLang.IDNo</th>
            <th>@ViewLang.Nickname</th>
            <th>@ViewLang.FullName</th>
            <th>@ViewLang.Company</th>
            <th>@ViewLang.Division</th>
            <th>@ViewLang.Department</th>
            <th>@ViewLang.JobTitle</th>
            <th>@ViewLang.EmploymentStatus</th>
            <th>@ViewLang.Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Employees != null && Model.Employees.Any())
        {
            var index = 0;
            foreach (EmployeeBasicInfo employee in Model.Employees)
            {
                var dropdownId = string.Format("dropdown{0}", Guid.NewGuid().ToString("N"));
                index++;
                <tr>
                    <td class="text-center">@index</td>
                    <td>@employee.IDNo</td>
                    <td>@employee.Nickname</td>
                    <td>@employee.FullName</td>
                    <td>@employee.CompanyCode</td>
                    <td>@employee.DivisionCode</td>
                    <td>@employee.DepartmentCode</td>
                    <td>@employee.JobTitle</td>
                    <td>@employee.EmployeeStatus</td>
                    <td class="text-center has-icon">
                        <div class="dropdown config-action">
                            <button class="btn btn-default dropdown-toggle" type="button" id="@dropdownId"
                                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                <span class="icon-configuration"></span>
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="@dropdownId">
                                @if (employee.EditProfilePolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-controller="Employee" asp-action="UpdateEmployee"
                                           asp-route-id="@employee.EmployeeId" asp-route-departmentIds="@Model.DepartmentIds" asp-route-employmentStatusIds="@Model.EmploymentStatusIds"
                                           asp-route-employeeId="@Model.EmployeeId" asp-route-employeeName="@Model.DisplayName">
                                            <span class="icon-user"></span>

                                            @if (employee.EditProfilePolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditProfile</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewProfile</span>
                                            }
                                        </a>
                                    </li>

                                }

                                @if (employee.EditBankPolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-action="EmployeeBankAccounts" asp-controller="BankAccount"
                                           asp-route-EmployeeId="@employee.EmployeeId" data-skip="true">
                                            <span class="icon-bank-details"></span>
                                            @if (employee.EditBankPolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditbankDetails</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewBankDetails</span>
                                            }
                                        </a>
                                    </li>

                                }

                                @if (employee.EditPayRollPolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-controller="Employee" asp-action="Payroll"
                                           asp-route-id="@employee.EmployeeId" asp-route-departmentIds="@Model.DepartmentIds" asp-route-employmentStatusIds="@Model.EmploymentStatusIds"
                                           asp-route-employeeId="@Model.EmployeeId" asp-route-employeeName="@Model.DisplayName">
                                            <span class="icon-edit_payroll"></span>

                                            @if (employee.EditPayRollPolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditPayroll</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewPayroll</span>
                                            }
                                        </a>
                                    </li>

                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<environment include="Development">
    @section Scripts {
        <script src="~/lib/jquery-ui/jquery-ui.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/assets/js/employee/list-employee.js"></script>
    }
</environment>
<environment exclude="Development">
    @section Scripts {
        <script src="~/assets/bundles/employee/js/list-employee.min.js"></script>
    }
</environment>