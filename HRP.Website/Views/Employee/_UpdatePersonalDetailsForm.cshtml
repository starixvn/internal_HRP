@using HRP.Models.Employee
@using HRP.Resources
@model CreateEmployeeViewModel

<form class="personal-detail form-information" name="personalDetailsForm" enctype="multipart/form-data" id="personalDetailsForm" method="post">
    <div class="-has-icon msg-success hidden">
        @Message.UpdatePersonalDetailsSuccessfully
    </div>
    <div class="-has-border msg-error hidden"></div>

    <input type="text" hidden value="@Model.EmployeeId" id="EmployeeId" name="EmployeeId" />
    <input type="checkbox" hidden asp-for="IsHost" />

    @await Html.PartialAsync("_PersonalDetailsForm", Model)

    <div class="list-button">
        <a class="button -second" asp-controller="employee" asp-action="index"
            asp-route-departmentIds="@Model.CachingFilter.DepartmentIds" asp-route-employmentStatusIds="@Model.CachingFilter.EmploymentStatusIds"
            asp-route-employeeId="@Model.CachingFilter.EmployeeId" asp-route-displayName="@Model.CachingFilter.EmployeeName">@ViewLang.Cancel</a>
        @if (Model.IsHost)
        {
            <button type="submit" class="button -primary js-btnSubmit">@ViewLang.Save</button>
        }
    </div>
</form>