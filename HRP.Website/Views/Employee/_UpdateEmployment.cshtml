                </div>
                <input type="text" class="control" asp-for="Paymaster.NicknameBVIAllowance">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.LocalSalary</label>
                <input type="text" class="control" id="NoneOrIDNoLocalSalary">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="Paymaster.FullNameLocalSalary">
                </div>
                <input type="text" class="control" asp-for="Paymaster.NicknameLocalSalary">
            </div>

            <div class="group-complex -emp-layout9 space-between-parts">
                <div class="component">
                    <label class="text like-group-title"><span class="icon-group"></span>@ViewLang.EPA</label>
                    <label class="text-group">@ViewLang.Administrator</label>
                </div>
                <div class="component">
                    <label class="text" for="NoneOrIDNoAdministrator">@ViewLang.NoneOrIDNo</label>
                    <input type="text" class="control" id="NoneOrIDNoAdministrator">
                </div>
                <div class="component">
                    <label class="text" asp-for="EPA.FullNameAdministrator">@ViewLang.FullName</label>
                    <div class="element-required">
                        <input type="text" class="control" asp-for="EPA.FullNameAdministrator">
                    </div>
                </div>
                <div class="component">
                    <label class="text" asp-for="EPA.NicknameAdministrator">@ViewLang.Nickname</label>
                    <input type="text" class="control" asp-for="EPA.NicknameAdministrator">
                </div>
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.Evaluator #1</label>
                <input type="text" class="control" id="NoneOrIDNoEvaluator1">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameEvaluator1">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameEvaluator1">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.Evaluator #2</label>
                <input type="text" class="control" id="NoneOrIDNoEvaluator2">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameEvaluator2">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameEvaluator2">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.Reviewer</label>
                <input type="text" class="control" id="NoneOrIDNoReviewer">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameReviewer">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameReviewer">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.Management</label>
                <input type="text" class="control" id="NoneOrIDNoManagement">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameManagement">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameManagement">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.Increment</label>
                <input type="text" class="control" id="NoneOrIDNoIncrement">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameIncrement">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameIncrement">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.BVIBonus</label>
                <input type="text" class="control" id="NoneOrIDNoBVIBonus">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameBVIBonus">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameBVIBonus">
            </div>
            <div class="group-complex -emp-layout9">
                <label class="text-group">@ViewLang.LocalBonus</label>
                <input type="text" class="control" id="NoneOrIDNoLocalBonus">
                <div class="padding-right-10">
                    <input type="text" class="control" asp-for="EPA.FullNameLocalBonus">
                </div>
                <input type="text" class="control" asp-for="EPA.NicknameLocalBonus">
            </div>
            <div class="group-complex space-between-parts">
                <div class="component">
                    <label class="text like-group-title -has-required" asp-for="PDFPassword"><span class="icon-group"></span>@ViewLang.PDFPassword</label>
                    <input type="text" class="control width-240" asp-for="PDFPassword">
                </div>
            </div>
        </div>
    </div>
    <div class="list-button">
        <a class="button -second" asp-controller="employee" asp-action="index"
           asp-route-departmentIds="@Model.CachingFilter.DepartmentIds" asp-route-employmentStatusIds="@Model.CachingFilter.EmploymentStatusIds"
           asp-route-employeeId="@Model.CachingFilter.EmployeeId" asp-route-displayName="@Model.CachingFilter.EmployeeName">@ViewLang.Cancel</a>
        @if (Model.IsHost)
        {
            <button type="button" class="button -primary js-btnSubmit">@ViewLang.Save</button>
        }
    </div>
</form>