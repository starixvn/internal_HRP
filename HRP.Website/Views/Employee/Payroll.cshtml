@using HRP.Core.Enumerations
@using HRP.Resources;
@using HRP.Models.Employee.Payroll
@model EmployeePayrollViewModel

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/tooltipster/dist/css/tooltipster.bundle.css" rel="stylesheet" />
        <link href="~/lib/tooltipster/dist/css/plugins/tooltipster/sideTip/themes/tooltipster-sideTip-light.min.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/common.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/payroll.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/employee/css/payroll.min.css" rel="stylesheet" />
    </environment>
}

@{
    ViewData["Title"] = ViewLang.EditEmployeePayroll;
    var currencySelectList = new SelectList(Model.Currencies.OrderBy(x => x.CurrencyId), "CurrencyId", "CurrencyCode");
}

<!--Modals section-->
<div id="dynamic-modals"></div>

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-action="Index" asp-controller="Employee">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewLang.EditEmployeePayroll '@Model.Nickname'</li>
</ol>

<div class="tooltip-templates hidden">
    <div id="tooltip-content">
        <div>@ViewLang.SelectAutoCalculatedAmount</div>
        <label>
            <input type="checkbox"><span class="label-text">@ViewLang.DontShowAgain</span>
        </label>
    </div>
</div>

@foreach (var currency in Model.CurrencyExchangeRates)
{
    <input type="hidden" data-from-currency="@currency.FromCurrencyId" data-to-currency="@currency.ToCurrencyId" value="@currency.ExchangeRate" />
}

<input type="hidden" id="get-bank-acount-url" value="@Url.Action("GetEmployeeBankAccounts", "BankAccount")" />
<input type="hidden" id="create-bank-account-in-payroll-url" value="@Url.Action("CreateBankAccountInPayroll","BankAccount")" />
<input type="hidden" id="greater-than-zero-message" value="@Message.GreaterThanZero" />
<form class="payroll form-information" method="post" id="payroll-form" asp-action="EditPayroll"
      data-ajax-method="post" data-ajax="true" data-ajax-failure="commonFunctions.handleAjaxError"
      data-ajax-success="employeePayroll.onSaveSuccess">
    <input type="hidden" data-val="false" asp-for="EmployeeId" />
    <input type="hidden" data-val="false" asp-for="CompanyId" />
    <input type="hidden" data-val="false" asp-for="BasicSalary.EmployeeId" />
    <input type="hidden" data-val="false" asp-for="BasicSalary.OldSalary" />
    <input type="hidden" data-val="false" asp-for="BasicSalary.OldCurrencyId" />
    <input type="hidden" data-val="false" asp-for="Allowance.EmployeeId" />
    <input type="checkbox" hidden data-val="false" asp-for="CanUpdate" />
    <input type="hidden" data-val="false" asp-for="HaveHostPermissionOnBankAccounts" />
    <input type="hidden" data-val="false" asp-for="BasicSalary.InitFirstTime" />
    <input type="hidden" data-val="false" asp-for="VNDCurrencyId" />

    <div class="list-message-error hidden" id="validation-summary">
    </div>

    <div class="-has-icon msg-success hidden">
        <span>@Message.UpdateEmployeePayrollSuccessfully You will be redirected in </span>
        <span class="count-down">3</span>
        <span> seconds.</span>
    </div>

    <div class="-has-border msg-error hidden">
    </div>

    <div class="form-content">
        <!-- Basic Salary -->
        <div class="group-complex -payroll-layout1">
            <div class="">
                <div class="group-title -first"><span class="icon-group"></span>@ViewLang.BasicSalary</div>
                <label class="actual">@ViewLang.Actual</label>
            </div>
            <div class="currency-amount">
                <select class="control without-label select2" asp-for="BasicSalary.CurrencyId" asp-items="currencySelectList"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control without-label number total-amount" placeholder="Total Amount"
                       asp-for="BasicSalary.Salary" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="">
                <div class="pull-left calendar">
                    <label class="text" for="effectiveDate">@ViewLang.EffectiveDate</label>
                    <input type="text" class="control" asp-for="BasicSalary.EffectiveDate"
                           data-msg-required="@Message.EmployeePayrollEffectiveDateRequired" data-old-value="@Model.BasicSalary.EffectiveDate" />
                    <span class="icon-calendar"></span>
                </div>
                <div class="pull-right reason">
                    <label class="text" for="reason">@ViewLang.Reason</label>
                    <select class="control select2" asp-for="BasicSalary.ReasonId"
                            asp-items="@(new SelectList(Model.ChangeReasons, "ResourceId", "Value"))"
                            data-msg-required="@Message.EmployeePayrollReasonRequired"
                            data-old-value="@Model.BasicSalary.ReasonId">
                        <option></option>
                    </select>
                </div>
            </div>
            <div class="padding-top-24">
                <span>@ViewLang.StandardWorkingDays</span>
                <label class="days">
                    <input type="radio" data-val="false" value="22" asp-for="BasicSalary.WorkingDays">
                    <span>22</span>
                </label>
                <label class="days">
                    <input type="radio" data-val="false" value="26" asp-for="BasicSalary.WorkingDays">
                    <span>26</span>
                </label>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <div class="start-4">
                <div class="transaction-title"></div>
                <div class="transaction-item">
                    <span>@ViewLang.BankType</span>
                    <span>@ViewLang.PaymentTransaction</span>
                </div>
            </div>
        </div>

        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.Ebanking" />
                <span>e-Banking</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-ebanking select2"
                        asp-for="BasicSalary.EbankingCurrencyId" asp-items="currencySelectList"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-ebanking"
                       asp-for="BasicSalary.EbankingAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">e-Banking</label>
                <select class="control bank-type-select hidden" name="ebanking">
                    <option value="@((int) BankTypes.Ebanking)" selected></option>
                </select>
                <select class="control select2-ajax basic-salary-ebanking bank-account-select"
                        asp-for="BasicSalary.EbankingAccountId" data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option value="@Model.BasicSalary.EbankingAccountId">@Model.BasicSalary.EbankingAccountName</option>
                </select>
                @if (Model.HaveHostPermissionOnBankAccounts)
                {
                    <span class="add-account"></span>
                }
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking1" />
                <span>@ViewLang.DirectBanking1</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking1 select2"
                        asp-for="BasicSalary.DirectBanking1CurrencyId" asp-items="currencySelectList"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-directbanking1"
                       asp-for="BasicSalary.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">@ViewLang.DirectBanking</label>

                <select class="control bank-type-select hidden" disabled>
                    <option value="@((int) BankTypes.DirectBanking)" selected></option>
                </select>

                <select class="control select2-ajax bank-account-select basic-salary-directbanking1"
                        asp-for="BasicSalary.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option value="@Model.BasicSalary.DirectBanking1AccountId">@Model.BasicSalary.DirectBanking1AccountName</option>
                </select>
                @if (Model.HaveHostPermissionOnBankAccounts)
                {
                    <span class="add-account"></span>
                }
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking2" />
                <span>@ViewLang.DirectBanking2</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking2 select2"
                        asp-for="BasicSalary.DirectBanking2CurrencyId" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-directbanking2"
                       asp-for="BasicSalary.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">@ViewLang.DirectBanking</label>

                <select class="control bank-type-select hidden" disabled>
                    <option value="@((int) BankTypes.DirectBanking)" selected></option>
                </select>
                <select class="control select2-ajax bank-account-select basic-salary-directbanking2"
                        asp-for="BasicSalary.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option value="@Model.BasicSalary.DirectBanking2AccountId">@Model.BasicSalary.DirectBanking2AccountName</option>
                </select>
                @if (Model.HaveHostPermissionOnBankAccounts)
                {
                    <span class="add-account"></span>
                }
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="@PayrollAutoCalculateOn.Cash" />
                <span>@ViewLang.Cash</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-cash select2"
                        asp-for="BasicSalary.CashCurrencyId" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-cash"
                       asp-for="BasicSalary.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">@ViewLang.Cash</label>
                <select class="control basic-salary-cash bank-account-select select2"
                        asp-for="BasicSalary.CashAccountId" asp-items="@(new SelectList(Model.CashAccounts, "ResourceId", "Value"))"
                        data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option></option>
                </select>
            </div>
        </div>
        <hr />
        <!-- Allowances -->
        <div class="group-complex -payroll-layout3">
            <div class="group-title -first"><span class="icon-group"></span>@ViewLang.Allowances</div>
            <div class="conversion start-3">@ViewLang.Conversion</div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="actual">@ViewLang.Actual</div>
            <div class="currency-amount start-3">
                <select class="control select2" asp-items="currencySelectList" asp-for="Allowance.CurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control total-amount" readonly name="AllowanceTotal" id="allowance-total-amount"
                       data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="transaction-item -allowances">
                <span>@ViewLang.BankType</span>
                <span>@ViewLang.PaymentTransaction</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking1" />
                <span>@ViewLang.DirectBanking1</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking1 select2"
                        asp-items="currencySelectList" asp-for="Allowance.DirectBanking1CurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking1"
                       asp-for="Allowance.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <label class="bank-type">@ViewLang.DirectBanking</label>

                <select class="control bank-type-select hidden" disabled>
                    <option value="@((int) BankTypes.DirectBanking)" selected></option>
                </select>

                <select class="control select2-ajax bank-account-select allowance-directbanking1"
                        asp-for="Allowance.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option value="@Model.Allowance.DirectBanking1AccountId">@Model.Allowance.DirectBanking1AccountName</option>
                </select>
                @if (Model.HaveHostPermissionOnBankAccounts)
                {
                    <span class="add-account"></span>
                }
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="@PayrollAutoCalculateOn.DirectBanking2" />
                <span>@ViewLang.DirectBanking2</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking2 select2"
                        asp-items="currencySelectList" asp-for="Allowance.DirectBanking2CurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking2"
                       asp-for="Allowance.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <label class="bank-type">@ViewLang.DirectBanking</label>

                <select class="control bank-type-select hidden" disabled>
                    <option value="@((int) BankTypes.DirectBanking)" selected></option>
                </select>
                <select class="control select2-ajax bank-account-select allowance-directbanking2"
                        asp-for="Allowance.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option value="@Model.Allowance.DirectBanking2AccountId">@Model.Allowance.DirectBanking2AccountName</option>
                </select>
                @if (Model.HaveHostPermissionOnBankAccounts)
                {
                    <span class="add-account"></span>
                }
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="@PayrollAutoCalculateOn.Cash" />
                <span>@ViewLang.Cash</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-cash select2"
                        asp-items="currencySelectList" asp-for="Allowance.CashCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-cash"
                       asp-for="Allowance.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <label class="bank-type">Cash</label>
                <select class="control allowance-cash bank-account-select select2"
                        asp-for="Allowance.CashAccountId" asp-items="@(new SelectList(Model.CashAccounts, "ResourceId", "Value"))"
                        data-msg-required="@Message.EmployeePayrollAccountRequired">
                    <option></option>
                </select>
            </div>
        </div>

        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Subsistence</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 subsistence"
                        asp-items="currencySelectList" asp-for="Allowance.SubsistenceCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate subsistence"
                       asp-for="Allowance.SubsistenceAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.HomePassage</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 home-passage"
                        asp-items="currencySelectList" asp-for="Allowance.HomePassageCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate home-passage"
                       asp-for="Allowance.HomePassageAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Housing</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 housing"
                        asp-items="currencySelectList" asp-for="Allowance.HousingCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate housing"
                       asp-for="Allowance.HousingAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.MobilePhone</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 mobile-phone"
                        asp-items="currencySelectList" asp-for="Allowance.MobilePhoneCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate mobile-phone"
                       asp-for="Allowance.MobilePhoneAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.HPI</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 hpi"
                        asp-items="currencySelectList" asp-for="Allowance.HPICurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate hpi"
                       asp-for="Allowance.HPIAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
            <div class="transaction-item -allowances">
                <span class="bank-name">@ViewLang.WorkingDays</span>
                <span class="bank-name">@ViewLang.Rate</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.DutyMeal</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 duty-meal"
                        asp-items="currencySelectList" asp-for="Allowance.DutyMealCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate duty-meal" readonly
                       asp-for="Allowance.DutyMealAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
            <div class="payment-transaction -allowances">
                <input type="text" class="control number" disabled id="working-days" value="@Model.BasicSalary.WorkingDays" />
                <input type="text" class="control number" name="duty-meal-per-day" id="duty-meal-per-day"
                       value="@(string.IsNullOrEmpty(Model.Allowance.DutyMealAmount) ? "" : (decimal.Parse(Model.Allowance.DutyMealAmount) / Model.BasicSalary.WorkingDays ).ToString())" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Secondment</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 secondment"
                        asp-items="currencySelectList" asp-for="Allowance.SecondmentCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate secondment"
                       asp-for="Allowance.SecondmentAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Others</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2 others"
                        asp-items="currencySelectList" asp-for="Allowance.OthersCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate others"
                       asp-for="Allowance.OthersAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount-display" disabled />
                <input type="hidden" class="allowance-convert-amount" disabled />
            </div>
        </div>
        <hr />
        <!-- Deductions -->
        <div class="deductions-title"><span class="icon-group"></span>@ViewLang.Deductions</div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">@ViewLang.RoomingCharges</div>
            <div class="currency-amount">
                <select class="control deduction-calculate select2 rooming-charges"
                        asp-items="currencySelectList" asp-for="Deduction.RoomingChargesCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate rooming-charges"
                       asp-for="Deduction.RoomingChargesAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">@ViewLang.FitnessFirst</div>
            <div class="currency-amount">
                <select class="control deduction-calculate select2 fitness-first"
                        asp-items="currencySelectList" asp-for="Deduction.FitnessFirstCurrencyId"
                        data-msg-required="@Message.EmployeePayrollCurrencyRequired">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate fitness-first"
                       asp-for="Deduction.FitnessFirstAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequired" />
            </div>
        </div>
        <div class="list-button">
            <a class="button -second" asp-controller="employee" asp-action="index"
               asp-route-departmentIds="@Model.CachingFilter.DepartmentIds" asp-route-employmentStatusIds="@Model.CachingFilter.EmploymentStatusIds"
               asp-route-employeeId="@Model.CachingFilter.EmployeeId" asp-route-displayName="@Model.CachingFilter.EmployeeName">@ViewLang.Cancel</a>
            @if (Model.CanUpdate)
            {
                <button class="button -primary" type="button" data-loading-text="@ViewLang.Saving ..." id="btn-save">@ViewLang.Save</button>
            }
        </div>
    </div>
</form>

<div class="modal fade" tabindex="-1" role="dialog" id="modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <p>@ViewLang.EmployeePayrollChangedWarning</p>
            </div>
            <div class="modal-footer">
                <div class="list-button">
                    <button class="button -primary" type="button" data-loading-text="Updating..." id="btn-yes">@ViewLang.Yes</button>
                    <button type="button" class="button -second" data-dismiss="modal">@ViewLang.No</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/bignumber.js/bignumber.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/tooltipster/dist/js/tooltipster.bundle.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.numeric.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/jquery.inputmask.js"></script>
        <script type="text/javascript" src="~/assets/js/bank/bank-account-form.js" asp-append-version="true"></script>
        <script src="~/assets/js/employee/employee-payroll.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/bignumber.js/bignumber.min.js"></script>
        <script src="~/assets/bundles/employee/js/employee-payroll.min.js"></script>
    </environment>
}