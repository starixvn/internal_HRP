@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Models.Employee
@model IEnumerable<EmployeeBasicInfo>

<table id="employee-table" class="table table-bordered table-hover table-striped dataTable">
    <thead>
        <tr>
            <th class="col-number">@ViewLang.SymbolCount</th>
            <th>@ViewLang.IDNo</th>
            <th>@ViewLang.Nickname</th>
            <th>@ViewLang.FullName</th>
            <th>@ViewLang.Company</th>
            <th>@ViewLang.Division</th>
            <th>@ViewLang.Department</th>
            <th>@ViewLang.JobTitle</th>
            <th>@ViewLang.EmploymentStatus</th>
            <th>@ViewLang.Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var index = 0;
            foreach (EmployeeBasicInfo employee in Model)
            {
                var dropdownId = string.Format("dropdown{0}", Guid.NewGuid().ToString("N"));
                index++;
                <tr>
                    <td class="text-center">@index</td>
                    <td>@employee.IDNo</td>
                    <td>@employee.Nickname</td>
                    <td>@employee.FullName</td>
                    <td>@employee.CompanyCode</td>
                    <td>@employee.DivisionCode</td>
                    <td>@employee.DepartmentCode</td>
                    <td>@employee.JobTitle</td>
                    <td>@employee.EmployeeStatus</td>
                    <td class="text-center has-icon">
                        <div class="dropdown config-action">
                            <button class="btn btn-default dropdown-toggle" type="button" id="@dropdownId"
                                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                <span class="icon-configuration"></span>
                                <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="@dropdownId">
                                @if (employee.EditProfilePolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-action="UpdateEmployee" asp-route-id="@employee.EmployeeId">
                                            <span class="icon-user"></span>

                                            @if (employee.EditProfilePolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditProfile</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewProfile</span>
                                            }
                                        </a>
                                    </li>

                                }

                                @if (employee.EditBankPolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-action="EmployeeBankAccounts"
                                           asp-controller="BankAccount"
                                           asp-route-EmployeeId="@employee.EmployeeId"
                                           data-skip="true">
                                            <span class="icon-bank-details"></span>
                                            @if (employee.EditBankPolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditbankDetails</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewBankDetails</span>
                                            }
                                        </a>
                                    </li>

                                }

                                @if (employee.EditPayRollPolicy != Policy.None)
                                {
                                    <li>
                                        <a asp-action="Payroll"
                                           asp-controller="Employee"
                                           asp-route-id="@employee.EmployeeId">
                                            <span class="icon-edit_payroll"></span>

                                            @if (employee.EditPayRollPolicy == Policy.Host)
                                            {
                                                <span>@ViewLang.EditPayroll</span>
                                            }
                                            else
                                            {
                                                <span>@ViewLang.ViewPayroll</span>
                                            }
                                        </a>
                                    </li>

                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>