@using HRP.Resources
@using HRP.Models.Employee
@model CreateEmployeeViewModel
@{
    ViewData["Title"] = ViewLang.PersonalDetail;
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/employee/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/employee/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/employee/edit.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/employee/edit.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-controller="Employee" asp-action="index">@ViewLang.EmployeeList</a></li>
    <li class="active">@(Model.IsHost ? "Edit" : "View") Employee '@Model.Nickname'</li>
</ol>

<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#PersonalDetailsContentTab" aria-controls="home" role="tab" data-toggle="tab"
           id="PersonalDetailHeaderTab">@ViewLang.PersonalDetail</a>
    </li>
    <li role="presentation">
        <a href="#EmploymentContentTab" aria-controls="profile" role="tab" data-toggle="tab"
           id="EmploymentHeaderTab" data-isFirstLoad="true">@ViewLang.Employment</a>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="PersonalDetailsContentTab">
        @await Html.PartialAsync("_UpdatePersonalDetailsForm", Model)
    </div>
    <div role="tabpanel" class="tab-pane" id="EmploymentContentTab"></div>
</div>