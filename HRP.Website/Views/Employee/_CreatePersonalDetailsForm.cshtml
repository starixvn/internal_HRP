@using HRP.Models.Employee
@using HRP.Resources
@model CreateEmployeeViewModel

<form class="personal-detail form-information" name="personalDetailsForm" enctype="multipart/form-data"
      id="personalDetailsForm" asp-action="CreatePersonalDetails">
    @await Html.PartialAsync("_PersonalDetailsForm", Model)

    <div class="list-button">
        <a class="button -second" asp-controller="employee" asp-action="index"
            asp-route-departmentIds="@Model.CachingFilter.DepartmentIds" asp-route-employmentStatusIds="@Model.CachingFilter.EmploymentStatusIds"
            asp-route-employeeId="@Model.CachingFilter.EmployeeId" asp-route-displayName="@Model.CachingFilter.EmployeeName">@ViewLang.Cancel</a>
        <button class="button -primary" type="submit">@ViewLang.Next</button>
    </div>
</form>