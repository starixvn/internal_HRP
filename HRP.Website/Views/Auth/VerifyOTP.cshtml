@model HRP.Models.TwoFactorAuthenticatorViewModel

@{
    ViewBag.Title = "Verify OTP code";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
</head>
<body>
@using (Html.BeginForm())
{
    <div class="form-group">
        <div class="form-group">
            <label for="OTPCode">VerifyCode</label>
            <input asp-for="OTPCode" class="form-control", placholder="OTP Code"/>
        </div>
        <div class="form-group">
            <label for="SkipTwoFactor">Skip Two Factor</label>
            <input asp-for="SkipTwoFactor", class="form-control", checked />
        </div>
        <input type="submit" class="form-control btn btn-primary" value="Verify" />
    </div>
}
</body>
</html>