@model HRP.Models.TwoFactorAuthenticatorViewModel

@{
    ViewBag.Title = "Verify OTP code";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
</head>
<body>
@using (Html.BeginForm())
{
    <div class="form-group">
        <div class="form-group">
            <label for="VerifyCode">VerifyCode</label>
            @Html.TextBoxFor(model => model.VerifyCode, new {@class = "form-control"})
        </div>
        <div class="form-group">
            <label for="SkipTwoFactor">Skip Two Factor</label>
            @Html.CheckBoxFor(model => model.SkipTwoFactor, new {@class = "form-control", @checked = "checked"})
        </div>
        <input type="submit" class="form-control btn btn-primary" value="Verify" />
    </div>
}
</body>
</html>