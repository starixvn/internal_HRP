@model HRP.Models.UserProfile.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset password";
    Layout = "_LoginLayout";
}

<section class="block -reset-password">
    @using (Html.BeginForm())
    {
        <div class="circle-large">
            <span class="icon-key"></span>
        </div>
        <h1 class="title">Reset your password</h1>
        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="Password" class="form-control" placeholder="New Password" />
            <span asp-validation-for="Password" class="msg-error"></span>
            <div class="note">
                <p>For the safety and security of your account, your new password should:</p>
                <ul class="list">
                    <li>Be at least 8 characters and maximum 50 characters in length.</li>
                    <li>Contain UPPER/lowercase letters and numbers.</li>
                </ul>
            </div>
        </div>
        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="PasswordConfirm" class="form-control" placeholder="Confirm New Password" />
            <span asp-validation-for="PasswordConfirm" class="msg-error"></span>
        </div>
        <div class="group">
            <input type="submit" value="Submit" class="button -primary" />
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="group">
                <span class="msg-success">@ViewBag.Message</span>
            </div>
        }
        <div class="footer">
            <a class="link action-back" href="/Auth/Login">Back to login</a>
        </div>

    }
</section>