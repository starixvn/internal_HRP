<!DOCTYPE html>
<html>
<head>
    <title>Reset Your Password</title>
    <meta charset="utf-8" />
    <link href="assets/bundles/before-login.min.css" rel="stylesheet" />
</head>
<body>
    <header class="header">
        <a href="#" class="logo">
            <img src="assets/styles/images/logo_page.svg" alt="logo" />
        </a>
    </header>
    <section class="block -reset-password">
        <div class="circle-large">
            <span class="icon-key"></span>
        </div>
        <h1 class="title">Reset your password</h1>
        <div class="group">
            <span class="icon-password"></span>
            <input type="password" class="form-control" placeholder="New Password" />
            <span class="msg-error">
                Password must contain at least 8 characters, including UPPER/lowercase and number.
            </span>
            <div class="note">
                <p>For the safety and security of your account, your new password should:</p>
                <ul class="list">
                    <li>Be at least 8 characters and maximum 50 characters in length.</li>
                    <li>Contain UPPER/lowercase letters and numbers.</li>
                </ul>
            </div>
        </div>
        <div class="group">
            <span class="icon-password"></span>
            <input type="password" class="form-control" placeholder="Confirm New Password" />
        </div>
        <div class="group">
            <input type="submit" value="Submit" class="button -primary" />
        </div>
        <div class="footer">
            <a class="link action-back" href="/login.html">Back to login</a>
        </div>
        
    </section>
</body>
</html>
