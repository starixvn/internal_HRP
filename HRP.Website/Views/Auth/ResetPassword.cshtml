@using HRP.Resources
@model HRP.Models.Account.ResetPasswordViewModel

@{
    ViewBag.Title = ViewLang.ResetPassword;
    Layout = "_LoginLayout";
}

<section class="block -reset-password">
    @using (Html.BeginForm())
    {
        <div class="circle-large">
            <span class="icon-key"></span>
        </div>
        <h1 class="title">@ViewLang.ResetYourPassword</h1>

        <div asp-validation-summary="ModelOnly" class="msg-error -has-icon"></div>

        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="Password" class="form-control" placeholder="New Password" />
            <span asp-validation-for="Password" class="msg-error"></span>
            <div class="note">
                <p>For the safety and security of your account, your new password should:</p>
                <ul class="list">
                    <li>Be at least 8 characters and maximum 50 characters in length.</li>
                    <li>Contain UPPER/lowercase letters and numbers.</li>
                </ul>
            </div>
        </div>
        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="PasswordConfirm" class="form-control" placeholder="Confirm New Password" />
            <span asp-validation-for="PasswordConfirm" class="msg-error"></span>
        </div>
        <div class="group">
            <label>
                <input type="checkbox" id="showPassword" />
                <span>@ViewLang.ShowPassword</span>
            </label>
        </div>
        <div class="group">
            <input type="submit" value="@ViewLang.Submit" class="button -primary" />
        </div>

        <div class="footer">
            <a class="link action-back" asp-controller="auth" asp-action="logout">@ViewLang.BackToLogin</a>
        </div>
    }
</section>
<script type="text/javascript" src="~/assets/bundles/auth/js/reset-password.min.js"></script>