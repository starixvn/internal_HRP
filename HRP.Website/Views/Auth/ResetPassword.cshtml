@using HRP.Resources
@model HRP.Models.Account.ResetPasswordViewModel
@{
    ViewBag.Title = ViewLang.ResetPassword;
    Layout = "_LoginLayout";
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" asp-append-version="true" src="~/lib/CryptoJS/aes.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/rijndael-service.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/client-encryption.js"></script>

        <script type="text/javascript" asp-append-version="true" src="~/assets/js/reset-password.js"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" asp-append-version="true" src="~/assets/bundles/auth/js/reset-password.min.js"></script>
    </environment>
}
<section class="block -reset-password">
    <input type="hidden" class="encryption-iv" asp-for="RijndaelIV" id="RijndaelIV" />
    <input type="hidden" class="encryption-key" asp-for="RijndaelKey" id="RijndaelKey" />

    <form asp-controller="Auth" asp-action="ResetPassword" asp-route-token="@Context.Request.Query["token"]">
        <div class="circle-large">
            <span class="icon-key"></span>
        </div>
        <h1 class="title">@ViewLang.ResetYourPassword</h1>

        <div asp-validation-summary="ModelOnly" class="msg-error -has-icon"></div>

        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="Password" class="form-control encrypt" data-isencrypted="false" placeholder="@ViewLang.NewPassword" />
            <span asp-validation-for="Password" class="msg-error"></span>
            <div class="note">
                <p>@Message.PasswordRuleTitle</p>
                <ul class="list">
                    <li>@Message.PasswordRuleLenght</li>
                    <li>@Message.PasswordRuleCharacters</li>
                </ul>
            </div>
        </div>
        <div class="group">
            <span class="icon-password"></span>
            <input asp-for="PasswordConfirm" class="form-control encrypt" data-isencrypted="false" placeholder="@ViewLang.ConfirmPassword" />
            <span asp-validation-for="PasswordConfirm" class="msg-error"></span>
        </div>
        <div class="group">
            <label>
                <input type="checkbox" id="showPassword" />
                <span>@ViewLang.ShowPassword</span>
            </label>
        </div>
        <div class="group">
            <input type="submit" value="@ViewLang.Submit" class="button -primary" />
        </div>

        <div class="footer">
            <a class="link action-back" asp-controller="auth" asp-action="logout">@ViewLang.BackToLogin</a>
        </div>
    </form>
</section>