@using HRP.Models.Account
@model SetupOtpViewModel
@{
    ViewData["Title"] = "Setup OTP";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<p>The OTP will be required when you make log in to HRP system. You will need to register for the Mobile Authenticator App before enabling the OTP</p>

<section>
    <h3>1. Download Authenticator app on your device</h3>
    <div>
        <div>
            <img src="~/assets/styles/images/otp/app.png" />
        </div>
        <div>
            <h4>Google Authenticator</h4>
            <h5>Google LLC</h5>
            <div>
                <div>
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en">
                        <img src="~/assets/styles/images/otp/google.png" />
                    </a>
                    <a href="https://itunes.apple.com/vn/app/google-authenticator/id388497605?mt=8">
                        <img src="~/assets/styles/images/otp/apple.svg" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <h3>2. Create an account by scanning this QR code with Google Authenticator</h3>
    <img src="@Model.QrCodeLink"/>
    <div>
        <p>Unable to scan the QR code?</p>
        <p>Please input the key below to the Manual Add page in Google Authenticator and click Done (iOS) or Add (Android)</p>
        <p>
            <span>Key:</span>
            <span>@Model.TextCode</span>
        </p>
    </div>
</section>

<section>
    <h3>3. Enter the 6-digits code generated by Google Authenticator into the textbox below then click Verify to complete the registration</h3>
    <form>
        <div class="input-group">
            <input typex="text" asp-for="Otp"/>
            <label>OTP</label>
        </div>

        <button type="submit">Verify</button>
    </form>
</section>