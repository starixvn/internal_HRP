@model HRP.Models.LoginViewModel

@{
    ViewBag.Title = "Reset Password Successfully";
    Layout = "_LoginLayout";
}

@section styles
    {
    <link href="assets/bundles/before-login.min.css" rel="stylesheet" />
}

<section class="block -confirmation-email">
    <div class="circle-large">
        <span class="icon-done"></span>
    </div>
    <h1 class="title">Reset password successfully!</h1>
    <p class="intro">
        Your user account password has been reset. <br>
        You may sign in using your new password now.
    </p>
    <div class="footer">
        <a class="link action-next" asp-controller="Auth" asp-action="Login">Go to login page</a>
    </div>
</section>