@model HRP.Models.LoginViewModel

@{
    ViewBag.Title = "Forgot password";
    Layout = "_LoginLayout";
}

@section styles
{
    <link href="assets/bundles/before-login.min.css" rel="stylesheet" />
}

<div class="circle-large">
    <span class="icon-password"></span>
    <span class="icon-question"></span>
</div>
<h1 class="title">Forgot Your Password ?</h1>
<p class="intro">
    We heard you need a password reset. Please enter your username register
    on your account and click <span class="text-special">“Reset Password”</span>. We’ll email you with a secure link
    from which you can set a new password.
</p>

<form asp-controller="Auth" asp-action="ForgotPassword" method="POST">
    <div class="group">
        <span class="icon-user"></span>
        <input asp-for="Username" class="form-control", placeholder="Username" aria-required="Username is required">
        
    </div>
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="group">
                <span class="msg-error">@ViewBag.ErrorMessage</span>
            </div>
        }
    <div class="group">
        <input type="submit" value="Reset Password" class="btn -primary" />
    </div>
</form>

<div class="footer">
    <a class="link action-back" href="/Auth/Login">Back to login</a>
</div>

@section scripts
{
    <script type="text/javascript" src="/assets/js/login.js"></script>
}
  
