@model HRP.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <meta charset="utf-8" />
    <link href="assets/bundles/login.min.css" rel="stylesheet" />
</head>
<body>
    <section class="block">
        <a href="#" class="logo">
            <img src="assets/styles/images/logo_login.svg" alt="logo" />
        </a>
         <form asp-controller="Auth" asp-action="Login" method="POST">
            <div class="group">
                <span class="icon-user"></span>
                <input asp-for="Username" class="form-control", placeholder="Username">
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input asp-for="Password" class="form-control", placeholder="Password">
            </div>
            <div class="group">
                <input type="submit" value="Login" class="btn -primary" />
            </div>
        </form>
        <div class="footer">
            <a class="link" href="/forgot-password">Forgot Password?</a>
        </div>
    </section>

</body>
</html>


