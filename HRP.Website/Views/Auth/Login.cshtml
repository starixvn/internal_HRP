@using HRP.Resources
@using HRP.Core.Constants
@model HRP.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewLang.Login</title>
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="~/assets/bundles/auth/css/login.min.css" rel="stylesheet" />
</head>
<body>
    <section class="block">
        <a href="#" class="logo">
            <img src="~/assets/styles/images/logo_login.svg" alt="logo" />
        </a>

        <form asp-controller="Auth" asp-action="Login" method="POST" id="login" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="msg-error -has-icon"></div>
            <div class="group">
                <span class="icon-user"></span>
                <input asp-for="Username" class="form-control" placeholder="Username" />
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input asp-for="Password" class="form-control" placeholder="Password" />
            </div>

            <div class="group">
                <input type="submit" value="Login" class="button -primary" />
            </div>
        </form>
        <div class="footer">
            <a class="link" asp-controller="Auth" asp-action="ForgotPassword">@ViewLang.ForgotPassword?</a>
        </div>
    </section>
    <input hidden value="@Constants.RijndaelKey" id="RijndaelKey" />
    <input hidden value="@Constants.RijndaelIV" id="RijndaelIV" />
    <script type="text/javascript" src="~/assets/bundles/auth/js/login.min.js"></script>
</body>
</html>