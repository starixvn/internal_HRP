@model HRP.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <meta charset="utf-8" />
    <link href="/assets/bundles/login.min.css" rel="stylesheet" />
    <script type="text/javascript" src="/assets/js/libs/jquery-2.1.4.min.js"></script>
    <script type="text/javascript" src="/assets/js/libs/jquery-ui-1.11.4.min.js"></script>
    <script type="text/javascript" src="/assets/js/libs/jquery.validate.min.js"></script>
    <script type="text/javascript" src="/assets/js/libs/jquery.validate.unobtrusive.min.js"></script>
    
</head>
<body>
    <section class="block">
        <a href="#" class="logo">
            <img src="/assets/styles/images/logo_login.svg" alt="logo" />
        </a>
         <form asp-controller="Auth" asp-action="Login" method="POST" id="login">
            <div class="group">
                <span class="icon-user"></span>
                <input asp-for="Username" class="form-control", placeholder="Username">
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input asp-for="Password" class="form-control", placeholder="Password">
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="group">
                     <p style="color: red">@ViewBag.ErrorMessage</p>
                </div>
            }
            <div class="group">
                <input type="submit" value="Login" class="btn -primary" />
            </div>
            
        </form>
        <div class="footer">
            <a class="link" href="/forgot-password">Forgot Password?</a>
        </div>
    </section>
    <script type="text/javascript" src="/assets/js/login.js"></script>
</body>
</html>