@using HRP.Resources
@model HRP.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewLang.Login</title>
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/css/fonts/hrp/style.css" asp-append-version="true" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/auth/login.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/auth/login.chunk.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <section class="block">
        <a href="javascript:;" class="logo">
            <img src="~/css/images/logo_login.svg" alt="logo" />
        </a>

        <form asp-controller="Auth" asp-action="Login" method="POST" id="login" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="msg-error -has-icon"></div>
            <input hidden value="@Model.RijndaelKey.Key" name="RijndaelKey.Key" />
            <input hidden value="@Model.RijndaelIV.Key" name="RijndaelIV.Key" />
            <div class="group">
                <span class="icon-user"></span>
                <input asp-for="Username" class="form-control" placeholder="Username" />
            </div>
            <div class="group">
                <span class="icon-password"></span>
                <input asp-for="Password" class="form-control" placeholder="Password" />
            </div>

            <div class="group">
                <input type="button" value="Login" class="button -primary" id="btn-submit" />
            </div>
        </form>
        <div class="footer">
            <a class="link" asp-controller="Auth" asp-action="ForgotPassword">@ViewLang.ForgotPassword?</a>
        </div>
    </section>
    <input hidden value="@Model.RijndaelKey.Value" id="RijndaelKey" />
    <input hidden value="@Model.RijndaelIV.Value" id="RijndaelIV" />
    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/jquery-ui/jquery-ui.js"></script>
        <script src="~/lib/CryptoJS/aes.js"></script>
        <script src="~/assets/js/rijndael-service.js"></script>
        <script src="~/assets/js/login.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/auth/js/login.min.js"></script>
    </environment>
</body>
</html>