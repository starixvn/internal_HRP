@model HRP.Models.Bank.EditEmployeeBankDetailsViewModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

@*Employee Name*@
@Model.EmployeeName

@*Filter form*@
<form asp-action="EditEmployeeBankDetails" asp-controller="EmployeeManagement" method="get">
    <input asp-for="EmployeeId" type="hidden"/>
    @Html.DropDownListFor(x => x.SelectedBankType, Model.BankTypes)
    @Html.DropDownListFor(x => x.IsActiveBankAccount, Model.BankAccountActive)
    <button type="submit">Submit</button>
</form>

<a href="#">+ Create New Bank Account</a>

@foreach (var bankAccount in Model.BankAccounts)
{
    <div>@bankAccount.AccountNumber</div>
}