@using HRP.Core.Enumerations
@using HRP.Resources
@using HRP.Models.EmployeeManagement

@model CreateEmployeeViewModel
@{
    ViewData["Title"] = "Personal Detail";
    var activePanel = ViewBag.ActivePanel ?? EmployeeTab.PersonalDetail.ToString();
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/jquery-ui/jquery-ui.css" rel="stylesheet" />
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/common.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/employee.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/employee/css/create-employee.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-controller="employeemanagement" asp-action="index">@ViewLang.EmployeeList</a></li>
    <li class="active">@(Model.IsHost ? "Edit" : "View") Employee '@Model.NickName'</li>
</ol>
<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist" data-active="@activePanel">
    <li role="presentation" class="active">
        <a href="#@EmployeeTab.PersonalDetail" aria-controls="home" role="tab" data-toggle="tab">@ViewLang.PersonalDetail</a>
    </li>
    <li role="presentation">
        <a href="#@EmployeeTab.Employment" aria-controls="profile" role="tab" data-toggle="tab">@ViewLang.Employment</a>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="@EmployeeTab.PersonalDetail">
        @Html.Partial("_UpdatePersonalDetails", Model)
    </div>
    <div role="tabpanel" class="tab-pane" id="@EmployeeTab.Employment"></div>
</div>

@section Scripts {
<environment include="Development">
    <script src="~/lib/jquery-ui/jquery-ui.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/lib/moment/moment.js"></script>
    <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
    <script src="~/lib/select2/dist/js/select2.js"></script>
    <script src="~/assets/js/employee/employee-common-funcs.js"></script>
    <script src="~/assets/js/employee/edit-employee.js"></script>
</environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/employee/js/edit-employee.min.js"></script>
    </environment>
}