@using HRP.Models.EmployeeManagement
@using HRP.Resources
@model CreateEmployeeViewModel

<form class="personal-detail form-information" name="personalDetailsForm" enctype="multipart/form-data" id="personalDetailsForm" method="post">
    <div class="-has-icon msg-success hidden"></div>
    <div class="-has-icon msg-error hidden"></div>

    <input type="text" hidden value="@Model.EmployeeId" id="EmployeeId" name="EmployeeId" />
    <input type="checkbox" hidden asp-for="IsHost" />

    @Html.Partial("_PersonalDetailsForm", Model)

    <div class="list-button">
        <a class="button -second" asp-action="index"
           asp-route-departmentIds="@Model.Filter.DepartmentIds"
           asp-route-employeeStatusIds="@Model.Filter.EmployeeStatusIds"
           asp-route-employeeId="@Model.Filter.EmployeeId"
           asp-route-displayName="@Model.Filter.DisplayName">@ViewLang.Cancel</a>
        @if (Model.IsHost)
        {
            <button type="submit" class="button -primary js-btnSubmit">@ViewLang.Save</button>
        }
    </div>
</form>