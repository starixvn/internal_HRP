@using HRP.Models.EmployeeManagement
@using HRP.Resources
@model CreateEmployeeViewModel

<form class="personal-detail form-information" name="personalDetailsForm" enctype="multipart/form-data" id="personalDetailsForm"
      asp-action="UpdatePersonalDetails" asp-controller="EmployeeManagement" data-ajax-method="post" data-ajax="true"
      data-ajax-success="updateEmployee.onUpdateSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
    <div class="-has-icon msg-success hidden"></div>

    <input type="hidden" asp-for="EmployeeId" />
    <input type="checkbox" hidden asp-for="IsHost" />

    @Html.Partial("_PersonalDetailsForm", Model)

    <div class="list-button">
        @if (Model.IsHost)
        {
            <button type="button" class="button -second" asp-action="index">@ViewLang.Cancel</button>
            <button type="button" class="button -primary js-btnSubmit">@ViewLang.Save</button>
        }
    </div>
</form>