@{
    ViewData["Title"] = "Index";
}

<environment include="Development">
    @section Styles {
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/employee-management.css" rel="stylesheet" />
    }
</environment>
<environment exclude="Development">
    @section Styles {        
        <link href="~/assets/bundles/employee/css/employee-management.min.css" rel="stylesheet" />
    }
</environment>

<ol class="breadcrumb">
    <li class="like-link">Employee Management</li>
    <li class="active">Employee List</li>
</ol>
<form class="search-form">
    <div class="group">
        <label class="text">Company</label>
        <select class="control company" name="status">
            <option>All</option>
        </select>
    </div>
    <div class="group">
        <label class="text">In Service</label>
        <select class="control service" name="status">
            <option>All</option>
        </select>
    </div>
    <div class="group">
        <label class="text">In Probation</label>
        <select class="control probation" name="status">
            <option>All</option>
        </select>
    </div>
    <div class="group">
        <label class="text">Employee</label>
        <input type="text" class="control employee" placeholder="Full name or Nick name">
    </div>
    <button type="submit" class="button -primary">Submit</button>
</form>
<div class="top-header">
    <div class="pull-left">        
        <a href="/employeemanagement/CreateEmployee" class="button -add create-user">
            <span class="icon-add"></span>
            Create New Employee
        </a>
    </div>
    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" />
        <span class="icon-search"></span>
    </div>
</div>
<table id="user-table" class="table table-bordered table-hover table-striped dataTable">
    <thead>
        <tr>
            <th>#</th>
            <th>ID No.</th>
            <th>Nickname</th>
            <th>Full Name</th>
            <th>Company</th>
            <th>Division</th>
            <th>Department</th>
            <th>Job Title</th>
            <th>In Service</th>
            <th>Probation</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1</td>
            <td>OW23455</td>
            <td>Brian</td>
            <td>Brian Lagree</td>
            <td>OW</td>
            <td>IT</td>
            <td>SD</td>
            <td>Senior Network Engineer</td>
            <td class="text-center has-icon"><span class="icon-active"></span></td>
            <td class="text-center has-icon"><span class="icon-active"></span></td>
            <td class="text-center has-icon">
                <div class="dropdown config-action">
                    <button class="btn btn-default dropdown-toggle" type="button" id="dropdown-1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <span class="icon-configuration"></span>
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdown-1">                           
                        <li><a href="#"><span class="icon-user"></span>Edit Profile</a></li>
                        <li><a href="#"><span class="icon-edit_payroll"></span>Edit Payroll</a></li>
                    </ul>
                </div>
                
            </td>
        </tr>
        <tr>
            <td>2</td>
            <td>OW23456</td>
            <td>Hunter</td>
            <td>Hunter Tran</td>
            <td>OW</td>
            <td>IT</td>
            <td>SD</td>
            <td>Rick & Pricing Analyst</td>
            <td class="text-center has-icon"><span class="icon-active"></span></td>
            <td class="text-center has-icon"><span class="icon-active"></span></td>
            <td class="text-center has-icon">
                <div class="dropdown config-action">
                    <button class="btn btn-default dropdown-toggle" type="button" id="dropdown-1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <span class="icon-configuration"></span>
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdown-1">                           
                        <li><a href="#"><span class="icon-user"></span>Edit Profile</a></li>
                        <li><a href="#"><span class="icon-edit_payroll"></span>Edit Payroll</a></li>
                    </ul>
                </div>
                
            </td>
        </tr>
        <tr>
            <td>3</td>
            <td>OW23460</td>
            <td>Alice</td>
            <td>Alice Le</td>
            <td>OW</td>
            <td>IT</td>
            <td>SD</td>
            <td>IT Network Engineer</td>
            <td class="text-center has-icon"><span class="icon-active"></span></td>
            <td class="text-center has-icon"></td>
            <td class="text-center has-icon">
                <div class="dropdown config-action">
                    <button class="btn btn-default dropdown-toggle" type="button" id="dropdown-1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <span class="icon-configuration"></span>
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdown-1">                           
                        <li><a href="#"><span class="icon-user"></span>Edit Profile</a></li>
