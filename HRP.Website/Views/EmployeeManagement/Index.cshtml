@using HRP.Resources;
@using HRP.Models.EmployeeManagement
@using HRP.Core.Enumerations
@model EmployeeManagementViewModel

@{
    ViewData["Title"] = "Employee List";
}

<environment include="Development">
    @section Styles {
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/employee-management.css" rel="stylesheet" />
    }
</environment>
<environment exclude="Development">
    @section Styles {
        <link href="~/assets/bundles/employee/css/employee-management.min.css" rel="stylesheet" />
    }
</environment>

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li class="active">@ViewLang.EmployeeList</li>
</ol>
<form class="search-form">
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control company" id="companyMultiSelect"></select>
        @*<select class="control company" asp-for="CompanyId" asp-items="@Model.Companies">
                <option value="0">@ViewLang.All</option>
            </select>*@
    </div>
    <div class="group">
        <label class="text">@ViewLang.InService</label>
        <select class="control service" asp-for="InService" asp-items="Html.GetEnumSelectList<Selection>()"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.InProbation</label>
        <select class="control probation" asp-for="InProbation" asp-items="Html.GetEnumSelectList<Selection>()"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Employee</label>
        <input type="text" class="control employee" placeholder="Full name or Nick name">
    </div>
    <button type="submit" class="button -primary">@ViewLang.Submit</button>
</form>
<div class="top-header">
    <div class="pull-left">
        <a asp-action="CreateEmployee" class="button -add create-user">
            <span class="icon-add"></span>
            @ViewLang.CreateNewEmployee
        </a>
    </div>
    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" />
        <span class="icon-search"></span>
    </div>
</div>
<table id="user-table" class="table table-bordered table-hover table-striped dataTable">
    <thead>
        <tr>
            <th>@ViewLang.SymbolCount</th>
            <th>@ViewLang.IDNo</th>
            <th>@ViewLang.Nickname</th>
            <th>@ViewLang.FullName</th>
            <th>@ViewLang.Company</th>
            <th>@ViewLang.Division</th>
            <th>@ViewLang.Department</th>
            <th>@ViewLang.JobTitle</th>
            <th>@ViewLang.InService</th>
            <th>@ViewLang.Probation</th>
            <th>@ViewLang.Action</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

<environment include="Development">
    @section Scripts {
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/assets/js/employee/list-employee.js"></script>
    }
</environment>
<environment exclude="Development">
    <script src="~/assets/bundles/employee/js/list-employee.min.js"></script>
</environment>