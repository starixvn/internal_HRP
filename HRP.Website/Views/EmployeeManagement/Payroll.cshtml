@using HRP.Resources;
@using HRP.Core.Enumerations
@using HRP.Models.EmployeeManagement.Payroll
@model EmployeePayrollViewModel

@section Styles {
<environment include="Development">
    <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
    <link href="~/lib/tooltipster/dist/css/tooltipster.bundle.css" rel="stylesheet" />
    <link href="~/lib/tooltipster/dist/css/plugins/tooltipster/sideTip/themes/tooltipster-sideTip-light.min.css" rel="stylesheet" />
    <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/common.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/payroll.css" rel="stylesheet" />
</environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/employee/css/payroll.min.css" rel="stylesheet" />
    </environment>
}

@{
    var currencySelectList = new SelectList(Model.Currencies.OrderBy(x => x.CurrencyCode), "CurrencyCode", "CurrencyCode");
    var bankTypes = Html.GetEnumSelectList<BankType>().Where(x => int.Parse(x.Value) != (int)BankType.Ebanking);
}

<!--Modals section-->
<div id="dynamic-modals">

</div>

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-action="Index" asp-controller="EmployeeManagement">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewLang.EditEmployeePayroll @Model.Code - @Model.FullName - @Model.Nickname</li>
</ol>

<div class="tooltip-templates hidden">
    <div id="tooltip-content">
        <div>@ViewLang.SelectAutoCalculatedAmount</div>
        <label>
            <input type="checkbox"><span class="label-text">@ViewLang.DontShowAgain</span>
        </label>
    </div>
</div>

@foreach (var currency in Model.CurrencyExchangeRates)
{
    <input type="hidden" data-from-currency="@currency.FromCurrency" data-to-currency="@currency.ToCurrency" value="@currency.ExchangeRate" />
}

<input type="hidden" id="get-bank-acount-url" value="@Url.Action("GetEmployeeBankAccounts", "BankAccount")" />
<input type="hidden" id="create-bank-account-in-payroll-url" value="@Url.Action("CreateBankAccountInPayroll","BankAccount")"/>
<input type="hidden" id="greater-than-zero-message" value="@Message.GreaterThanZero" />
<form class="payroll form-information" method="post" id="payroll-form" asp-action="EditPayroll"
      data-ajax-method="post" data-ajax="true" data-ajax-begin="employeePayroll.onSaveBegin" data-ajax-failure="commonFunctions.handleAjaxError"
      data-ajax-success="employeePayroll.onSaveSuccess" data-ajax-complete="employeePayroll.onSaveComplete">
    <input type="hidden" asp-for="EmployeeId" />
    <input type="hidden" asp-for="CompanyId" />
    <input type="hidden" asp-for="BasicSalary.EmployeeId" />
    <input type="hidden" asp-for="BasicSalary.OldSalary" />
    <input type="hidden" asp-for="BasicSalary.OldCurrencyCode" />
    <input type="hidden" asp-for="Allowance.EmployeeId" />
    <input type="hidden" asp-for="CanUpdate" />
    <input type="hidden" asp-for="CanCreateBankAccount" />
    <input type="hidden" asp-for="BasicSalary.InitFirstTime" />

    <div class="list-message-error hidden" id="validation-summary">
    </div>

    <div class="-has-icon msg-success hidden">
        @Message.UpdateEmployeePayrollSuccessfully
    </div>

    <div class="-has-icon msg-error hidden">
    </div>

    <div class="form-content">
        <!-- Basic Salary -->
        <div class="group-complex -payroll-layout1">
            <div class="">
                <div class="group-title -first"><span class="icon-group"></span>@ViewLang.BasicSalary</div>
                <label class="actual">@ViewLang.Actual</label>
            </div>
            <div class="currency-amount">
                <select class="control without-label basic-salary-calculate select2" asp-for="BasicSalary.CurrencyCode" asp-items="currencySelectList" data-old-value="@Model.BasicSalary.CurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control without-label number total-amount basic-salary-calculate" placeholder="Total Amount" asp-for="BasicSalary.Salary" data-old-value="@Model.BasicSalary.Salary" />
            </div>
            <div class="">
                <div class="pull-left calendar">
                    <label class="text" for="effectiveDate">@ViewLang.EffectiveDate</label>
                    <input type="text" class="control" asp-for="BasicSalary.EffectiveDate" data-msg-required="@Message.EmployeePayrollEffectiveDateRequired" />
                    <span class="icon-calendar"></span>
                </div>
                <div class="pull-right reason">
                    <label class="text" for="reason">@ViewLang.Reason</label>
                    <select class="control select2" asp-for="BasicSalary.ReasonId" asp-items="@(new SelectList(Model.ChangeReasons, "ResourceId", "Value"))" data-msg-required="@Message.EmployeePayrollReasonRequired">
                        <option></option>
                    </select>
                </div>
            </div>
            <div class="padding-top-24">
                <span>@ViewLang.StandardWorkingDays</span>
                <label class="days">
                    <input type="radio" value="22" asp-for="BasicSalary.WorkingDays">
                    <span>22</span>
                </label>
                <label class="days">
                    <input type="radio" value="26" asp-for="BasicSalary.WorkingDays">
                    <span>26</span>
                </label>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <div class="start-4">
                <div class="transaction-title">@ViewLang.PaymentTransaction</div>
                <div class="transaction-item">
                    <span>@ViewLang.BankType</span>
                    <span>@ViewLang.AccountName</span>
                </div>
            </div>
        </div>

        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="Ebanking" />
                <span>e-Banking</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-ebanking select2" asp-for="BasicSalary.EbankingCurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-ebanking" asp-for="BasicSalary.EbankingAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">e-Banking</label>
                <select class="control bank-type-select hidden">
                    <option value="@((int)BankType.Ebanking)" selected></option>
                </select>
                <select class="control select2-ajax basic-salary-ebanking bank-account-select" asp-for="BasicSalary.EbankingAccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.EbankingAccountId">@Model.BasicSalary.EbankingAccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="DirectBanking1" />
                <span>@ViewLang.DirectBanking1</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking1 select2" asp-for="BasicSalary.DirectBanking1CurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <select class="control bank-type-select basic-salary-directbanking1 select2" asp-for="BasicSalary.DirectBanking1BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried" asp-items="bankTypes">
                    <option></option>
                </select>
                <select class="control select2-ajax bank-account-select basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.DirectBanking1AccountId">@Model.BasicSalary.DirectBanking1AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="DirectBanking2" />
                <span>@ViewLang.DirectBanking2</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking2 select2" asp-for="BasicSalary.DirectBanking2CurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-directbanking2" asp-for="BasicSalary.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <select class="control bank-type-select basic-salary-directbanking2 select2" asp-for="BasicSalary.DirectBanking2BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried" asp-items="bankTypes">
                    <option></option>
                </select>
                <select class="control select2-ajax bank-account-select basic-salary-directbanking2" asp-for="BasicSalary.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.DirectBanking2AccountId">@Model.BasicSalary.DirectBanking2AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="Cash" />
                <span>@ViewLang.Cash</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-cash select2" asp-for="BasicSalary.CashCurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-cash" asp-for="BasicSalary.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">@ViewLang.Cash</label>
                <select class="control basic-salary-cash bank-account-select select2" asp-for="BasicSalary.CashAccountId" asp-items="@(new SelectList(Model.CashAccounts, "ResourceId", "Value"))" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option></option>
                </select>
            </div>
        </div>
        <hr />
        <!-- Allowances -->
        <div class="group-complex -payroll-layout3">
            <div class="group-title -first"><span class="icon-group"></span>@ViewLang.Allowances</div>
            <div class="conversion start-3">@ViewLang.Conversion</div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="actual">@ViewLang.Actual</div>
            <div class="currency-amount start-3">
                <select class="control select2" asp-items="currencySelectList" asp-for="Allowance.CurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control total-amount" readonly name="AllowanceTotal" id="allowance-total-amount" />
            </div>
            <div class="transaction-item -allowances">
                <span>@ViewLang.BankType</span>
                <span>@ViewLang.AccountName</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="DirectBanking1" />
                <span>@ViewLang.DirectBanking1</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking1 select2" asp-items="currencySelectList" asp-for="Allowance.DirectBanking1CurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking1" asp-for="Allowance.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <select class="control bank-type-select allowance-directbanking1 select2" asp-items="bankTypes" asp-for="Allowance.DirectBanking1BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried">
                    <option></option>
                </select>
                <select class="control select2-ajax bank-account-select allowance-directbanking1" asp-for="Allowance.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.Allowance.DirectBanking1AccountId">@Model.Allowance.DirectBanking1AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="DirectBanking2" />
                <span>@ViewLang.DirectBanking2</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking2 select2" asp-items="currencySelectList" asp-for="Allowance.DirectBanking2CurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking2" asp-for="Allowance.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <select class="control bank-type-select allowance-directbanking2 select2" asp-items="bankTypes" asp-for="Allowance.DirectBanking2BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried">
                    <option></option>
                </select>
                <select class="control select2-ajax bank-account-select allowance-directbanking2" asp-for="Allowance.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.Allowance.DirectBanking2AccountId">@Model.Allowance.DirectBanking2AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type tooltipster">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="Cash" />
                <span>@ViewLang.Cash</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-cash select2" asp-items="currencySelectList" asp-for="Allowance.CashCurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-cash" asp-for="Allowance.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-invalidsetting="true" data-msg-invalidsetting="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <label class="bank-type">Cash</label>
                <select class="control allowance-cash bank-account-select select2" asp-for="Allowance.CashAccountId" asp-items="@(new SelectList(Model.CashAccounts, "ResourceId", "Value"))" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option></option>
                </select>
            </div>
        </div>

        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Subsistence</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.SubsistenceCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.SubsistenceAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.HomePassage</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.HomePassageCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HomePassageAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Housing</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.HousingCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HousingAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.MobilePhone</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.MobilePhoneCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.MobilePhoneAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.HPI</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.HPICurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HPIAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
            <div class="transaction-item -allowances">
                <span class="bank-name">@ViewLang.WorkingDays</span>
                <span class="bank-name">@ViewLang.Rate</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.DutyMeal</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.DutyMealCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" readonly asp-for="Allowance.DutyMealAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
            <div class="payment-transaction -allowances">
                <input type="text" class="control number" disabled id="working-days" value="@Model.BasicSalary.WorkingDays" />
                <input type="text" class="control number" name="duty-meal-per-day" id="duty-meal-per-day" value="@(string.IsNullOrEmpty(Model.Allowance.DutyMealAmount) ? "" : (decimal.Parse(Model.Allowance.DutyMealAmount) / Model.BasicSalary.WorkingDays ).ToString())" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Secondment</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.SecondmentCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.SecondmentAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">@ViewLang.Others</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate select2" asp-items="currencySelectList" asp-for="Allowance.OthersCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.OthersAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled value="@Model.Allowance.CurrencyCode" />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <hr />
        <!-- Deductions -->
        <div class="deductions-title"><span class="icon-group"></span>@ViewLang.Deductions</div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">@ViewLang.RommingCharges</div>
            <div class="currency-amount">
                <select class="control deduction-calculate select2" asp-items="currencySelectList" asp-for="Deduction.RoomingChargesCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate" asp-for="Deduction.RoomingChargesAmount" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">@ViewLang.FitnessFirst</div>
            <div class="currency-amount">
                <select class="control deduction-calculate select2" asp-items="currencySelectList" asp-for="Deduction.FitnessFirstCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate" asp-for="Deduction.FitnessFirstAmount" />
            </div>
        </div>
        <div class="list-button">
            @if (Model.CanUpdate)
            {
                <a href="javascript:history.back()" class="button -second">@ViewLang.Cancel</a>
                <button class="button -primary" type="submit" data-loading-text="@ViewLang.Saving ..." id="btn-save">@ViewLang.Save</button>
            }
            else
            {
                <a href="javascript:history.back()" class="button -second">@ViewLang.Back</a>
            }

        </div>
    </div>
</form>

@section Scripts {
<environment include="Development">
    <script src="~/lib/bignumber.js/bignumber.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/lib/moment/moment.js"></script>
    <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
    <script src="~/lib/select2/dist/js/select2.js"></script>
    <script src="~/lib/tooltipster/dist/js/tooltipster.bundle.js"></script>
    <script type="text/javascript" src="~/assets/js/bank/bank-account-form.js" asp-append-version="true"></script>
    <script src="~/assets/js/employee/employee-payroll.js"></script>

</environment>
    <environment exclude="Development">
        <script src="~/lib/bignumber.js/bignumber.min.js"></script>
        <script src="~/assets/bundles/employee/js/employee-payroll.min.js"></script>
    </environment>
}
