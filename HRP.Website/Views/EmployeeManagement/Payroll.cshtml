@using HRP.Resources;
@using HRP.Core.Enumerations
@model HRP.Models.EmployeeManagement.EmployeePayrollViewModel

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/common.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/payroll.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/employee/css/payroll.min.css" rel="stylesheet" />
    </environment>
}

@{
    var currencySelectList = new SelectList(Model.Currencies.OrderBy(x => x.CurrencyCode), "CurrencyCode", "CurrencyCode");
    var bankTypes = Html.GetEnumSelectList<BankType>().Where(x => int.Parse(x.Value) != (int)BankType.Ebanking);
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li class="like-link">@ViewLang.EmployeeList</li>
    <li class="active">@ViewLang.EditEmployeePayroll @Model.Code - @Model.FullName - @Model.NickName</li>
</ol>

@foreach (var currency in Model.CurrencyExchangeRates)
{
    <input type="hidden" data-from-currency="@currency.FromCurrency" data-to-currency="@currency.ToCurrency" value="@currency.ExchangeRate" />
}

<input type="hidden" id="get-bank-acount-url" value="@Url.Action("GetEmployeeBankAccounts", "BankAccount")" />

<form class="payroll form-information" method="post" id="payroll-form" asp-action="SavePayroll">
    <input type="hidden" asp-for="EmployeeId" />
    <input type="hidden" asp-for="CompanyId" />
    <input type="hidden" asp-for="BasicSalary.EmployeeId" />
    <input type="hidden" asp-for="Allowance.EmployeeId" />
    <input type="hidden" asp-for="CanUpdate" />
    <div class="list-message-error hidden" id="validation-summary">
    </div>
    <div class="form-content">
        <!-- Basic Salary -->
        <div class="group-complex -payroll-layout1">
            <div class="">
                <div class="group-title -first"><span class="icon-group"></span>Basic Salary</div>
                <label class="actual">Actual</label>
            </div>
            <div class="currency-amount">
                <select class="control without-label basic-salary-calculate" asp-for="BasicSalary.CurrencyCode" asp-items="currencySelectList">
                    <option></option>
                </select>
                <input type="text" class="control without-label number total-amount basic-salary-calculate" placeholder="Total Amount" asp-for="BasicSalary.Salary" data-old-value="@Model.BasicSalary.Salary" />
            </div>
            <div class="">
                <div class="pull-left calendar">
                    <label class="text" for="effectiveDate">Effective Date</label>
                    <input type="text" class="control" asp-for="BasicSalary.EffectiveDate" data-msg-required="@Message.EmployeePayrollEffectiveDateRequired"/>
                    <span class="icon-calendar"></span>
                </div>
                <div class="pull-right reason">
                    <label class="text" for="reason">Reason</label>
                    <select class="control" asp-for="BasicSalary.ReasonId" asp-items="@(new SelectList(Model.ChangeReasons, "ResourceId", "Value"))" data-msg-required="@Message.EmployeePayrollReasonRequired">
                        <option></option>
                    </select>
                </div>
            </div>
            <div class="padding-top-24">
                <span>Standard Working Days</span>
                <label class="days">
                    <input type="radio" value="22" asp-for="BasicSalary.WorkingDays">
                    <span>22</span>
                </label>
                <label class="days">
                    <input type="radio" value="26" asp-for="BasicSalary.WorkingDays">
                    <span>26</span>
                </label>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <div class="start-4">
                <div class="transaction-title">Payment Transaction</div>
                <div class="transaction-item">
                    <span>Bank Type</span>
                    <span>Account Name</span>
                </div>
            </div>
        </div>

        <div class="group-complex -payroll-layout1">
            <label class="bank-type">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="Ebanking" />
                <span>e-Banking</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-ebanking" asp-for="BasicSalary.EbankingCurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-ebanking" asp-for="BasicSalary.EbankingAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">e-Banking</label>
                <select class="control bank-type-select hidden">
                    <option value="@((int)BankType.Ebanking)" selected></option>
                </select>
                <select class="control select2 basic-salary-ebanking" asp-for="BasicSalary.EbankingAccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.EbankingAccountId">@Model.BasicSalary.EbankingAccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="DirectBanking1" />
                <span>Direct Banking 1</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1CurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <select class="control bank-type-select basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried" asp-items="bankTypes">
                    <option></option>
                </select>
                <select class="control select2 bank-account-select basic-salary-directbanking1" asp-for="BasicSalary.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.DirectBanking1AccountId">@Model.BasicSalary.DirectBanking1AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="DirectBanking2" />
                <span>Direct Banking 2</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-directbanking2" asp-for="BasicSalary.DirectBanking2CurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate" asp-for="BasicSalary.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <select class="control bank-type-select basic-salary-directbanking2" asp-for="BasicSalary.DirectBanking2BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried" asp-items="bankTypes">
                    <option></option>
                </select>
                <select class="control select2 bank-account-select basic-salary-directbanking2" asp-for="BasicSalary.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.BasicSalary.DirectBanking2AccountId">@Model.BasicSalary.DirectBanking2AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout1">
            <label class="bank-type">
                <input type="radio" asp-for="BasicSalary.AutoCalculateOn" value="Cash" />
                <span>Cash</span>
            </label>
            <div class="currency-amount">
                <select class="control basic-salary-calculate basic-salary-cash" asp-for="BasicSalary.CashCurrencyCode" asp-items="currencySelectList" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number basic-salary-calculate basic-salary-cash" asp-for="BasicSalary.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div></div>
            <div class="payment-transaction">
                <label class="bank-type">Cash</label>
                <select class="control basic-salary-cash" asp-for="BasicSalary.CashAccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option></option>
                </select>
            </div>
        </div>
        <hr />
        <!-- Allowances -->
        <div class="group-complex -payroll-layout3">
            <div class="group-title -first"><span class="icon-group"></span>Allowances</div>
            <div class="conversion start-3">Conversion</div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="actual">Actual</div>
            <div class="currency-amount start-3">
                <select class="control" asp-items="currencySelectList" asp-for="Allowance.CurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control total-amount" readonly name="AllowanceTotal" id="allowance-total-amount" />
            </div>
            <div class="transaction-item -allowances">
                <span>Bank Type</span>
                <span>Account Name</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="DirectBanking1" />
                <span>Direct Banking 1</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking1" asp-items="currencySelectList" asp-for="Allowance.DirectBanking1CurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking1" asp-for="Allowance.DirectBanking1Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <select class="control bank-type-select allowance-directbanking1" asp-items="bankTypes" asp-for="Allowance.DirectBanking1BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried">
                    <option></option>
                </select>
                <select class="control select2 bank-account-select allowance-directbanking1" asp-for="Allowance.DirectBanking1AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.Allowance.DirectBanking1AccountId">@Model.Allowance.DirectBanking1AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="DirectBanking2" />
                <span>Direct Banking 2</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-directbanking2" asp-items="currencySelectList" asp-for="Allowance.DirectBanking2CurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-directbanking2" asp-for="Allowance.DirectBanking2Amount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <select class="control bank-type-select allowance-directbanking2" asp-items="bankTypes" asp-for="Allowance.DirectBanking2BankTypeId" data-msg-required="@Message.EmployeePayrollBankTypeRequried">
                    <option></option>
                </select>
                <select class="control select2 bank-account-select allowance-directbanking2" asp-for="Allowance.DirectBanking2AccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option value="@Model.Allowance.DirectBanking2AccountId">@Model.Allowance.DirectBanking2AccountName</option>
                </select>
                <span class="add-account"></span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <label class="bank-type">
                <input type="radio" asp-for="Allowance.AutoCalculateOn" value="Cash" />
                <span>Cash</span>
            </label>
            <div></div>
            <div class="currency-amount start-3">
                <select class="control allowance-calculate allowance-cash" asp-items="currencySelectList" asp-for="Allowance.CashCurrencyCode" data-msg-required="@Message.EmployeePayrollCurrencyRequried">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-calculate allowance-cash" asp-for="Allowance.CashAmount" data-msg-required="@Message.EmployeePayrollSettingAmountRequried"
                       data-rule-greaterthanzero="true" data-msg-greaterthanzero="@Message.EmployeePayroll_InvalidSetting" />
            </div>
            <div class="payment-transaction -allowances">
                <label class="bank-type">Cash</label>
                <select class="control allowance-cash" asp-for="Allowance.CashAccountId" data-msg-required="@Message.EmployeePayrollAccountRequried">
                    <option></option>
                </select>
            </div>
        </div>

        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">Subsistence</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.SubsistenceCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.SubsistenceAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">Home Passage</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.HomePassageCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HomePassageAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">Housing</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.HousingCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HousingAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">Mobile Phone</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.MobilePhoneCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.MobilePhoneAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">HPI</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.HPICurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.HPIAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
            <div class="transaction-item -allowances">
                <span class="bank-name">Working Days</span>
                <span class="bank-name">Rate</span>
            </div>
        </div>
        <div class="group-complex -payroll-layout3 allowance-detail">
            <div class="align-text">Duty Meal</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.DutyMealCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" readonly asp-for="Allowance.DutyMealAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
            <div class="payment-transaction -allowances">
                <input type="text" class="control number" disabled id="working-days" value="@Model.BasicSalary.WorkingDays" />
                <input type="text" class="control number" name="duty-meal-per-day" id="duty-meal-per-day" value="@(string.IsNullOrEmpty(Model.Allowance.DutyMealAmount) ? "" : (decimal.Parse(Model.Allowance.DutyMealAmount) / Model.BasicSalary.WorkingDays ).ToString())" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">Secondment</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.SecondmentCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.SecondmentAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">Others</div>
            <div class="currency-amount">
                <select class="control allowance-detail-calculate" asp-items="currencySelectList" asp-for="Allowance.OthersCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number allowance-detail-calculate" asp-for="Allowance.OthersAmount" />
            </div>
            <div class="currency-amount">
                <input type="text" class="control allowance-total-currency" disabled />
                <input type="text" class="control number allowance-convert-amount" disabled />
            </div>
        </div>
        <hr />
        <!-- Deductions -->
        <div class="deductions-title"><span class="icon-group"></span>Deductions</div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">Romming Charges</div>
            <div class="currency-amount">
                <select class="control deduction-calculate" asp-items="currencySelectList" asp-for="Deduction.RoomingChargesCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate" asp-for="Deduction.RoomingChargesAmount" />
            </div>
        </div>
        <div class="group-complex -payroll-layout3">
            <div class="align-text">Fitness First</div>
            <div class="currency-amount">
                <select class="control deduction-calculate" asp-items="currencySelectList" asp-for="Deduction.FitnessFirstCurrencyCode">
                    <option></option>
                </select>
                <input type="text" class="control number deduction-calculate" asp-for="Deduction.FitnessFirstAmount" />
            </div>
        </div>
        <div class="list-button">
            @if (Model.CanUpdate)
            {
                 <a asp-action="Index" class="button -second">@ViewLang.Cancel</a>
                <button class="button -primary">@ViewLang.Save</button>
            }
            else
            {
                <a asp-action="Index" class="button -second">@ViewLang.Back</a>
            }

        </div>
    </div>
</form>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/assets/js/employee/employee-payroll.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/employee/js/employee-payroll.min.js"></script>
    </environment>
}
