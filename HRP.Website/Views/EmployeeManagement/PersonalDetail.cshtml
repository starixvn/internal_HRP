@using HRP.Models.EmployeeManagement
@using HRP.Resources
@model CreateEmployeeViewModel
@{
    ViewData["Title"] = "Personal Detail";
}
@section Styles {
    <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
    <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
    <link href="~/assets/bundles/employee/css/employee-management.min.css" rel="stylesheet" />
}

<ol class="breadcrumb">
    <li class="like-link">Empoloyee Management</li>
    <li><a href="/employeemanagement">Employee List</a></li>
    <li class="active">Create New Employee</li>
</ol>
<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#personalDetail" aria-controls="home" role="tab" data-toggle="tab">Personal Detail</a>
    </li>
    <li role="presentation">
        <a href="#tab-employment" aria-controls="profile" role="tab" data-toggle="tab"
           id="tab-header-employment" data-isFirstLoad="true">Employment</a>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane form-information active" id="personalDetail">
        <form class="personal-detail" enctype="multipart/form-data" method="post" asp-action="CreateEmployee" asp-controller="EmployeeManagement" id="personalDetailForm">
            <figure class="profile">
                <input type="file" accept="image/*" style="display:none" asp-for="ProfilePicture" />
                <img src="~/assets/styles/images/profile.png" width="159" height="161" alt="Profile picture" class="js-displayProfilePicture">
                <figcaption class="change-picture">
                    <a href="#" class="js-changePicture">@ViewLang.ChangePicture</a>
                </figcaption>
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </figure>
            <div class="col has-space">
                <label class="text -has-required">@ViewLang.FullNameSpacing</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="FullName">
                </div>
                <label class="text -has-required">@ViewLang.NickNameSpacing</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="NickName">
                </div>
                <div class="group-complex -per-layout1">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.Gender</label>
                        <select class="control" asp-for="Gender" asp-items="@Model.GenderList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required">@ViewLang.DateOfBirth</label>
                        <input type="text" class="control" asp-for="DateOfBirth">
                        <span class="icon-calendar js-iconDateOfBirth"></span>
                    </div>
                    <div class="component">
                        <label class="text">@ViewLang.PlaceOfBirth</label>
                        <input type="text" class="control" asp-for="PlaceOfBirth">
                    </div>
                </div>
                <div class="group-complex -per-layout2">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.Nationality</label>
                        <select class="control" asp-for="Nationality" asp-items="@Model.NationalityList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component">
                        <label class="text -has-required">@ViewLang.NRICNo</label>
                        <input type="text" class="control" asp-for="NRICNo">
                    </div>
                </div>
                <div class="group-complex -per-layout3">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.MaritalStatus</label>
                        <select class="control" asp-for="MaritalStatus" asp-items="@Model.MaritalStatusList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component">
                        <label class="text -has-required">@ViewLang.NoOfChildren</label>
                        <select class="control" asp-for="NoOfChildren" asp-items="@Model.NoOfChildrenList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                </div>

                <div class="group-title"><span class="icon-group"></span>@ViewLang.Telephone</div>
                <div class="group-complex -per-layout4">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.OverseasNo</label>
                        <input type="text" class="control" asp-for="OverseasPhoneNo">
                    </div>
                    <div class="component">
                        <label class="text">@ViewLang.LocalNo</label>
                        <input type="text" class="control" asp-for="LocalPhoneNo">
                    </div>
                </div>
                <label class="text">@ViewLang.Other</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="OtherPhoneNo">
                </div>

                <div class="group-title"><span class="icon-group"></span>@ViewLang.Passport</div>
                <div class="group-complex -per-layout5">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.PassportNo</label>
                        <input type="text" class="control" asp-for="PassportNo">
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required">@ViewLang.DateIssue</label>
                        <input type="text" class="control" asp-for="DateIssue">
                        <span class="icon-calendar js-iconDateIssue"></span>
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required">@ViewLang.ExpiredDate</label>
                        <input type="text" class="control" asp-for="ExpiredDate">
                        <span class="icon-calendar js-iconExpiredDate"></span>
                    </div>
                </div>
                <label class="text">@ViewLang.PlaceOfIssue</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="PlaceOfIssue">
                </div>
            </div>
            <div class="col">
                <label class="text">@ViewLang.SkypeAccount</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="Skype">
                </div>
                <label class="text">@ViewLang.PersonalEmailAddress</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="PersonalEmail">
                </div>
                <label class="text -has-required">@ViewLang.PermanentAddress</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="PermanentAddress">
                </div>
                <label class="text -has-required">@ViewLang.ResidenceAddress</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ResidenceAddress">
                </div>
                <label class="text">@ViewLang.MailingAddress</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="MailingAddress">
                </div>

                <div class="group-title"><span class="icon-group"></span>@ViewLang.EmergencyContact</div>
                <label class="text -has-required">@ViewLang.Name</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ECName">
                </div>
                <label class="text -has-required">@ViewLang.Relationship</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ECRelationship">
                </div>
                <label class="text -has-required">@ViewLang.Address</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ECAddress">
                </div>
                <label class="text -has-required">@ViewLang.TelephoneNo</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ECTelephoneNo">
                </div>
                <label class="text">@ViewLang.TelephoneNo</label>
                <div class="group-control">
                    <input type="text" class="control" asp-for="ECTelephoneNo2">
                </div>
            </div>
            <div class="list-button">
                <button class="button -second">@ViewLang.Cancel</button>
                <button class="button -primary" type="submit">@ViewLang.Save</button>
            </div>
            <span asp-validation-for="FullName" class="text-danger"></span>
            <span asp-validation-for="NickName" class="text-danger"></span>
            <span asp-validation-for="Gender" class="text-danger"></span>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
            <span asp-validation-for="Nationality" class="text-danger"></span>
            <span asp-validation-for="NRICNo" class="text-danger"></span>
            <span asp-validation-for="MaritalStatus" class="text-danger"></span>
            <span asp-validation-for="NoOfChildren" class="text-danger"></span>
            <span asp-validation-for="OverseasPhoneNo" class="text-danger"></span>
            <span asp-validation-for="LocalPhoneNo" class="text-danger"></span>
            <span asp-validation-for="OtherPhoneNo" class="text-danger"></span>
            <span asp-validation-for="PassportNo" class="text-danger"></span>
            <span asp-validation-for="DateIssue" class="text-danger"></span>
            <span asp-validation-for="ExpiredDate" class="text-danger"></span>
            <span asp-validation-for="PlaceOfIssue" class="text-danger"></span>
            <span asp-validation-for="Skype" class="text-danger"></span>
            <span asp-validation-for="PersonalEmail" class="text-danger"></span>
            <span asp-validation-for="PermanentAddress" class="text-danger"></span>
            <span asp-validation-for="ResidenceAddress" class="text-danger"></span>
            <span asp-validation-for="MailingAddress" class="text-danger"></span>
            <span asp-validation-for="ECName" class="text-danger"></span>
            <span asp-validation-for="ECRelationship" class="text-danger"></span>
            <span asp-validation-for="ECAddress" class="text-danger"></span>
            <span asp-validation-for="ECTelephoneNo" class="text-danger"></span>
            <span asp-validation-for="ECTelephoneNo2" class="text-danger"></span>
        </form>
    </div>
    <div role="tabpanel" class="tab-pane" id="tab-employment"></div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/assets/js/employee/create-employee.js"></script>
        <script src="~/assets/js/employee/create-employment.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/employee/js/create-employee.min.js"></script>
    </environment>
}