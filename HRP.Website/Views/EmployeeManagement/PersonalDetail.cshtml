@using HRP.Models.EmployeeManagement
@using HRP.Resources
@model CreateEmployeeViewModel
@{
    ViewData["Title"] = "Personal Detail";
}
@section Styles {
    <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
    <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
    <link href="~/assets/bundles/employee/css/employee-management.min.css" rel="stylesheet" />
}

<ol class="breadcrumb">
    <li class="like-link">Empoloyee Management</li>
    <li><a href="/employeemanagement">Employee List</a></li>
    <li class="active">Create New Employee</li>
</ol>
<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#personalDetail" aria-controls="home" role="tab" data-toggle="tab">Personal Detail</a>
    </li>
    <li role="presentation">
        <a href="#tab-employment" aria-controls="profile" role="tab" data-toggle="tab"
           id="tab-header-employment" data-isFirstLoad="true">Employment</a>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane form-information active" id="personalDetail">
        <form class="personal-detail" enctype="multipart/form-data" method="post" asp-action="CreateEmployee" asp-controller="EmployeeManagement" id="personalDetailForm">
            <figure class="profile">
                <input type="file" accept="image/*" style="display:none" asp-for="ProfilePicture" />
                <img src="~/assets/styles/images/profile.png" width="159" height="161" alt="Profile picture" class="js-displayProfilePicture">
                <figcaption class="change-picture">
                    <a href="#" class="js-changePicture">@ViewLang.ChangePicture</a>
                </figcaption>
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </figure>
            <div class="col has-space">
                <label class="text -has-required">@ViewLang.FullNameSpacing</label>
                <div class="group-control">
                    <input type="text" class="control" id="FullName" asp-for="FullName">
                </div>
                <label class="text -has-required" for="NickName">@ViewLang.NickNameSpacing</label>
                <div class="group-control">
                    <input type="text" class="control" id="NickName" asp-for="NickName">
                </div>
                <div class="group-complex -per-layout1">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.Gender</label>
                        <select class="control" asp-for="Gender" asp-items="@Model.GenderList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required">@ViewLang.Date</label>
                        <input type="text" class="control " id="Date">
                        <span class="icon-calendar"></span>
                    </div>
                    <div class="component">
                        <label class="text">@ViewLang.PlaceOfBirth</label>
                        <input type="text" class="control" id="PlaceOfBirth">
                    </div>
                </div>
                <div class="group-complex -per-layout2">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.Nationality</label>
                        <select class="control" asp-for="Nationality" asp-items="@Model.NationalityList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component">
                        <label class="text -has-required" for="NRIC">NRIC No.</label>
                        <input type="text" class="control " id="NRIC">
                    </div>
                </div>
                <div class="group-complex -per-layout3">
                    <div class="component">
                        <label class="text -has-required">@ViewLang.MaritalStatus</label>
                        <select class="control" asp-for="MaritalStatus" asp-items="@Model.MaritalStatusList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                    <div class="component">
                        <label class="text -has-required">@ViewLang.NoOfChildren</label>
                        <select class="control" asp-for="NoOfChildren" asp-items="@Model.NoOfChildrenList">
                            <option value="">--Please select--</option>
                        </select>
                    </div>
                </div>

                <div class="group-title"><span class="icon-group"></span>Telephone</div>
                <div class="group-complex -per-layout4">
                    <div class="component">
                        <label class="text -has-required" for="OverseasNo">Overseas No.</label>
                        <input type="text" class="control" id="OverseasNo">
                    </div>
                    <div class="component">
                        <label class="text" for="LocalNo">Local No.</label>
                        <input type="text" class="control" id="LocalNo">
                    </div>
                </div>
                <label class="text" for="Other">Other</label>
                <div class="group-control">
                    <input type="text" class="control" id="Other">
                </div>

                <div class="group-title"><span class="icon-group"></span>Passport</div>
                <div class="group-complex -per-layout5">
                    <div class="component">
                        <label class="text -has-required" for="PassportNo">Passport No.</label>
                        <input type="text" class="control" id="PassportNo">
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required" for="DateIssue">Date Issue</label>
                        <input type="text" class="control" id="DateIssue">
                        <span class="icon-calendar"></span>
                    </div>
                    <div class="component calendar">
                        <label class="text -has-required" for="DateIssue">Expired Issue</label>
                        <input type="text" class="control" id="DateIssue">
                        <span class="icon-calendar"></span>
                    </div>
                </div>
                <label class="text" for="PlaceIssue">Place of Issue</label>
                <div class="group-control">
                    <input type="text" class="control" id="PlaceIssue">
                </div>
            </div>
            <div class="col">
                <label class="text" for="SkypeAccount">Skype Account</label>
                <div class="group-control">
                    <input type="text" class="control" id="SkypeAccount">
                </div>
                <label class="text" for="Email">Personal Email Address</label>
                <div class="group-control">
                    <input type="text" class="control" id="Email">
                </div>
                <label class="text -has-required" for="PermanentAddress">Permanent Address (Overseas)</label>
                <div class="group-control">
                    <input type="text" class="control" id="PermanentAddress">
                </div>
                <label class="text -has-required" for="ResidenceAddress">Residence Address (Local)</label>
                <div class="group-control">
                    <input type="text" class="control" id="ResidenceAddress">
                </div>
                <label class="text" for="MailingAddress">Mailing Address</label>
                <div class="group-control">
                    <input type="text" class="control" id="MailingAddress">
                </div>

                <div class="group-title"><span class="icon-group"></span>Emergency Contact</div>
                <label class="text -has-required" for="EmergencyName">Name</label>
                <div class="group-control">
                    <input type="text" class="control" id="ContactName">
                </div>
                <label class="text -has-required" for="Relationship">Relationship</label>
                <div class="group-control">
                    <input type="text" class="control" id="Relationship">
                </div>
                <label class="text -has-required" for="EmergencyAddress">Address</label>
                <div class="group-control">
                    <input type="text" class="control" id="">
                </div>
                <label class="text -has-required" for="EmergencyTelephone">Telephone No.</label>
                <div class="group-control">
                    <input type="text" class="control" id="EmergencyTelephone">
                </div>
                <label class="text" for="EmergencyTelephone2">Telephone No.</label>
                <div class="group-control">
                    <input type="text" class="control" id="EmergencyTelephone2">
                </div>
            </div>
            <div class="list-button">
                <button class="button -second">Cancel</button>
                <button class="button -primary" type="submit">Save</button>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
        </form>
    </div>
    <div role="tabpanel" class="tab-pane" id="tab-employment"></div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/assets/js/employee/create-employee.js"></script>
        <script src="~/assets/js/employee/create-employment.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/employee/js/create-employee.min.js"></script>
    </environment>
}