@using HRP.Models.DataConfiguration
@using HRP.Resources
@model UpdateSimpleItemViewModel

<div class="modal-header">
    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
    <h4 class="modal-title" id="modalUpdateLabel">@Message.EditItem</h4>
</div>
<div class="modal-body form-information">
    <form action="@Model.LinkUpdateItem" method="post" asp-antiforgery="true" id="editItemForm"
          data-ajax-method="post" data-ajax="true" data-ajax-success="dataConfiguration.onUpdateItemSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
        <input asp-for="Item.ItemId" type="hidden" />
        <div class="list-message-error hidden">
            <span class="message" asp-validation-for="Item.ItemName"></span>
            <span class="message" asp-validation-for="Item.Description"></span>
        </div>
        <div class="-has-icon msg-error hidden" id="update-item-error-alert">
        </div>
        <label class="text -has-required">@Model.FieldName</label>
        <div class="group-control">
            <input class="control js-itemName" type="text" asp-for="Item.ItemName"
                   data-val-required="@string.Format(Message.ItemNameRequired, Model.FieldName)"
                   data-val-length="@string.Format(Message.ItemNameMaxLength, Model.FieldName, 50)" />
        </div>
        <label class="text">@ViewLang.Description</label>
        <div class="group-control">
            <input class="control" type="text" asp-for="Item.Description" />
        </div>
        <div class="group-control">
            <label>
                <input type="checkbox" asp-for="Item.IsActive" />
                <span>@ViewLang.Active</span>
            </label>
        </div>
        <div class="list-button">
            <button class="button -primary" type="submit">@ViewLang.Save</button>
            <button class="button -second" type="button" data-dismiss="modal">@ViewLang.Cancel</button>
        </div>
    </form>
</div>