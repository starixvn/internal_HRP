@using HRP.Models.DataConfiguration.Office
@using HRP.Resources

@model UpdateOfficeViewModel

<div class="modal-header">
    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
    <h4 class="modal-title">@Message.EditItem</h4>
</div>
<div class="modal-body form-information">
    <form id="editItemForm" action="@Model.Field.LinkUpdateItem" method="post" asp-antiforgery="true"
          data-ajax-method="post" data-ajax="true" data-ajax-success="dataConfiguration.onUpdateItemSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
        <div class="list-message-error hidden">
            <span class="message" asp-validation-for="Office.Code"></span>
            <span class="message" asp-validation-for="Office.Name"></span>
        </div>
        <div class="-has-border msg-error hidden" id="create-item-error-alert">
        </div>
        <input asp-for="Office.OfficeId" type="hidden" />

        <label class="text -has-required">@ViewLang.Country</label>
        <div class="group-control">
            <select class="control" disabled>
                <option value="@Model.Office.CountryId">@Model.Office.CountryCode</option>
            </select>
        </div>

        <label class="text -has-required">@ViewLang.City</label>
        <div class="group-control">
            <select class="control" disabled>
                <option value="@Model.Office.CityId">@Model.Office.CityCode</option>
            </select>
        </div>

        <label class="text -has-required">@Model.Field.FieldName</label>
        <div class="group-control">
            <input class="control js-itemName" type="text" asp-for="Office.Code"
                   data-val-required="@string.Format(Message.ItemNameRequired, Model.Field.FieldName)"
                   data-val-length="@string.Format(Message.ItemNameMaxLength, Model.Field.FieldName, 50)" />
        </div>

        <label class="text">@ViewLang.Description</label>
        <div class="group-control">
            <input class="control" type="text" asp-for="Office.Name" />
        </div>

        <div class="group-control">
            <label>
                <input type="checkbox" asp-for="Office.IsActive" />
                <span>@ViewLang.Active</span>
            </label>
        </div>
        <div class="list-button">
            <button class="button -primary" type="submit">@ViewLang.Save</button>
            <button class="button -second" type="button" data-dismiss="modal">@ViewLang.Cancel</button>
        </div>
    </form>
</div>