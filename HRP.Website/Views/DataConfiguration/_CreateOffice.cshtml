@using HRP.Models.DataConfiguration.Office
@using HRP.Resources

@model CreateOfficeViewModel

<div class="modal-header">
    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
    <h4 class="modal-title">@string.Format(Message.NewItemOf, Model.FieldName)</h4>
</div>
<div class="modal-body form-information">
    <form id="createItemForm" action="@Model.LinkCreateItem" method="post" asp-antiforgery="true"
          data-ajax-method="post" data-ajax="true" data-ajax-success="dataConfiguration.onCreateNewItemSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
        <div class="list-message-error hidden">
            <span class="message" asp-validation-for="Office.CountryId"></span>
            <span class="message" asp-validation-for="Office.CityId"></span>
            <span class="message" asp-validation-for="Office.Code"></span>
            <span class="message" asp-validation-for="Office.Name"></span>
        </div>
        <div class="-has-icon msg-error hidden" id="create-item-error-alert">
        </div>

        <label class="text -has-required">@ViewLang.Country</label>
        <div class="group-control">
            <select class="control js-select2-hide-searchbox js-countryId" asp-for="Office.CountryId" asp-items="@Model.CountryList"
                    data-val-required="@string.Format(Message.ItemNameRequired,ViewLang.Country)">
                <option value=""></option>
            </select>
        </div>

        <label class="text -has-required">@ViewLang.City</label>
        <div class="group-control">
            <select class="control js-cityId" asp-for="Office.CityId"
                    data-val-required="@string.Format(Message.ItemNameRequired,ViewLang.City)">
                <option value=""></option>
            </select>
        </div>

        <label class="text -has-required">@Model.FieldName</label>
        <div class="group-control">
            <input class="control js-itemName" type="text" asp-for="Office.Code"
                   data-val-required="@string.Format(Message.ItemNameRequired, Model.FieldName)"
                   data-val-length="@string.Format(Message.ItemNameMaxLength, Model.FieldName, 50)" />
        </div>

        <label class="text">@ViewLang.Description</label>
        <div class="group-control">
            <input class="control" type="text" asp-for="Office.Name" />
        </div>

        <div class="group-control">
            <label>
                <input type="checkbox" asp-for="Office.IsActive" />
                <span>@ViewLang.Active</span>
            </label>
        </div>
        <div class="list-button">
            <button class="button -primary" type="submit">@ViewLang.Save</button>
            <button class="button -second" type="button" data-dismiss="modal">@ViewLang.Cancel</button>
        </div>
    </form>
</div>