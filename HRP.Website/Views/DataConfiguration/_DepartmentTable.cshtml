@using HRP.Resources
@using HRP.Models.DataConfiguration
@model DepartmentTableViewModel
@{
    var rowNumber = 1;
}

<div class="top-header">
    <div class="pull-left">
        @if (Model.IsHost)
        {
            <a class="button -add create-user js-createNewItem" data-url-create="@Model.Field.LinkCreateItem">
                <span class="icon-add"></span>
                @ViewLang.CreateNewItem
            </a>

        }
    </div>
    <div class="pull-right search-box">
        <input id="quickSearch" type="search" class="control" placeholder="@ViewLang.Search" />
        <span class="icon-search"></span>
    </div>
</div>

<table id="tableItems" class="table table-bordered table-hover table-responsive table-striped">
    <thead>
        <tr>
            <th class="col-number">@ViewLang.SymbolCount</th>
            <th>@Model.Field.FieldName</th>
            <th>@ViewLang.Description</th>
            <th>@ViewLang.Division</th>
            <th>@ViewLang.CompanyBVI</th>
            <th class="col-active">@ViewLang.Active</th>
            @if (Model.IsHost)
            {
                <th class="col-edit">@ViewLang.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Departments)
        {
            <tr>
                <td class="text-center">@rowNumber</td>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.DivisionCode</td>
                <td>@item.CompanyCode</td>
                <td class="text-center has-icon">
                    @if (item.IsActive)
                    {
                        <span class="icon-active"></span>
                    }
                </td>
                @if (Model.IsHost)
                {
                    <td class="text-center has-icon">
                        <span class="icon-edit js-iconEditItem" data-url-update="@Model.Field.LinkUpdateItem" data-item-id="@item.DepartmentId"></span>
                    </td>
                }
            </tr>

            rowNumber++;
        }
    </tbody>
</table>