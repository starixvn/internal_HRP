@using HRP.Models.DataConfiguration.Department
@using HRP.Resources

@model CreateDepartmentViewModel

<div class="modal-header">
    <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
    <h4 class="modal-title">@string.Format(Message.NewItemOf, Model.Field.FieldName)</h4>
</div>
<div class="modal-body form-information">
    <form id="createItemForm" action="@Model.Field.LinkCreateItem" method="post" asp-antiforgery="true"
          data-ajax-method="post" data-ajax="true" data-ajax-success="dataConfiguration.onCreateNewItemSuccess" data-ajax-failure="commonFunctions.handleAjaxError">
        <div class="list-message-error hidden">
            <span class="message" asp-validation-for="Department.CompanyId"></span>
            <span class="message" asp-validation-for="Department.DivisionId"></span>
            <span class="message" asp-validation-for="Department.Code"></span>
            <span class="message" asp-validation-for="Department.Name"></span>
        </div>
        <div class="-has-border msg-error hidden" id="create-item-error-alert"></div>

        <label class="text -has-required">@ViewLang.CompanyBVI</label>
        <div class="group-control">
            <select class="control js-companyId js-select2 js-search-suggestion" asp-for="Department.CompanyId" asp-items="@Model.CompanyList"
                    data-val-required="@string.Format(Message.ItemNameRequired,ViewLang.CompanyBVI)">
                <option value=""></option>
            </select>
        </div>

        <label class="text -has-required">@ViewLang.Division</label>
        <div class="group-control">
            <select class="control js-divisionId js-select2 js-search-suggestion" asp-for="Department.DivisionId"
                    data-val-required="@string.Format(Message.ItemNameRequired,ViewLang.Division)">
                <option value=""></option>
            </select>
        </div>

        <label class="text -has-required">@Model.Field.FieldName</label>
        <div class="group-control">
            <input class="control js-itemName" type="text" asp-for="Department.Code"
                   data-val-required="@string.Format(Message.ItemNameRequired, Model.Field.FieldName)"
                   data-val-length="@string.Format(Message.ItemNameMaxLength, Model.Field.FieldName, 50)" />
        </div>

        <label class="text">@ViewLang.Description</label>
        <div class="group-control">
            <input class="control" type="text" asp-for="Department.Name" />
        </div>

        <div class="group-control">
            <label>
                <input type="checkbox" asp-for="Department.IsActive" checked />
                <span>@ViewLang.Active</span>
            </label>
        </div>
        <div class="list-button">
            <button class="button -primary" type="submit">@ViewLang.Save</button>
            <button class="button -second" type="button" data-dismiss="modal">@ViewLang.Cancel</button>
        </div>
    </form>
</div>