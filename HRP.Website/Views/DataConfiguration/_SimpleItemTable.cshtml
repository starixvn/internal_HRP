@using HRP.Resources
@using HRP.Models.DataConfiguration
@model SimpleItemTableViewModel
@{
    var rowNumber = 1;
}

<div class="top-header">
    <div class="pull-left">
        <a class="button -add create-user" data-toggle="modal" data-target="#newItem">
            <span class="icon-add"></span>
            @ViewLang.CreateNewItem
        </a>
    </div>
    <div class="pull-right search-box">
        <input id="quickSearch" type="search" class="control" placeholder="@ViewLang.Search" />
        <span class="icon-search"></span>
    </div>
</div>

<table id="tableItems" class="table table-bordered table-hover table-responsive table-striped">
    <thead>
        <tr>
            <th>@ViewLang.SymbolCount</th>
            <th>@Model.FieldName</th>
            <th>@ViewLang.Description</th>
            <th class="col-active">@ViewLang.Active</th>
            <th class="col-edit">@ViewLang.Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@item.ItemName</td>
                <td>@item.Description</td>
                <td class="text-center has-icon">
                    @if (item.IsActive)
                    {
                        <span class="icon-active"></span>
                    }
                </td>
                <td class="text-center has-icon">
                    <span class="icon-edit" data-toggle="modal" data-target="#newChildItem"></span>
                </td>
            </tr>

            rowNumber++;
        }
    </tbody>
</table>

<!-- Create New Item -->
<div class="modal fade" id="newItem" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title" id="myModalLabel">@string.Format(Message.NewItemOf, Model.FieldName)</h4>
            </div>
            <div class="modal-body form-information">
                <label class="text -has-required">@Model.FieldName</label>
                <div class="group-control">
                    <input class="control" type="text" />
                </div>
                <label class="text">@ViewLang.Description</label>
                <div class="group-control">
                    <input class="control" type="text" />
                </div>
                <div class="group-control">
                    <label>
                        <input type="checkbox" id="showPassword" />
                        <span>@ViewLang.Active</span>
                    </label>
                </div>
                <div class="list-button">
                    <button class="button -primary">Save</button>
                    <button class="button -second" type="button">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>