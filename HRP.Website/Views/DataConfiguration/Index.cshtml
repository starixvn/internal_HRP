@using HRP.Core.Enumerations
@using HRP.Models.DataConfiguration
@using HRP.Resources

@model IEnumerable<Field>
@{
    ViewData["Title"] = "Data Configuration";
}

<environment include="Development">
    @section Styles {
        <link href="~/lib/jquery-ui/jquery-ui.css" rel="stylesheet" />
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/assets/styles/pages/configuration/data-configuration.css" asp-append-version="true" />
    }
</environment>
<environment exclude="Development">
    @section Styles {
        <link href="~/assets/bundles/configuration/css/data-configuration.min.css" rel="stylesheet" />
    }
</environment>

<ol class="breadcrumb">
    <li class="like-link">Configuration</li>
    <li class="active">Data Configuration</li>
</ol>

<form id="filterFieldForm" class="search-form">
    <div class="group">
        <label class="text">@ViewLang.Field</label>
        <select class="control" id="fieldType">
            @foreach (var field in Model)
            {
                <option value="@field.FieldId" data-url-get-all="@field.LinkGetAllItem">@field.FieldName</option>

            }
            <option value="@((int)FieldType.CompanyBVI)">@ViewLang.CompanyBVI</option>
        </select>

        <input type="hidden" id="selectedField" value="@Model.FirstOrDefault().FieldId" />
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="-has-icon msg-success hidden">
</div>

<div id="tableWrapper">
</div>

@*@foreach (var field in Model)
    {
        <input type="hidden" class="field-@(field.FieldId)" data-url-get-all="@field.LinkGetAllItem" />
    }*@

<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modalUpdateLabel" id="editItemModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title" id="modalUpdateLabel">@Message.EditItem</h4>
            </div>
            <div class="modal-body form-information" id="editItemModalBody">
            </div>
        </div>
    </div>
</div>

<!-- Section Create New Item -->
<div class="modal fade" id="newChildItem" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title" id="myModalLabel">New Item of 'Section'</h4>
            </div>
            <div class="modal-body form-information">
                <label class="text -has-required">Company</label>
                <div class="group-control">
                    <select class="control">
                        <option></option>
                    </select>
                </div>
                <label class="text -has-required">Division</label>
                <div class="group-control">
                    <select class="control">
                        <option></option>
                    </select>
                </div>
                <label class="text -has-required">Department</label>
                <div class="group-control">
                    <select class="control">
                        <option></option>
                    </select>
                </div>
                <label class="text -has-required">Cost Center</label>
                <div class="group-control">
                    <select class="control">
                        <option></option>
                    </select>
                </div>
                <label class="text -has-required">Section</label>
                <div class="group-control">
                    <input class="control" type="text" />
                </div>
                <label class="text">Description</label>
                <div class="group-control">
                    <input class="control" type="text" />
                </div>
                <div class="group-control">
                    <label>
                        <input type="checkbox" id="showPassword" />
                        <span>Active</span>
                    </label>
                </div>
                <div class="list-button">
                    <button class="button -primary">Save</button>
                    <button class="button -second" type="button">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
<environment include="Development">
    @section Scripts {
        <script src="~/lib/jquery-ui/jquery-ui.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/assets/js/configuration/data-configuration.js"></script>
    }
</environment>
<environment exclude="Development">
    <script src="~/assets/bundles/configuration/js/data-configuration.min.js"></script>
</environment>