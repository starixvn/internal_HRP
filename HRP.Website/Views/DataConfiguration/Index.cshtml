@using HRP.Models.DataConfiguration
@using HRP.Resources

@model IndexViewModel
@{
    ViewData["Title"] = "Data Configuration";
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/data-configuration/index.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/data-configuration/index.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/data-configuration/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/data-configuration/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Configuration</li>
    <li class="active">@ViewLang.DataConfiguration</li>
</ol>

<form id="filterFieldForm" class="search-form">
    <div class="group">
        <label class="text">@ViewLang.Field</label>
        <select class="control js-search-suggestion" id="FieldId">
            @foreach (var field in Model.Fields)
            {
                <option value="@field.FieldId" data-url-get-all="@field.LinkGetAllItem">@field.FieldName</option>

            }
        </select>

        <input type="hidden" id="selectedField" />
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="-has-icon msg-success hidden">
</div>

<div id="tableWrapper">
</div>

<!-- Create New Item -->
<div class="modal fade" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" id="createItemModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title" id="createItemModalContent">
        </div>
    </div>
</div>

<!-- Update Item -->
<div class="modal fade" role="dialog" aria-labelledby="modalUpdateLabel" data-backdrop="static" id="editItemModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title" id="editItemModalContent">
        </div>
    </div>
</div>