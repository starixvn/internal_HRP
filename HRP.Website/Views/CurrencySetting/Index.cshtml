@using HRP.Resources
@using HRP.Models.Currency
@model CurrencySettingViewModel

@section Styles {
    <environment include="Development">
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/datatables.net-fixedcolumns-bs/css/fixedColumns.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/configuration/currency-setting.css" rel="stylesheet" />
    </environment>

    <environment exclude="Development">
        <link href="~/assets/bundles/currency/css/currency-setting.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">Configuration</li>
    <li class="active">@ViewLang.CurrencySetting</li>
</ol>

<form class="search-form" asp-action="Index" method="get">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" asp-for="SelectedTime" data-min-month="@Model.MinMonth.ToString("yyyy-MM-dd")" />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="msg-success -has-icon hidden">
    @Message.UpdateCurrencySettingSuccessfully
</div>
<div class="msg-error -has-icon hidden"></div>

<input type="hidden" value="@Model.Currencies.FirstOrDefault()?.CurrencyId" id="base-currency" />
<input type="hidden" asp-for="CanUpdate" />

<form id="currency-form" asp-action="Edit">
    <div class="table-responsive">
        <table id="currency-table" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>@ViewLang.Currency</th>
                    @foreach (var currency in Model.Currencies)
                {
                    <th>@currency.CurrencyCode</th>
            }
                </tr>
            </thead>
            <tbody>
                @foreach (var fromCurrency in Model.Currencies)
            {
                var isDisabled = false;
                var disabled = Model.CanUpdate ? string.Empty : "disabled";
                <tr>
                    <td class="col-highlight bold">@fromCurrency.CurrencyCode</td>
                    @foreach (var toCurrency in Model.Currencies)
                {
                    var rate = Model.CurrencyExchangeRates.FirstOrDefault(x => x.FromCurrencyId == fromCurrency.CurrencyId && x.ToCurrencyId == toCurrency.CurrencyId);
                    if (Model.CanUpdate)
                    {
                        if (isDisabled || fromCurrency.CurrencyCode == "VND")
                        {
                            disabled = "disabled";
                        }

                        if (fromCurrency.CurrencyCode == "USD" && toCurrency.CurrencyCode == "VND")
                        {
                            disabled = string.Empty;
                        }
                        isDisabled = true;
                    }

                    <td>
                        <input class="input rate" @disabled type="text" value="@rate?.ExchangeRate"
                               data-from-currency="@fromCurrency.CurrencyId" data-to-currency="@toCurrency.CurrencyId"
                               name="@fromCurrency.CurrencyCode-@toCurrency.CurrencyCode"
                               data-inputmask="'alias': 'numeric', 'groupSeparator': '', 'autoGroup': true, 'digits': 5, 'digitsOptional': false, 'placeholder': '', 'allowMinus': false">
                    </td>

            }
                </tr>
        }
            </tbody>
        </table>
    </div>

</form>

@if (Model.CanUpdate)
{
    <button id="btn-save" class="button -primary">@ViewLang.Save</button>
}

@section Scripts {
    <environment include="Development">
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/datatables.net-fixedcolumns/js/dataTables.fixedColumns.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/inputmask.numeric.extensions.js"></script>
        <script src="~/lib/inputmask/dist/inputmask/jquery.inputmask.js"></script>
        <script src="~/assets/js/currency-setting.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/currency/js/currency-setting.min.js"></script>
    </environment>
}