@using HRP.Models.Report
@using HRP.Resources
@model MonthlyPayrollReportViewModel

@{
    ViewData["Title"] = $"{ViewLang.Report} - Monthly Payroll";
}
@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/report/monthly-payroll.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/report/monthly-payroll.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/report/monthly-payroll.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/report/monthly-payroll.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Report</li>
    <li class="active">@ViewLang.MonthlyPayroll</li>
</ol>

<input type="hidden" asp-for="RijndaelIV.Value" id="RijndaelIV" />
<input type="hidden" asp-for="RijndaelKey.Value" id="RijndaelKey" />

<form class="search-form" id="filterForm" asp-action="MonthlyPayroll" asp-controller="Report" method="post">
    <div class="list-message-error @(ViewData.ModelState.IsValid ? "hidden": "")" id="validation-summary">
        <span asp-validation-for="CompanyId" class="message"></span>
        <span asp-validation-for="FilePassword" class="message"></span>
        <span asp-validation-for="CommonError" class="message"></span>
    </div>

    <input type="hidden" asp-for="CommonError" />

    <input hidden asp-for="RijndaelKey.Key" />
    <input hidden asp-for="RijndaelIV.Key" />

    <div class="w-100"></div>
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" asp-for="SelectedTime" class="control datetimepicker" />
            <span class="icon-calendar"></span>
        </div>
    </div>

    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select asp-for="CompanyId" asp-items="Model.Companies" class="control js-select2-hide-searchbox"></select>
    </div>

    <div class="group">
        <label class="text">@ViewLang.Currency</label>
        <select asp-for="CurrencyId" asp-items="Model.Currencies" class="control js-select2-with-searchbox"></select>
    </div>

    <div class="group">
        <label class="text -has-required" asp-for="FilePassword"></label>
        <div class="pass-wrap"><span class="icon-view"></span><input type="password" asp-for="FilePassword" /></div>
        <input type="hidden" asp-for="EncryptedPassword" />
    </div>
    <div class="group reuse-pass-group">
        <label>
            <input class="hidden" type="checkbox" asp-for="ReusePassword" />
            <span>@ViewLang.ReusePassword</span>
        </label>
    </div>
    <div class="group">
        <button type="button" class="button -excel" id="btn-export"><span class="icon-excel"></span>@ViewLang.ExportExcel</button>
    </div>
</form>