@using HRP.Models.Report
@using HRP.Resources
@model MonthlyPayrollReportViewModel

@{
    ViewData["Title"] = $"{ViewLang.Report} - Monthly Payroll";
}
@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/employee-management.css" rel="stylesheet" />
    </environment>

    <environment exclude="Development">
        <link href="~/assets/bundles/report/css/monthly-payroll.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Report</li>
    <li class="active">@ViewLang.MonthlyPayroll</li>
</ol>

<input type="hidden" asp-for="RijndaelIV" />
<input type="hidden" asp-for="RijndaelKey" />

<form class="search-form" id="filterForm" asp-action="MonthlyPayroll" asp-controller="Report" method="post">
    <div class="list-message-error @(ViewData.ModelState.IsValid ? "hidden": "")" id="validation-summary">
        <span asp-validation-for="CompanyId" class="message"></span>
        <span asp-validation-for="FilePassword" class="message"></span>
        <span asp-validation-for="CommonError" class="message"></span>
    </div>

    <input type="hidden" asp-for="CommonError" />

    <div class="w-100"></div>
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" asp-for="SelectedTime" class="control datetimepicker" />
            <span class="icon-calendar"></span>
        </div>
    </div>

    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select asp-for="CompanyId" asp-items="Model.Companies" class="control select2"></select>
    </div>

    <div class="group">
        <label class="text -has-required" asp-for="FilePassword"></label>
        <div class="pass-wrap"><span class="icon-view"></span><input type="password" asp-for="FilePassword" /></div>
        <input type="hidden" asp-for="EncryptedPassword" />
    </div>
    <div class="group reuse-pass-group">
        <label>
            <input class="hidden" type="checkbox" asp-for="ReusePassword" />
            <span>@ViewLang.ReusePassword</span>
        </label>
    </div>
    <div class="group">
        <button type="button" class="button -primary" id="btn-export">@ViewLang.Export</button>
    </div>
</form>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/CryptoJS/aes.js"></script>
        <script src="~/assets/js/rijndael-service.js"></script>
        <script src="~/assets/js/report/monthly-payroll.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/report/js/monthly-payroll.min.js"></script>
    </environment>
}