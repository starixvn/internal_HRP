@using HRP.Core.Enumerations
@using HRP.Models.Report
@using HRP.Resources
@model BankInReportViewModel

@{
    ViewData["Title"] = $"{ViewLang.Report} - {ViewLang.DirectBanking}";
}

@section Styles {
    <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" asp-append-version="true" />
    <environment include="Development">
        <link href="~/css/dev/pages/report/direct-banking.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/report/direct-banking.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <environment include="Development">
        <script type="text/javascript" asp-append-version="true" src="~/js/jquery-validate.min.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/lib/CryptoJS/aes.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/rijndael-service.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/report/payment-transaction.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/report/js/direct-banking-report.min.js"></script>
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Report</li>
    <li class="active">@ViewLang.DirectBanking</li>
</ol>

<input type="hidden" class="encryption-iv" asp-for="RijndaelIV.Value" id="RijndaelIV" />
<input type="hidden" class="encryption-key" asp-for="RijndaelKey.Value" id="RijndaelKey" />

<form class="search-form" asp-action="GetDirectBankingReport" asp-controller="Report" method="get">
    <a asp-controller="Report" asp-action="GetDirectBankingPaymentTransactions" class="hidden" id="get-payment-transactions-url"></a>
    <input asp-for="BankType" type="hidden" id="banktype" />
    <input hidden asp-for="RijndaelKey.Key" />
    <input hidden asp-for="RijndaelIV.Key" />

    <div class="list-message-error hidden" id="validation-summary">
        <span asp-validation-for="FilePassword" class="message"></span>
    </div>

    <div class="group">
        <label asp-for="CompanyId" class="text"></label>
        <select asp-for="CompanyId" asp-items="Model.Companies" class="control js-select2"></select>
    </div>

    <div class="group">
        <label asp-for="SelectedTime" class="text"></label>
        <div class="calendar">
            <input type="text" asp-for="SelectedTime" class="control datetimepicker" />
            <span class="icon-calendar"></span>
        </div>
    </div>

    <div class="group">
        <label asp-for="TypeOfPayment" class="text"></label>
        <select asp-for="TypeOfPayment" asp-items="Html.GetEnumSelectList(typeof(PaymentType))" class="control js-select2"></select>
    </div>

    <div class="group">
        <label asp-for="SelectedPaymentTransactions" class="text"></label>
        <input type="hidden" asp-for="SelectedPaymentTransactions" id="selected-payment-transactions" />
        <select class="control company width-200" id="payment-transactions-multiselect"></select>
    </div>

    <div class="group">
        <label class="text -has-required" asp-for="FilePassword"></label>
        <div class="pass-wrap"><span class="icon-view"></span><input type="password" asp-for="FilePassword" /></div>
        <input type="hidden" asp-for="EncryptedPassword" />
    </div>
    <div class="group reuse-pass-group">
        <label>
            <input class="hidden" type="checkbox" asp-for="ReusePassword" />
            <span>@ViewLang.ReusePassword</span>
        </label>
    </div>
    <div class="group">
        <button type="button" class="button -excel" id="btn-export"><span class="icon-excel"></span>@ViewLang.ExportExcel</button>
    </div>
</form>