<ol class="breadcrumb">
    <li class="active">Report</li>
</ol>

<form class="search-form" asp-controller="payslip" asp-action="index" method="get">
     <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control js-select2" asp-for="CompanyId" asp-items="Model.Companies"></select>
    </div>
    <div class="group">
        <label class="text">Employee Status</label>
        <select class="control js-select2">
            <option>All</option>
        </select>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <label class="text blue-txt">List of Data</label>
        <select multiple>
           <optgroup label="Personal Detail">
               <option>Full Name</option>
               <option>Nickname</option>
               <option>Gender</option>
               <option>Date of Birth</option>
               <option>Place of Birth</option>
               <option>Nationality</option>
           </optgroup>
           <optgroup label="Payroll">
               <option>Basic Salary</option>
               <option>e-Banking</option>
               <option>Direct Banking 1</option>
           </optgroup>
        </select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button class="button -last-next"><span class="icon-last-next"></span></button></li>
            <li><button class="button -next"><span class="icon-next"></span></button></li>
            <li><button class="button -prev"><span class="icon-back"></span></button></li>
            <li><button class="button -last-prev"><span class="icon-last-prev"></span></button></li>
        </ul>
    </div>
    <div class="group">
        <label class="text blue-txt">Export Data</label>
        <select multiple>
               <option>Full Name</option>
               <option>Nickname</option>
               <option>Basic Salary</option>
        </select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button class="button -next"><span class="icon-up"></span></button></li>
            <li><button class="button -prev"><span class="icon-down"></span></button></li>
        </ul>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <button type="button" class="button -excel"><span class="icon-excel"></span>Export Excel</button>
    </div>
</form>


@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/assets/js/report/dynamic-report.js"></script>
    </environment>
    <environment exclude="Development">
    </environment>
}