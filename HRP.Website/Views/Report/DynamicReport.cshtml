@using HRP.Models.Report
@using HRP.Resources
@model GenerateReportViewModel

@section Styles {
    <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" asp-append-version="true" />
    <environment include="Development">
        <link href="~/css/dev/pages/report/dynamic.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/report/dynamic.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/report/dynamic.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/report/dynamic.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">Report</li>
    <li class="active">Dynamic Report</li>
</ol>

<input type="hidden" asp-for="RijndaelIV.Value" id="RijndaelIV" />
<input type="hidden" asp-for="RijndaelKey.Value" id="RijndaelKey" />

<form class="search-form" asp-controller="Report" asp-action="DynamicReport" method="post" id="dynamic-report-form">
    <input type="hidden" asp-for="EmployeeStatuses" />
    <input type="hidden" asp-for="SelectedIds" />
    <input hidden asp-for="RijndaelKey.Key" />
    <input hidden asp-for="RijndaelIV.Key" />

    <div class="list-message-error @(ViewData.ModelState.IsValid ? "hidden": "")" id="validation-summary">
        <span asp-validation-for="CompanyId" class="message"></span>
        <span asp-validation-for="EmployeeStatusIds" class="message"></span>
        <span asp-validation-for="FilePassword" class="message"></span>
    </div>

    <div class="group">
        <label class="text" asp-for="CompanyId"></label>
        <select class="control select2" asp-for="CompanyId" asp-items="Model.Companies"></select>
    </div>
    <div class="group">
        <label class="text">Employee Status</label>
        <input type="text" asp-for="EmployeeStatusIds" hidden />
        <select class="control" id="employee-status"></select>
    </div>
    <div class="group">
        <label class="text -has-required" asp-for="FilePassword"></label>
        <div class="pass-wrap"><span class="icon-view"></span><input type="password" asp-for="FilePassword" /></div>
        <input type="hidden" asp-for="EncryptedPassword" />
    </div>
    <div class="group reuse-pass-group">
        <label>
            <input class="hidden" type="checkbox" asp-for="ReusePassword" />
            <span>@ViewLang.ReusePassword</span>
        </label>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <label class="text blue-txt">List of Data</label>
        <select multiple id="select-list">
            @foreach (var group in Model.Groups)
            {
                <optgroup label="@group.Name" id="opt-@group.GroupId">
                    @foreach (var item in group.Items)
                    {
                        <option data-parent-id="#opt-@group.GroupId" value="@item.Id">@item.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button type="button" class="button -last-next" id="btn-select-all"><span class="icon-last-next"></span></button></li>
            <li><button type="button" class="button -next" id="btn-select"><span class="icon-next"></span></button></li>
            <li><button type="button" class="button -prev" id="btn-deselect"><span class="icon-back"></span></button></li>
            <li><button type="button" class="button -last-prev" id="btn-deselect-all"><span class="icon-last-prev"></span></button></li>
        </ul>
    </div>
    <div class="group">
        <label class="text blue-txt">Export Data</label>
        <select multiple id="selected-list"></select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button type="button" class="button -next" id="btn-moveup"><span class="icon-up"></span></button></li>
            <li><button type="button" class="button -prev" id="btn-movedown"><span class="icon-down"></span></button></li>
        </ul>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <button type="button" id="btn-export" class="button -excel"><span class="icon-excel"></span>@ViewLang.ExportExcel</button>
    </div>
</form>