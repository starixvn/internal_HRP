@using HRP.Models.Report
@using HRP.Resources
@model GenerateReportViewModel

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" />
        <link href="~/assets/styles/fonts/hrp/style.css" rel="stylesheet">
        <link href="~/assets/styles/pages/report/dynamic-report.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/report/css/dynamic-report.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">Report</li>
    <li class="active">Dynamic Report</li>
</ol>

<form class="search-form" asp-controller="Report" asp-action="DynamicReport" method="post" id="dynamic-report-form">
    <input type="hidden" asp-for="EmployeeStatuses" />
    <input type="hidden" asp-for="SelectedIds" />
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control select2" asp-for="CompanyId" asp-items="Model.Companies"></select>
    </div>
    <div class="group">
        <label class="text">Employee Status</label>
        <input type="hidden" asp-for="EmployeeStatusIds" />
        <select class="control" id="employee-status"></select>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <label class="text blue-txt">List of Data</label>
        <select multiple id="select-list">
            @foreach (var group in Model.Groups)
            {
                <optgroup label="@group.Name" id="opt-@group.GroupId">
                    @foreach (var item in group.Items)
                    {
                        <option data-parent-id="#opt-@group.GroupId" value="@item.Id">@item.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button type="button" class="button -last-next" id="btn-select-all"><span class="icon-last-next"></span></button></li>
            <li><button type="button" class="button -next" id="btn-select"><span class="icon-next"></span></button></li>
            <li><button type="button" class="button -prev" id="btn-deselect"><span class="icon-back"></span></button></li>
            <li><button type="button" class="button -last-prev" id="btn-deselect-all"><span class="icon-last-prev"></span></button></li>
        </ul>
    </div>
    <div class="group">
        <label class="text blue-txt">Export Data</label>
        <select multiple id="selected-list"></select>
    </div>
    <div class="group">
        <ul class="list-button-function">
            <li><button type="button" class="button -next" id="btn-moveup"><span class="icon-up"></span></button></li>
            <li><button type="button" class="button -prev" id="btn-movedown"><span class="icon-down"></span></button></li>
        </ul>
    </div>
    <div class="w-100"></div>
    <div class="group">
        <button type="submit" class="button -excel"><span class="icon-excel"></span>Export Excel</button>
    </div>
</form>


@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>
        <script src="~/assets/js/report/dynamic-report.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/report/js/dynamic-report.min.js"></script>
    </environment>
}