<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/css/fonts/hrp/style.css" asp-append-version="true" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/main.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/main.chunk.css" asp-append-version="true" />
    </environment>

    @RenderSection("Styles", false)
</head>
<body>
    <header class="header">
        <a asp-controller="home" asp-action="index" class="logo">
            <img src="~/css/images/logo_page.svg" alt="logo" />
        </a>
        @await Component.InvokeAsync("Menu")
    </header>
    <div class="content-container">
        <div class="content">
            @RenderBody()
        </div>
    </div>

    @Html.Hidden("RootURL", Url.Content("~/"))

    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/main.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/main.chunk.js" asp-append-version="true"></script>
    </environment>

    @RenderSection("Scripts", required: false)
</body>
</html>