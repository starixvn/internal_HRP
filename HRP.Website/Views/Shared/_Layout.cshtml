<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/ico" href="~/favicon.ico" />

    <environment include="Development">
        <link rel="stylesheet" href="~/assets/styles/base/font-roboto.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/assets/styles/fonts/hrp/style.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/assets/styles/base/reset.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/assets/styles/pages/main.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/assets/bundles/main.min.css" asp-append-version="true" />
    </environment>

    @RenderSection("Styles", false)
</head>
<body>
    <header class="header">
        <a asp-controller="home" asp-action="index" class="logo">
            <img src="~/assets/styles/images/logo_page.svg" alt="logo" />
        </a>
        @await Component.InvokeAsync("Menu")
    </header>
    <div class="content-container">
        <div class="content">
            @RenderBody()
        </div>
    </div>

    @Html.Hidden("RootURL", Url.Content("~/"))

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js" asp-append-version="true"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.js" asp-append-version="true"></script>
        <script src="~/js/common-functions.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>

    @RenderSection("Scripts", required: false)
</body>
</html>