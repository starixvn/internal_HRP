@model HRP.Website.Views.Shared.Components.CheckBoxList.CheckBoxListViewModel

<ul>
    @{
        var count = Model.CheckBoxItems.Count;
        for (int i = 0; i < count; i++)
        {
            <li>
                <label>
                    @Html.CheckBoxFor(x => x.CheckBoxItems[i].Selected)
                    <span>@Model.CheckBoxItems[i].Text</span>
                </label>
            </li>
        }
    }
</ul>