@model HRP.Models.Certificate.GenerateCertificateViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title></title>
    <meta charset="utf-8" />
    <link href="~/assets/styles/pages/certificate/certificate.css" rel="stylesheet" />
</head>
<body>
    <section class="block">
        <a href="#" class="logo">
            <img src="~/assets/styles/images/logo_login.svg" alt="logo" />
        </a>

        @if (Model.IsSystemAdmin)
        {
            <h1 class="title">Generate Certificate</h1>

            if (Model.IsIsSuccessful)
            {
                <div class="msg-success -has-icon">
                    Generate successful. Please download....
                </div>
                <a class="button -primary" asp-controller="certificate" asp-action="download">Download</a>
                <a class="button -primary" asp-controller="home" asp-action="index">Back to Home</a>
            }
            else
            {
                <form asp-controller="Certificate" asp-action="Generate" method="POST">
                    <input hidden asp-for="IsSystemAdmin" />

                    <span asp-validation-for="Password" class="msg-error"></span>
                    <div class="group">
                        <span class="icon-password"></span>
                        <input type="text" asp-for="Password" class="form-control" placeholder="Password" />
                    </div>

                    <div class="group">
                        <input type="submit" value="Generate" class="button -primary" />
                    </div>
                </form>
            }
        }
        else
        {
            <p> File not found. Please contact your system administrator!</p>
        }
    </section>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
    </environment>
</body>
</html>