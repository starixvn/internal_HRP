@model HRP.Models.Certificate.ChangeCertificatePasswordViewModel

@{
    Layout = "_LoginLayout";
}

@section Styles {
    <link href="~/assets/styles/pages/certificate/certificate.css" rel="stylesheet" />
}

<section class="block">
    @if (Model.IsSystemAdmin)
    {
        <h1 class="title">Password Used To Access The Certificate</h1>

        <form asp-controller="Certificate" asp-action="Password" method="POST">
            <input hidden asp-for="IsSystemAdmin" />

            <div class="group">
                <span asp-validation-for="OldPassword" class="msg-error"></span>
                <span asp-validation-for="Password" class="msg-error"></span>
            </div>

            <div class="group">
                <input type="text" asp-for="OldPassword" class="form-control" placeholder="Old Password" />
            </div>
            <div class="group">
                <input type="text" asp-for="Password" class="form-control" placeholder="Password" />
            </div>

            <div class="group">
                <input type="submit" value="Save" class="button -primary" />
            </div>
        </form>
    }
</section>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    </environment>
}