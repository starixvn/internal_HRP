@{
    Layout = "_LoginLayout";
    var isSystemAdmin = ViewData["IsSystemAdmin"] != null && bool.Parse(ViewData["IsSystemAdmin"].ToString());
}

<section class="block">
    @if (isSystemAdmin)
    {
        <h1 class="title">File not found.</h1>
    }
    else
    {
        <h1 class="title">File not found. Please contact your system administrator!</h1>
    }
</section>