@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Models.UserManagement

@model UserManagementViewModel

@{
    var rowNumber = 1;
    ViewData["Title"] = ViewLang.UserManagement;
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/configuration/user-management.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet" />
        <link href="~/assets/bundles/user/css/user-management.min.css" rel="stylesheet" />
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Configuration</li>
    <li class="active">@ViewLang.UserManagement</li>
</ol>
<form class="search-form" asp-action="Index" asp-controller="UserManagement" method="get">
    <div class="group">
        <label class="text">@ViewLang.Status</label>
        <select class="control js-select2" asp-for="Status">
            <option>@ViewLang.All</option>
            <option value="@UserStatus.Active">@ViewLang.Active</option>
            <option value="@UserStatus.Inactive">@ViewLang.Inactive</option>
        </select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="top-header">
    <div class="pull-left">
        @if (Model.IsHost)
        {
            <a asp-action="CreateUser" asp-controller="UserManagement" class="button -add create-user" id="btn-create-user">
                <span class="icon-add"></span>
                @ViewLang.CreateNewUser
            </a>
        }
    </div>
    <div class="pull-right search-box">
        <input type="search" id="quick-search" class="control" placeholder="Search" />
        <span class="icon-search"></span>
    </div>
</div>

<table id="user-table" class="table table-bordered table-hover table-responsive table-striped">
    <thead>
        <tr>
            <th>@ViewLang.SymbolCount</th>
            <th>@ViewLang.Username</th>
            <th>@ViewLang.FullName</th>
            <th>@ViewLang.PhoneNo</th>
            <th>@ViewLang.EmailAdd</th>
            <th>@ViewLang.Creator</th>
            <th>@ViewLang.CreatedDate</th>
            <th>@ViewLang.Active</th>
            <th>@ViewLang.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr id="user-@user.UserId">
                <td class="text-center">@rowNumber</td>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Phone</td>
                <td>@user.Email</td>
                <td class="text-center">@user.CreatedBy</td>
                <td class="text-center">@Html.DisplayFor(x => user.CreatedDate)</td>
                <td class="text-center has-icon">
                    @if (user.IsActive)
                    {
                        <span class="icon-active"></span>
                    }
                </td>
                <td class="text-center has-icon">
                    <div class="dropdown config-action">
                        <button class="btn btn-default dropdown-toggle" type="button" id="dropdown-@user.UserId" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <span class="icon-configuration"></span>
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdown-@user.UserId">
                            @if (Model.IsHost && !user.IsSystemAdmin)
                            {
                                <li>
                                    <a asp-action="EditUser" asp-controller="UserManagement" asp-route-id="@user.UserId">
                                        <span class="icon-details"></span>@ViewLang.EditUserDetails
                                    </a>
                                </li>
                                <li>
                                    <a asp-action="AssignPermission" asp-controller="UserManagement" asp-route-id="@user.UserId">
                                        <span class="icon-permission"></span>@ViewLang.EditUserPermission
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-action="EditUser" asp-controller="UserManagement" asp-route-id="@user.UserId">
                                        <span class="icon-edit"></span>@ViewLang.ViewUserDetails
                                    </a>
                                </li>
                                <li>
                                    <a asp-action="AssignPermission" asp-controller="UserManagement" asp-route-id="@user.UserId">
                                        <span class="icon-permission"></span>@ViewLang.ViewUserPermission
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/assets/js/user/user-management.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/user/js/user-management.min.js"></script>
    </environment>
}