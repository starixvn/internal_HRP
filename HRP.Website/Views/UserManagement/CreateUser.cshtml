@using HRP.Models
@model CreateUserViewModel

<h2>User Management / Create New User</h2>
<form class="form-horizontal" asp-action="CreateUser" asp-controller="UserManagement" id="create-user-form"
      data-ajax-method="post" data-ajax="true" data-ajax-begin="createUser.onCreateBegin" data-ajax-success="createUser.onCreateSuccess" data-ajax-complete="createUser.onCreateComplete">
    <div class="form-group">
        <label asp-for="Username" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <input type="text" class="form-control" asp-for="Username">
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <input type="password" class="form-control" asp-for="Password">
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="FullName" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <input type="text" class="form-control" asp-for="FullName">
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <input type="text" class="form-control" asp-for="PhoneNumber">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <input type="text" class="form-control" asp-for="Email">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="IsActive" class="col-sm-1 control-label"></label>
        <div class="col-sm-6">
            <div class="checkbox">
                <label>
                    <input type="checkbox" asp-for="IsActive">
                </label>
            </div>
            <span asp-validation-for="IsActive" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-offset-1 col-sm-6">
            <button id="btn-create" type="submit" class="btn btn-primary" data-loading-text="Saving...">Save</button>
            <a asp-action="Index" asp-controller="UserManagement" class="btn btn-danger">Cancel</a>
        </div>
    </div>
</form>

<div class="alert alert-success alert-dismissible hidden" role="alert" id="create-user-alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <span></span>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/assets/js/create-user.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.min.js"></script>
        <script src="~/assets/js/create-user.min.js"></script>
    </environment>
}
