@using HRP.Models
@using HRP.Resources
@model CreateUserViewModel

@section Styles {
    <link href="~/assets/bundles/user/css/user-management.min.css" rel="stylesheet" />
}

<ol class="breadcrumb">
    <li class="like-link">Configuration</li>
    <li><a asp-action="index">@ViewLang.UserManagement</a></li>
    <li class="active">@ViewLang.CreateNewUser</li>
</ol>
<form class="form-information block" asp-action="CreateUser" asp-controller="UserManagement" id="create-user-form"
      data-ajax-method="post" data-ajax="true" data-ajax-begin="createUser.onCreateBegin" data-ajax-failure="commonFunctions.handleAjaxError"
      data-ajax-success="createUser.onCreateSuccess" data-ajax-complete="createUser.onCreateComplete">
    <div class="-has-icon msg-success hidden" id="create-user-alert">
        <span id="alert-message"></span>
    </div>

    <div class="-has-icon msg-error hidden" id="create-user-error-alert">
    </div>

    <label asp-for="Username" class="text -has-required"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Username">
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <label asp-for="Password" class="text -has-required"></label>
    <div class="group-control">
        <input type="password" class="control" asp-for="Password">
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <label asp-for="FullName" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="FullName">
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <label asp-for="PhoneNumber" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="PhoneNumber">
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <label asp-for="Email" class="text -has-required"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Email">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="group-control -option-check">
        <label asp-for="IsActive" class="text pull-left"></label>
        <label class="pull-left">
            <input type="checkbox" asp-for="IsActive" id="IsStatus" />
            <span class="label-text">@ViewLang.Active</span>
        </label>
        <label class="show-password">
            <input type="checkbox" name="show-password" id="show-password" />
            <span class="label-text">@ViewLang.ShowPassword</span>
        </label>
    </div>
    <div class="list-button">
        <a asp-action="Index" asp-controller="UserManagement" class="button -second">@ViewLang.Cancel</a>
        <button id="btn-create" type="submit" class="button -primary" data-loading-text="@ViewLang.Saving ...">@ViewLang.Save</button>
    </div>
    <div class="note">
        <p>@ViewLang.CreateUserNoteTitle</p>
        <ul class="list">
            @{ 
                var notes = ViewLang.CreateUserNotes.Split(';');
                foreach(var note in notes)
                {
                    <li>@note</li>
                }
            }
        </ul>
    </div>
</form>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/assets/js/create-user.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/user/js/create-user.min.js"></script>
    </environment>
}