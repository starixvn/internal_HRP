@using HRP.Models
@using HRP.Models.UserPermission

@model AssignPermissionViewModel

@{
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

@foreach (FunctionModel function in Model.Functions)
{
    int colIndex = 1;
    <tr class="@(function.Level == 0 ? "row-special" : string.Empty)">
        @if (function.Level == 0)
        {
            <td class="level-first">
                <span class="icon-ui icon-level-first"></span>
                <span class="func-name">@function.Name</span>
            </td>
        }
        else
        {
            <td>
                @for (int i = 0; i < function.Level - 1; i++)
                {
                    <span class="icon-root_tree icon-level-second" style="visibility: hidden"></span>
                }
                <span class="icon-root_tree icon-level-second "></span>
                <span class="func-name">@function.Name</span>
            </td>
        }

        <td class="text-center">
            <label>
                <input type="checkbox" class="checkAllRowFunc" data-fid="@function.FunctionId" data-pid="@function.ParentId" @disabled />
                <span class="null"></span>
            </label>
        </td>
        @foreach (Company company in Model.Companies)
        {
            var permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == function.FunctionId && x.CompanyId == company.CompanyId);
            <td class="text-center @(colIndex % 2 == 1 ? "col-odd" : string.Empty)">
                <label>
                    <input type="checkbox" name="criteria.funcRead" id="funcRead@(function.FunctionId)@(company.CompanyId)"
                           data-cid="@company.CompanyId" data-pid="@function.ParentId" data-fid="@function.FunctionId"
                           @(permission != null && permission.IsRead ? "checked" : string.Empty) @disabled />
                    <span class="null"></span>
                </label>
            </td>
            <td class="text-center @(colIndex % 2 == 1 ? "col-odd" : string.Empty)">
                <label>
                    <input type="checkbox" name="criteria.funcHost" id="funcHost@(function.FunctionId)@(company.CompanyId)"
                           data-cid="@company.CompanyId" data-pid="@function.ParentId" data-fid="@function.FunctionId"
                           @(permission != null && permission.IsHost ? "checked" : string.Empty) @disabled />
                    <span class="null"></span>
                </label>
            </td>

            colIndex++;
        }
    </tr>

    var model = new AssignPermissionViewModel
    {
        UserId = Model.UserId,
        Username = Model.Username,
        Functions = function.Childs.OrderBy(x => x.Level),
        Companies = Model.Companies,
        UserPermissions = Model.UserPermissions,
        IsHost = Model.IsHost
    };

    @Html.Partial("_TreeFunction", model)
}