@using HRP.Models.UserManagement
@using HRP.Resources
@model EditUserViewModel

<ol class="breadcrumb">
    <li><a asp-action="index">@ViewLang.UserManagement</a></li>
    <li class="active">@(string.Format("{0} {1}", ViewLang.EditDetails, Model.Username))</li>
</ol>
<form class="form-information block" asp-action="EditUser" asp-controller="UserManagement" id="edit-user-form"
      data-ajax-method="post" data-ajax="true" data-ajax-begin="editUser.onEditBegin"
      data-ajax-success="editUser.onEditSuccess" data-ajax-complete="editUser.onEditComplete">

    <input type="hidden" asp-for="UserId" />

    <label asp-for="FullName" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="FullName">
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <label asp-for="Phone" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Phone">
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <label asp-for="Email" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Email">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="group-control -option-check">
        <label asp-for="IsActive" class="text pull-left"></label>
        <div class="pull-left">
            <input type="checkbox" asp-for="IsActive" id="IsStatus" />
            <label class="label-text" for="IsStatus">@ViewLang.Active</label>
        </div>
    </div>

    <div class="btn-list">
        <a asp-action="Index" asp-controller="UserManagement" class="button -second">@ViewLang.Cancel</a>
        <button id="btn-edit" type="submit" class="button -primary" data-loading-text="@ViewLang.Saving ...">@ViewLang.Save</button>
    </div>
</form>
<div class="alert alert-success alert-dismissible hidden" role="alert" id="edit-user-alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <span>User @Model.Username has been successfully updated.</span>
</div>

@section Styles{
    <link href="~/assets/bundles/user-management.min.css" rel="stylesheet" />
}

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/assets/js/edit-user.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.min.js"></script>
        <script src="~/assets/js/edit-user.min.js"></script>
    </environment>
}