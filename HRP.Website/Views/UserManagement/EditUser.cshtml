@using HRP.Models.UserManagement
@using HRP.Resources
@model EditUserViewModel
@{
    var title = Model.CanEdit ? ViewLang.EditUserDetails : ViewLang.ViewUserDetails;
    ViewData["Title"] = title;
}
@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/user/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/user/create.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/user/edit.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/user/edit.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="like-link">@ViewLang.Configuration</li>
    <li><a asp-action="index">@ViewLang.UserManagement</a></li>
    <li class="active">@(string.Format("{0} '{1}'", title, Model.Username))</li>
</ol>
<form class="form-information block" asp-action="EditUser" asp-controller="UserManagement" id="edit-user-form"
      data-ajax-method="post" data-ajax="true" data-ajax-begin="editUser.onEditBegin" data-ajax-failure="commonFunctions.handleAjaxError"
      data-ajax-success="editUser.onEditSuccess" data-ajax-complete="editUser.onEditComplete">

    <input type="hidden" asp-for="UserId" />
    <input type="checkbox" hidden asp-for="CanEdit" />

    <div class="list-message-error hidden" id="validation-summary">
        <span asp-validation-for="FullName" class="message"></span>
        <span asp-validation-for="Phone" class="message"></span>
        <span asp-validation-for="Email" class="message"></span>
    </div>

    <div class="msg-success -has-icon hidden" role="alert" id="edit-user-alert">
        @string.Format(Message.EditUserSuccess, Model.Username)
    </div>

    <div class="-has-border msg-error hidden" id="edit-user-error-alert">
        <span></span>
    </div>

    <label asp-for="FullName" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="FullName" />
    </div>

    <label asp-for="Phone" class="text"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Phone" />
    </div>

    <label asp-for="Email" class="text -has-required"></label>
    <div class="group-control">
        <input type="text" class="control" asp-for="Email" />
    </div>

    @if (Model.IsSystemAdmin)
    {
        <input type="hidden" asp-for="IsActive" />
    }
    else
    {
        <div class="group-control -option-check">
            <label asp-for="IsActive" class="text pull-left"></label>
            <label class="pull-left">
                <input type="checkbox" asp-for="IsActive" id="IsStatus" />
                <span class="label-text">@ViewLang.Active</span>
            </label>
        </div>
    }

    <div class="list-button">
        <a href="javascript:history.back()" class="button -second">@ViewLang.Cancel</a>
        @if (Model.CanEdit)
        {
            <button id="btn-edit" type="submit" class="button -primary" data-loading-text="@ViewLang.Saving ...">@ViewLang.Save</button>
        }
    </div>
</form>