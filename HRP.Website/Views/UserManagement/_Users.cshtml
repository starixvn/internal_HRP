@using HRP.Core.Constants
@using HRP.Models
@using HRP.Resources
@model IEnumerable<UserModel>

@{
    var canEditUserInfo = ViewBag.CanEditUserInfo;
    var rowNumber = 1;
}

<table id="user-table" class="table table table-bordered table-hover table-responsive">
    <thead>
        <tr>
            <th>@ViewLang.SymbolCount</th>
            <th>@ViewLang.Username</th>
            <th>@ViewLang.FullName</th>
            <th>@ViewLang.UserTable_Phone</th>
            <th>@ViewLang.UserTable_Email</th>
            <th>@ViewLang.Creator</th>
            <th>@ViewLang.CreatedDate</th>
            <th>@ViewLang.Active</th>
            <th>@ViewLang.Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr id="user-@user.UserId">
                <td class="text-center">@rowNumber</td>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Phone</td>
                <td>@user.Email</td>
                <td class="text-center">@user.CreatedBy</td>
                <td class="text-center">@Html.DisplayFor(x => user.CreatedDate)</td>
                <td class="text-center">
                    <span class="icon-active"></span>
                    <!-- <input type="checkbox" asp-for="@user.IsActive" data-user-id="@user.UserId" class="toggle-user-status" /> -->
                </td>
                <td class="text-center">
                    <div class="dropdown config-action">
                        <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <span class="icon-configuration"></span>
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                            @if (canEditUserInfo)
                            {
                                var isSystemAdmin = Convert.ToBoolean(User.FindFirst(x => x.Type == Constants.IsSystemAdmin).Value);

                                if (!user.IsSystemAdmin)
                                {
                                    <li><a asp-action="EditUser" asp-controller="UserManagement" asp-route-id="@user.UserId"><span class="icon-edit"></span>Edit Details</a></li>
                                    <li><a asp-action="AssignPermission" asp-controller="UserManagement" asp-route-id="@user.UserId"><span class="icon-permission"></span>Edit Permission</a></li>
                                }
                                else
                                {
                                    if (isSystemAdmin)
                                    {
                                        <li><a asp-action="EditUser" asp-controller="UserManagement" asp-route-id="@user.UserId"><span class="icon-edit"></span>Edit Details</a></li>
                                    }
                                }

                            }
                        </ul>
                    </div>
                </td>
            </tr>
            rowNumber++;
        }
    </tbody>
</table>
<environment include="Development">
    <script src="~/assets/js/user-management.js"></script>
</environment>
<environment exclude="Development">
    <script src="~/assets/js/user-management.min.js"></script>
</environment>