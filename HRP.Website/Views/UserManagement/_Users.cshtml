@using HRP.Models
@using HRP.Resources
@model IEnumerable<UserModel>

<table id="user-table" class="table table table-bordered table-hover table-responsive">
    <thead>
        <tr>
            <th>@ViewLang.UserTable_UserId</th>
            <th>@ViewLang.UserTable_Username</th>
            <th>@ViewLang.UserTable_FullName</th>
            <th>@ViewLang.UserTable_Phone</th>
            <th>@ViewLang.UserTable_Email</th>
            <th>@ViewLang.UserTable_Creator</th>
            <th>@ViewLang.UserTable_Creator</th>
            <th>@ViewLang.UserTable_Active</th>
            <th>@ViewLang.UserTable_Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr id="user-@user.UserId">
                <td>@user.UserId</td>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Phone</td>
                <td>@user.Email</td>
                <td>@user.CreatedBy</td>
                <td>@Html.DisplayFor(x => user.CreatedDate)</td>
                <td><input type="checkbox" asp-for="@user.IsActive" data-user-id="@user.UserId" class="toggle-user-status" /></td>
                <td></td>
            </tr>
        }
    </tbody>
</table>
<environment include="Development">
    <script src="~/assets/js/user-management.js"></script>
</environment>
<environment exclude="Development">
    <script src="~/assets/js/user-management.min.js"></script>
</environment>
