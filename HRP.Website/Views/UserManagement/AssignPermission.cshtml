@using HRP.Resources
@using HRP.Models
@using HRP.Models.UserPermisson

@model AssignPermissonViewModel

@{
    ViewData["Title"] = ViewLang.AssignPermission;
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

<ol class="breadcrumb">
    <li><a asp-action="index">@ViewLang.UserManagement</a></li>
    <li class="active">@(string.Format("{0} to User '{1}'", ViewData["Title"], Model.Username))</li>
</ol>

<div class="msg-success -has-icon hidden"></div>
<div class="msg-error -has-icon hidden"></div>

<input type="hidden" asp-for="@Model.UserId" />

<table class="table table-bordered super-admin-func assign-permission" id="adminPermissionTable">
    <thead>
        <tr>
            <th rowspan="2">@ViewLang.SuperAdminFunction</th>
            <th colspan="2">@ViewLang.UserPermission</th>
        </tr>
        <tr>
            <th>@ViewLang.Read</th>
            <th>@ViewLang.Host</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Functions != null && Model.Functions.Any(x => x.IsAdmin))
        {
            foreach (FunctionModel parent in Model.Functions.Where(x => x.IsAdmin))
            {
                var permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == parent.FunctionId && x.CompanyId < 0);
                <tr class="row-special">
                    <td class="level-first">
                        <span class="icon-ui icon-level-first"></span>
                        <span class="func-name">@parent.Name</span></td>
                    <td class="text-center">
                        <input type="checkbox" name="criteria.funcRead" data-cid="-1001" data-pid="" data-fid="@parent.FunctionId"
                               @(permission != null && permission.IsRead ? "checked" : string.Empty) @disabled />
                    </td>
                    <td class="text-center">
                        <input type="checkbox" name="criteria.funcHost" data-cid="-1001" data-pid="" data-fid="@parent.FunctionId"
                               @(permission != null && permission.IsHost ? "checked" : string.Empty) @disabled />
                    </td>
                </tr>
                foreach (FunctionModel child in parent.Childs)
                {
                    permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == child.FunctionId && x.CompanyId < 0);
                    <tr>
                        <td>
                            <span class="icon-root_tree icon-level-second"></span>
                            <span class="func-name">@child.Name</span
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="criteria.funcRead" data-cid="-1001" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                   @(permission != null && permission.IsRead ? "checked" : string.Empty) @disabled />
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="criteria.funcHost" data-cid="-1001" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                   @(permission != null && permission.IsHost ? "checked" : string.Empty) @disabled />
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

<table class="table table-bordered func assign-permission" id="userPermissionTable">
    <thead>
        <tr>
            <th rowspan="2">@ViewLang.Function</th>
            <th rowspan="2" class="vertical-bottom"><input type="checkbox" id="checkAllFunc" @disabled /></th>
            @foreach (Company company in Model.Companies)
            {
                <th colspan="2">@company.Name</th>
            }
        </tr>
        <tr>
            @foreach (Company company in Model.Companies)
            {
                <th class="sub-header">
                    <div class="">@ViewLang.Read</div>
                    <input type="checkbox" class="checkAllColFuncRead" name="checkAllColFuncRead" data-cid="@company.CompanyId" @disabled />
                </th>
                <th class="sub-header">
                    <div class="">@ViewLang.Host</div>
                    <input type="checkbox" class="checkAllColFuncHost" name="checkAllColFuncHost" data-cid="@company.CompanyId" @disabled />
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Functions != null && Model.Functions.Any(x => !x.IsAdmin))
        {
            Model.Functions = Model.Functions.Where(x => !x.IsAdmin).OrderBy(x => x.Level);
            @Html.Partial("_TreeFunction", Model)
        }
    </tbody>
</table>
<div class="list-button">
    <a class="button -second" id="btCancel" asp-action="index">@ViewLang.Cancel</a>
    @if (Model.IsHost)
    {
        <a class="button -primary" id="btnSave">@ViewLang.Save</a>
    }
</div>

@section Styles {
    <link href="~/assets/styles/pages/configuration/user-management.css" rel="stylesheet" />
}

@section Scripts {
    <environment include="Development">
        <script src="~/assets/js/assign-permission-to-user.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/js/assign-permission-to-user.min.js"></script>
    </environment>
}