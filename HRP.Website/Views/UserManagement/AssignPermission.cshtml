@using HRP.Resources
@using HRP.Models
@using HRP.Models.UserPermisson

@model AssignPermissonViewModel

@{
    ViewData["Title"] = "Assign Permission";
}
<h2>@ViewData["Title"]</h2>

<input type="hidden" asp-for="@Model.UserId" />

<div class="row">
    <table class="table table-bordered" id="adminPermissionTable">
        <thead>
            <tr>
                <th rowspan="2">@ViewLang.SuperAdminFunction</th>
                <th colspan="2">@ViewLang.UserPermission</th>
            </tr>
            <tr>
                <th>@ViewLang.Read</th>
                <th>@ViewLang.Host</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Functions != null && Model.Functions.Any(x => x.IsAdmin))
            {
                foreach (FunctionModel parent in Model.Functions.Where(x => !x.ParentId.HasValue && x.IsAdmin))
                {
                    var permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == parent.FunctionId && x.CompanyId < 0);
                    <tr>
                        <td>@parent.Name</td>
                        <td>
                            <input type="checkbox" name="criteria.funcRead" data-cid="-1001" data-pid="" data-fid="@parent.FunctionId"
                                   @(permission != null && permission.IsRead ? "checked" : string.Empty) />
                        </td>
                        <td>
                            <input type="checkbox" name="criteria.funcHost" data-cid="-1001" data-pid="" data-fid="@parent.FunctionId"
                                   @(permission != null && permission.IsHost ? "checked" : string.Empty) />
                        </td>
                    </tr>
                    foreach (FunctionModel child in Model.Functions.Where(x => x.ParentId.HasValue && x.ParentId == parent.FunctionId))
                    {
                        permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == child.FunctionId && x.CompanyId < 0);
                        <tr>
                            <td><span>└── </span>@child.Name</td>
                            <td>
                                <input type="checkbox" name="criteria.funcRead" data-cid="-1001" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                       @(permission != null && permission.IsRead ? "checked" : string.Empty) />
                            </td>
                            <td>
                                <input type="checkbox" name="criteria.funcHost" data-cid="-1001" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                       @(permission != null && permission.IsHost ? "checked" : string.Empty) />
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

<div class="row">
    <table class="table table-bordered" id="userPermissionTable">
        <thead>
            <tr>
                <th rowspan="3">@ViewLang.Function</th>
                <th rowspan="2"></th>
                @foreach (Company company in Model.Companies)
                {
                    <th colspan="2">@company.Name</th>
                }
            </tr>
            <tr>
                @foreach (Company company in Model.Companies)
                {
                    <th>@ViewLang.Read</th>
                    <th>@ViewLang.Host</th>
                }
            </tr>
            <tr>
                <th><input type="checkbox" id="checkAllFunc"></th>
                @foreach (Company company in Model.Companies)
                {
                    <th><input type="checkbox" class="checkAllColFuncRead" data-cid="@company.CompanyId" /></th>
                    <th><input type="checkbox" class="checkAllColFuncHost" data-cid="@company.CompanyId" /></th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Functions != null && Model.Functions.Any(x => !x.IsAdmin))
            {
                foreach (FunctionModel parent in Model.Functions.Where(x => !x.ParentId.HasValue && !x.IsAdmin))
                {
                    <tr>
                        <td>@parent.Name</td>
                        <td><input type="checkbox" class="checkAllRowFunc" data-fid="@parent.FunctionId" data-pid=""></td>
                        @foreach (Company company in Model.Companies)
                        {
                            var permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == parent.FunctionId && x.CompanyId == company.CompanyId);
                            <td>
                                <input type="checkbox" name="criteria.funcRead" data-cid="@company.CompanyId" data-pid="" data-fid="@parent.FunctionId"
                                       @(permission != null && permission.IsRead ? "checked" : string.Empty) />
                            </td>
                            <td>
                                <input type="checkbox" name="criteria.funcHost" data-cid="@company.CompanyId" data-pid="" data-fid="@parent.FunctionId"
                                       @(permission != null && permission.IsHost ? "checked" : string.Empty) />
                            </td>
                        }
                    </tr>
                    foreach (FunctionModel child in Model.Functions.Where(x => x.ParentId.HasValue && x.ParentId == parent.FunctionId))
                    {
                        <tr>
                            <td><span>└── </span>@child.Name</td>
                            <td><input type="checkbox" class="checkAllRowFunc" data-fid="@child.FunctionId" data-pid="@parent.FunctionId" /></td>
                            @foreach (Company company in Model.Companies)
                            {
                                var permission = Model.UserPermissions.FirstOrDefault(x => x.FunctionId == child.FunctionId && x.CompanyId == company.CompanyId);
                                <td>
                                    <input type="checkbox" name="criteria.funcRead"
                                           data-cid="@company.CompanyId" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                           @(permission != null && permission.IsRead ? "checked" : string.Empty) />
                                </td>
                                <td>
                                    <input type="checkbox" name="criteria.funcHost"
                                           data-cid="@company.CompanyId" data-pid="@parent.FunctionId" data-fid="@child.FunctionId"
                                           @(permission != null && permission.IsHost ? "checked" : string.Empty) />
                                </td>
                            }
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
<div class="row">
    <button id="btnSave">@ViewLang.Save</button>
    <button id="btCancel">@ViewLang.Cancel</button>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/assets/js/assign-permission-to-user.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/js/assign-permission-to-user.min.js"></script>
    </environment>
}