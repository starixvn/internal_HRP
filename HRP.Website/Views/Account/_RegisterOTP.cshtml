@using HRP.Models.Account
@model SetupOtpViewModel

<p class="intro">The OTP will be required when you make log in to HRP system. You will need to register for the <strong>Mobile Authenticator App</strong> before enabling the OTP.</p>

<ul class="register-otp list-unstyled">
    <li class="steps">
        <h2 class="sub-title">Download Sophos Authenticator on your mobile phone</h2>
        <div class="download-content">
            <div class="logo-sophos">
                <img src="~/assets/styles/images/otp/logo.png" />
            </div>
            <div class="list-download">
                <h3>Sophos Authenticator</h3>
                <p><strong>Sophos Gmbh</strong></p>
                <ul class="list-inline">
                    <li>
                        <a href="https://itunes.apple.com/vn/app/sophos-authenticator/id864224575?mt=8"
                           class="btn-download-ios" target="_parent">
                            <img src="~/assets/styles/images/otp/apple.png" />
                        </a>
                    </li>
                    <li>
                        <a href="https://play.google.com/store/apps/details?id=com.sophos.sophtoken&hl=en"
                           target="_blank" class="btn-download-android">
                            <img src="~/assets/styles/images/otp/google.png" />
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <p class="more-info">Other two-factor authenticator applications such as Google Authenticator, Microsoft Authenticator etc. are also supported.</p>
        <p class="more-info -important">The Date & Time settings on your device must be set to Automatic.</p>
    </li>
    <li class="steps">
        <h2 class="sub-title">Create an account by scanning this QR code with Sophos</h2>
        <div class="qr-code">
            <canvas id="setup-otp-qrcode" class="img"></canvas>
            <p>The new account will be named after your username "<span class="text-username">@Model.Username</span>"</p>
        </div>

        <div class="panel-group manualQRCode" id="manualQRCode" role="tablist" aria-multiselectable="true">
            <div class="panel">
                <div class="panel-heading" role="tab" id="headingQR">
                    <h4 class="panel-title">
                        <a class="collapsed" role="button" data-toggle="collapse" data-parent="#manualQRCode" href="#unableScan" aria-expanded="false" aria-controls="collapseThree">
                            Unable to scan the QR code?
                        </a>
                    </h4>
                </div>
                <div id="unableScan" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingQR">
                    <div class="panel-body">
                        <p>Please input the key below to the Manual Add page in Sophos then click Done (iOS) or Add (Android)</p>
                        <p>
                            Key: <span class="text-key" id="qrcodetext" data-qrcodetext="@Html.Raw(Model.QrCodeText)">@Model.TextCode</span>
                        </p>
                        <div class="example">
                            <div class="col-left">
                                <img src="~/assets/styles/images/otp/manual-ios.png" title="IOS" />
                            </div>
                            <div class="col-right">
                                <img src="~/assets/styles/images/otp/manual-android.png" title="Android" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </li>
    <li class="steps">
        <h2 class="sub-title">Enter the 6-digits code generated by Sophos into the textbox below and then click Verify to complete the registration.</h2>
        <input type="hidden" class="encryption-key" asp-for="RijndaelKey" />
        <input type="hidden" class="encryption-iv" asp-for="RijndaelIV" />
        <form class="form-information form-register"
              asp-action="VerifySetupOTP"
              asp-controller="Account"
              method="post"
              id="verify-setup-otp-form">

            <div class="msg-success -has-icon" id="verify-setup-otp-success">Your Authenticator App is verified</div>
            <div class="msg-error -has-icon" id="verify-setup-otp-fail">Your OTP is invalid or expired.</div>

            <label asp-for="Otp" class="text"></label>
            <fieldset>
                <input asp-for="Otp" class="control encrypt" data-isencrypted="false" />
                <input type="hidden" asp-for="Username" />
                <input type="submit" class="button -primary" id="btnSubmitOtp" value="Verify" />
            </fieldset>
        </form>
    </li>
</ul>