@using HRP.Models.Account
@model SetupOtpViewModel

@{
    ViewData["Title"] = "Setup OTP";
    Layout = "_LoginLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/bundles/account/css/setupotp-standalone.min.css" />
    <link rel="stylesheet" href="~/assets/bundles/account/css/otp.min.css" />
}

<div class="content-container">
    <section class="wrapper">
        <div class="content">
            @Html.Partial("_RegisterOTP", Model)
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/jquery-validate.min.js" type="text/javascript"></script>
    <script src="~/assets/bundles/account/js/setupotp-standalone.min.js" type="text/javascript"></script>
    <script src="~/assets/bundles/account/js/setupotp.min.js" type="text/javascript"></script>
}