@using HRP.Core.Enumerations
@using HRP.Models.Account
@model AccountViewModel

@{
    ViewData["Title"] = "Account";
    Layout = "_Layout";
}

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" asp-append-version="true" href="~/assets/styles/pages/auth/otp.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" asp-append-version="true" href="~/assets/bundles/account/css/otp.min.css" />
    </environment>
}

@section Scripts {
    <environment include="Development">
        <script type="text/javascript" asp-append-version="true" src="~/js/jquery-validate.min.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/lib/qrious/qrious.min.js"></script>

        <script type="text/javascript" asp-append-version="true" src="~/lib/CryptoJS/aes.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/rijndael-service.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/client-encryption.js"></script>

        <script type="text/javascript" asp-append-version="true" src="~/assets/js/account/index.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/account/update-profile.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/account/change-password.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/js/account/otp.js"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" asp-append-version="true" src="~/js/jquery-validate.min.js"></script>
        <script type="text/javascript" asp-append-version="true" src="~/assets/bundles/account/js/account.min.js"></script>
    </environment>
}

<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist" data-active="@Model.ActivePanel.ToString()">
    <li role="presentation">
        <a href="#@AccountTab.Profile.ToString()" aria-controls="home" role="tab" data-toggle="tab">Profile</a>
    </li>
    <li role="presentation">
        <a href="#@AccountTab.ChangePassword.ToString()" aria-controls="profile" role="tab" data-toggle="tab">Change your password</a>
    </li>
    <li role="presentation">
        <a href="#@AccountTab.Otp.ToString()" aria-controls="messages" role="tab" data-toggle="tab">OTP</a>
    </li>
</ul>

<input type="hidden" class="encryption-iv" asp-for="RijndaelIV" id="RijndaelIV" />
<input type="hidden" class="encryption-key" asp-for="RijndaelKey" id="RijndaelKey" />

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane" id="@AccountTab.Profile.ToString()">
        @Html.Partial("_Profile", Model.UserProfileViewModel)
    </div>
    <div role="tabpanel" class="tab-pane" id="@AccountTab.ChangePassword.ToString()">
        @Html.Partial("_Password", Model.ChangePasswordViewModel)
    </div>
    <div role="tabpanel" class="tab-pane otp" id="@AccountTab.Otp.ToString()">
        @(Model.IsOTPRegistered ? Html.Partial("_OTP") : Html.Partial("_RegisterOTP", Model.SetupOtpViewModel))
    </div>
</div>