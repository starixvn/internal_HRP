@using HRP.Models.Account
@model AccountViewModel

@{
    bool isAuthenticated = User.Identity.IsAuthenticated;
    var limitFunctionClass = isAuthenticated ? "" : "limited";

    ViewData["Title"] = "Account";
    Layout = isAuthenticated ? "~/Views/Shared/_Layout.cshtml" : "~/Views/Shared/_LoginLayout.cshtml";
}

@section Scripts
{
    <script src="~/lib/qrious/qrious.min.js" type="text/javascript"></script>
    <script>
        $(document).ready(function() {
            $('.nav-tabs a[href="#@Model.ActivePanel"]').tab('show');

            var qr = new QRious({
                element: document.getElementById('setup-otp-qrcode'),
                padding: 30,
                value: '@Html.Raw(Model.SetupOtpViewModel.QrCodeText)',
                size: 300
        });

            $("#verify-setup-otp-form").on("submit",
                function(e) {
                    e.preventDefault();
                    $.ajax({
                        url: $(this).attr('action'),
                        method: $(this).attr('method'),
                        data: $(this).serialize(),
                        success: function (res, status, xhr) {
                            $("#verify-setup-otp-fail").hide();
                            $("#verify-setup-otp-success").show();

                            $(location).attr("href", '/Account/VerifyOTP').delay(3000);
                        },
                        error: function (request, error) {
                            $("#verify-setup-otp-fail").show();
                            $("#verify-setup-otp-success").hide();
                        }
                    });
                    return false;
                });
        });
    </script>
}

<section class="content-container">
    <div class="content">

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="@limitFunctionClass">
                <a href="#profile" aria-controls="home" role="tab" data-toggle="tab">Profile</a>
            </li>
            <li role="presentation" class="@limitFunctionClass">
                <a href="#password" aria-controls="profile" role="tab" data-toggle="tab">Change your password</a>
            </li>
            <li role="presentation">
                <a href="#otp" aria-controls="messages" role="tab" data-toggle="tab">OTP</a>
            </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane" id="profile">
                @if (isAuthenticated)
                {
                    @Html.Partial("_Profile")
                }
            </div>
            <div role="tabpanel" class="tab-pane" id="password">
                @if (isAuthenticated)
                {
                    @Html.Partial("_Password", Model.ChangePasswordViewModel)
                }
            </div>
            <div role="tabpanel" class="tab-pane otp" id="otp">
                @(Model.IsOTPRegistered ? Html.Partial("_OTP") : Html.Partial("_RegisterOTP", Model.SetupOtpViewModel))
            </div>
        </div>
    </div>
</section>