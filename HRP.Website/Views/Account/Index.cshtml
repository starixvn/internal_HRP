@using HRP.Models.Account
@model AccountViewModel

@{
    ViewData["Title"] = "Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts
    {
    <script>
        $(document).ready(function() {
            $('.nav-tabs a[href="#@Model.ActivePanel"]').tab('show');
        });
    </script>
}

<section class="content-container">
    <div class="content">

        @{
            bool isAuthenticated = User.Identity.IsAuthenticated;
            var limitFunctionClass = isAuthenticated ? "" : "limited";
        }

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="@limitFunctionClass">
                <a href="#profile" aria-controls="home" role="tab" data-toggle="tab">Profile</a>
            </li>
            <li role="presentation" class="@limitFunctionClass">
                <a href="#password" aria-controls="profile" role="tab" data-toggle="tab">Change your password</a>
            </li>
            <li role="presentation">
                <a href="#otp" aria-controls="messages" role="tab" data-toggle="tab">OTP</a>
            </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane" id="profile">
                @if (isAuthenticated)
                {
                    @Html.Partial("_Profile")
                }
            </div>
            <div role="tabpanel" class="tab-pane" id="password">
                @if (isAuthenticated)
                {
                    @Html.Partial("_Password")
                }
            </div>
            <div role="tabpanel" class="tab-pane otp" id="otp">
                @(Model.IsOTPRegistered ? Html.Partial("_OTP") : Html.Partial("_RegisterOTP"))
            </div>
        </div>
    </div>
</section>