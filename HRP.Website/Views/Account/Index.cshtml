@using HRP.Core.Enumerations
@using HRP.Models.Account
@model AccountViewModel
@{
    ViewData["Title"] = "Account";
    Layout = "_Layout";
}

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/auth/otp.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/auth/otp.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/account/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/account/index.chunk.js" asp-append-version="true"></script>
    </environment>
}

<!-- Nav tabs -->
<ul class="nav nav-tabs" role="tablist" data-active="@Model.ActivePanel.ToString()">
    <li role="presentation">
        <a href="#@AccountTab.Profile.ToString()" aria-controls="home" role="tab" data-toggle="tab">Profile</a>
    </li>
    <li role="presentation">
        <a href="#@AccountTab.ChangePassword.ToString()" aria-controls="profile" role="tab" data-toggle="tab">Change your password</a>
    </li>
    <li role="presentation">
        <a href="#@AccountTab.Otp.ToString()" aria-controls="messages" role="tab" data-toggle="tab">OTP</a>
    </li>
</ul>

<input type="hidden" class="encryption-iv" asp-for="RijndaelIV.Value" id="RijndaelIV" />
<input type="hidden" class="encryption-key" asp-for="RijndaelKey.Value" id="RijndaelKey" />

<!-- Tab panes -->
<div class="tab-content">
    <div role="tabpanel" class="tab-pane" id="@AccountTab.Profile.ToString()">
        @await Html.PartialAsync("_Profile", Model.UserProfileViewModel)
    </div>
    <div role="tabpanel" class="tab-pane" id="@AccountTab.ChangePassword.ToString()">
        @await Html.PartialAsync("_Password", Model.ChangePasswordViewModel)
    </div>
    <div role="tabpanel" class="tab-pane otp" id="@AccountTab.Otp.ToString()">
        @(Model.IsOTPRegistered ? await Html.PartialAsync("_OTP") : await Html.PartialAsync("_RegisterOTP", Model.SetupOtpViewModel))
    </div>
</div>