@using HRP.Resources
@model HRP.Models.Account.ChangePasswordViewModel

<form asp-controller="Account" asp-action="ChangePassword" id="change-password-form"
      data-ajax-method="post" data-ajax="true" data-ajax-success="changePassword.onChangeSuccess"
      data-ajax-complete="changePassword.onChangeComplete" data-ajax-failure="changePassword.onFailure">

    <div class="form-information block change-password">
        <div class="msg-success -has-icon hidden" role="alert" id="update-password-success-alert">
            <span>@Message.PasswordChangeSuccessful</span>
        </div>

        <div class="msg-error -has-icon hidden" role="alert" id="update-password-fail-alert">
            <span>@Message.UpdateFail</span>
        </div>

        @*<label class="text" for="old-password">@ViewLang.OldPassword</label>*@
        <label class="text" asp-for="OldPassword"></label>
        <div class="group-control">
            <input asp-for="OldPassword" class="control encrypt" data-isencrypted="false" />
            <span class="msg-error" asp-validation-for="OldPassword"></span>
            <span class="icon-close hidden"></span>
            <span class="msg-error hidden" id="old-password-incorrect">@Message.OldPasswordIncorrect</span>
        </div>

        @*<label class="text" for="new-password">@ViewLang.NewPassword</label>*@
        <label class="text" asp-for="Password"></label>
        <div class="group-control">
            <input asp-for="Password" class="control encrypt" data-isencrypted="false"/>
            <span class="msg-error" asp-validation-for="Password"></span>
        </div>

        @*<label class="text" for="confirm-password">@ViewLang.ConfirmPassword</label>*@
        <label class="text" asp-for="PasswordConfirm"></label>
        <div class="group-control">
            <input asp-for="PasswordConfirm" class="control encrypt" data-isencrypted="false"/>
            <span class="msg-error" asp-validation-for="PasswordConfirm"></span>
        </div>
        <div class="group-control">
            <label>
                <input type="checkbox" id="showPassword" />
                <span>@ViewLang.ShowPassword</span>
            </label>
        </div>
        <div class="list-button">
            <button class="button -second goback" type="button">@ViewLang.Cancel</button>
            <button class="button -primary" id="btn-change-password">@ViewLang.Save</button>
        </div>
        <div class="note">
            <p>@Message.PasswordRuleTitle</p>
            <ul class="list">
                <li>@Message.PasswordRuleLenght</li>
                <li>@Message.PasswordRuleCharacters</li>
            </ul>
        </div>
    </div>
</form>