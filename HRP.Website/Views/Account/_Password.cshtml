@model HRP.Models.UserProfile.ChangePasswordViewModel

<form asp-controller="Account" asp-action="ChangePassword" id="change-password-form"
      data-ajax-method="post" data-ajax="true" data-ajax-success="changePassword.onChangeSuccess"
      data-ajax-complete="changePassword.onChangeComplete">
    <div class="alert alert-success alert-dismissible hidden" role="alert" id="update-password-alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <span>Password updated.</span>
    </div>
    <div class="form-information block">
        <label class="text" for="old-password">Old password</label>
        <div class="group-control">
            <input asp-for="OldPassword" class="control" />
            <span class="msg-error" asp-validation-for="OldPassword"></span>
            <span class="icon-close hidden"></span>
            <span class="msg-error hidden" id="old-password-incorrect"></span>
        </div>
        <label class="text" for="new-password">New password</label>
        <div class="group-control">
            <input asp-for="Password" class="control error" />
            <span class="msg-error" asp-validation-for="Password"></span>
        </div>
        <label class="text" for="confirm-password">Confirm password</label>
        <div class="group-control">
            <input asp-for="PasswordConfirm" class="control" />
            <span class="msg-error" asp-validation-for="PasswordConfirm"></span>
        </div>
        <div class="group-control checkbox">
            <input type="checkbox" id="showPassword" />
            <label class="label-text" for="showPassword">Show password</label>
        </div>
        <div class="btn-list">
            <button class="button -primary" id="btn-change-password">Save</button>
            <button class="button -second">Cancel</button>
        </div>
    </div>
</form>
<environment include="Development">
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/assets/js/change-password.js"></script>
</environment>
<environment exclude="Development">
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/assets/js/change-password.min.js"></script>
</environment>