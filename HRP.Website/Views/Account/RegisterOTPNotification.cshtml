@model string

@{
    ViewData["Title"] = "OTP Registration Required";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles
    {
    <link rel="stylesheet" href="~/assets/styles/pages/auth/otp.css" />
}

<div class="notification-otp">
    <h1 class="title">Dear @Model</h1>
    <ul class="info">
        <li>You have been successfully logged in. However, you must enter the OTP code before you can proceed any transaction on HRP system.</li>
        <li>It's now appears that you have not registered the '<strong>OTP Authenticator</strong>'.</li>
        <li>System has sent you an email to require you to make an OTP. Please check your registered email address.</li>
    </ul>
    <p class="bold">Thank you.</p>
</div>