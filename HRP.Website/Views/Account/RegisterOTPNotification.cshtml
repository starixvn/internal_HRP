@{
    ViewData["Title"] = "OTP Registration Required";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/assets/styles/pages/auth/otp.css"/>
}

<div class="notication-otp">
    <p class="bold">Dear User</p>
    <p class="info">
        <span>You have been successfully logged in. However, you must enter the OTP code before you can proceed any transaction on HRP system.</span>
        <br />
        <span>It's now appears that you have not registered the 'OTP Authenticator'.</span>
        <br />
        <span>System has sent you an email to require you to make an OTP. Please check your registered email address.</span>
        <br />
        <span>Thank you.</span>
    </p>
</div>