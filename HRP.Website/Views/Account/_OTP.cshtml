@using HRP.Resources

<div class="block">
    <p class="info">
        The OTP will be required when you make log in to HRP system.
        You will need to register for the <strong>Mobile Authenticator App</strong> before
        enabling the OTP option.
    </p>
    <p class="info bold otp-info">Register Sophos Authenticator Mobile App<span class="icon-successful"></span></p>
    <p class="info">Click the button below to change the registered device from you secret key.</p>
    <button class="button -primary" data-toggle="modal" data-target="#otp-device-change-warning">Change secret key</button>
</div>

<!-- Modal -->
<div class="modal fade" id="otp-device-change-warning" tabindex="-1" role="dialog">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                 <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>The system will no longer accept the secret key generated on the registered device. Do you want to proceed?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Cancel</button>
                <a asp-action="ResetOtpDevice" asp-controller="Account" class="button -primary">@ViewLang.OK</a>
            </div>
        </div>
    </div>
</div>