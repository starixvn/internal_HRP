<!DOCTYPE html>
<html>
<head>
    <title>HRP System</title>
    <meta charset="utf-8" />
    <link href="assets/bundles/common.min.css" rel="stylesheet" />
</head>
<body>
    <header class="header">
        <a href="#" class="logo">
            <img src="assets/styles/images/logo_page.svg" alt="logo" />
        </a>
        <ul class="main-menu">
            <li class="menu">
                <a href="#" class="link active"><span class="icon-configuration"></span>Configuration</a>
                <ul class="submenu">
                    <li><a href="#" class="link">User Management</a></li>
                    <li><a href="#" class="link">Data Management</a></li>
                </ul>
            </li>
            <li class="menu"><a href="#" class="link"><span class="icon-employee_management"></span>Employee Management</a></li>
            <li class="menu"><a href="#" class="link"><span class="icon-payment"></span>Payment Process</a></li>
            <li class="menu"><a href="#" class="link"><span class="icon-payslip"></span>Payslip</a></li>
            <li class="menu"><a href="#" class="link"><span class="icon-report"></span>Report</a></li>
            <li class="menu"><a href="#" class="link"><span class="icon-exit"></span>Exit</a></li>
        </ul>
        <div class="user-info">
            <div class="dropdown">
                <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    Jennie Thompson 
                    <span class="circle-gray">
                        <span class="icon-user"></span>
                    </span>
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                    <li><a href="/changeProfile.html"><span class="icon-user"></span>Profile</a></li>
                    <li><a href="/changePassword.html"><span class="icon-password"></span>Password</a></li>
                    <li><a href="/registerOTP.html"><span class="icon-otp"></span>OTP</a></li>
                    <li><a href="/login.html"><span class="icon-logout"></span>Sign out</a></li>
                </ul>
            </div>
        </div>
    </header>

    <section class="content-container">
        <div class="content">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="limited">
                    <!--<a href="#profile" aria-controls="home" role="tab" data-toggle="tab"></a>-->
                    <a href="#" aria-controls="home" role="tab" data-toggle="tab">Profile</a>
                </li>
                <li role="presentation" class="limited">
                    <!--<a href="#changePassword" aria-controls="profile" role="tab" data-toggle="tab">Password</a>-->
                    <a href="#" aria-controls="profile" role="tab" data-toggle="tab">Password</a>
                </li>
                <li role="presentation" class="active">
                    <a href="#otp" aria-controls="messages" role="tab" data-toggle="tab">OTP</a>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane" id="profile">
                    <h1 class="username">pgmbrian</h1>
                    <div class="form-information block">
                        <label class="text" for="fullName">Full name</label>
                        <div class="group-control">
                            <input type="text" class="control" id="fullName" />
                        </div>
                        <label class="text" for="phoneNumber">Phone number</label>
                        <div class="group-control">
                            <input type="text" class="control error" id="phoneNumber" />
                            <span class="icon-close"></span>
                            <p class="msg-error">Password must contain at least 8 characters, including UPPER/lowercase and numbers</p>
                        </div>
                        <label class="text" for="email">Email Address<span class="required">*</span></label>
                        <div class="group-control">
                            <input type="email" class="control" id="email" />
                            <span class="icon-successful"></span>
                        </div>
                        <div class="btn-list">
                            <button class="button -primary">Save</button>
                            <button class="button -second">Cancel</button>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane" id="changePassword">
                    <div class="form-information block">
                        <label class="text" for="old-password">Old password</label>
                        <div class="group-control">
                            <input type="password" class="control" id="old-password" />
                            <span class="icon-successful"></span>
                        </div>
                        <label class="text" for="new-password">New password</label>
                        <div class="group-control">
                            <input type="password" class="control error" id="new-password" />
                            <span class="icon-close"></span>
                            <p class="msg-error">Password must contain at least 8 characters, including UPPER/lowercase and numbers</p>
                        </div>
                        <label class="text" for="confirm-password">Confirm password</span></label>
                        <div class="group-control">
                            <input type="password" class="control" id="confirm-password" />
                        </div>
                        <div class="group-control checkbox">
                            <input type="checkbox" id="showPassword" />
                            <label class="label-text" for="showPassword">Show password</label>
                        </div>
                        <div class="btn-list">
                            <button class="button -primary">Save</button>
                            <button class="button -second">Cancel</button>
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane otp active" id="otp">
                    <h1 class="title">Register Mobile Authenticator App</h1>
                    <ul class="register-otp list-unstyled">
                        <li class="steps">
                            <h2 class="sub-title">Download Sophos Authenticator on your mobile phone</h2>
                            <div class="download-content">
                                <div class="logo-sophos">
                                    <img src="/assets/styles/images/otp/logo.png" />
                                </div>
                                <div class="list-download">
                                    <h3>Sophos Authenticator</h3>
                                    <p><strong>Sophos Gmbh</strong></p>
                                    <ul class="list-inline">
                                        <li>
                                            <a href="https://itunes.apple.com/vn/app/sophos-authenticator/id864224575?mt=8"
                                               class="btn-download-ios" target="_parent">
                                                <img src="/assets/styles/images/otp/apple.png" />
                                            </a>
                                        </li>
                                        <li>
                                            <a href="https://play.google.com/store/apps/details?id=com.sophos.sophtoken&hl=en"
                                               target="_blank" class="btn-download-android">
                                                <img src="/assets/styles/images/otp/google.png" />
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <p class="more-info">
                                Other two-factor authenticator applications such as Google Authenticator,
                                Microsoft Authenticator etc. are also supported.
                            </p>
                            <p class="more-info -important">The Date & Time settings on your device must be set to Automatic.</pclass="intro">
                        </li>
                        <li class="steps">
                            <h2 class="sub-title">Create an account by scanning this QR code with Sophos</h2>
                            <div class="qr-code">
                                <img class="img" src="/assets/styles/images/otp/qr.png" />
                                <p>The new account will be named after your username "<span class="text-username">SUPERTEST1</span>"</p>
                            </div>

                            <div class="panel-group manualQRCode" id="manualQRCode" role="tablist" aria-multiselectable="true">
                                <div class="panel">
                                    <div class="panel-heading" role="tab" id="headingQR">
                                        <h4 class="panel-title">
                                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#manualQRCode" href="#unableScan" aria-expanded="false" aria-controls="collapseThree">
                                                Unable to scan the QR code?
                                            </a>
                                        </h4>
                                    </div>
                                    <div id="unableScan" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingQR">
                                        <div class="panel-body">
                                            <p>Key: <span class="text-key">MEHJ5FKS7NFJQNCXIDFNYVBPP6N5ZSDQ</span></p>
                                            <div class="example">
                                                <div class="col-left">
                                                    <img src="/assets/styles/images/otp/manual-ios.png" title="IOS" />
                                                </div>
                                                <div class="col-right">
                                                    <img src="/assets/styles/images/otp/manual-android.png" title="Android" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="steps">
                            <h2 class="sub-title">
                                Enter the 6-digits code generated by Sophos into the textbox
                                below and then click Verify to complete the registration.
                            </h2>
                            <form class="block form-information">
                                <div class="msg-success -has-icon">Your Authenticator App is verified</div>
                                <div class="form-group">
                                    <label class="text">OTP</label>
                                    <input maxlength="6" type="password" class="control" name="otp" id="txtOtp" />
                                </div>
                                <div class="form-group last">
                                    <input type="submit" class="button -primary" id="btnSubmitOtp" value="Verify" />
                                </div>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <script src="assets/js/libs/jquery/jquery-1.11.3.js"></script>
    <script src="assets/js/libs/bootstrap/bootstrap.js"></script>
</body>
</html>
