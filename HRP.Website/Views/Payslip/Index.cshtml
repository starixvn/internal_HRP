@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Models
@using HRP.Models.Payslip

@model PayslipViewModel
@{
    var disabled = Model.IsHost ? string.Empty : "disabled";
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/datatables.net/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/payslip/view-pay-slip.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
    </environment>
}

<ol class="breadcrumb">
    <li class="active">@ViewLang.Payslip</li>
</ol>

<form class="search-form" asp-controller="payslip" asp-action="index" method="get">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" asp-for="Month" />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control js-select2" asp-for="CompanyId" asp-items="Model.Companies"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.SendPayslip</label>
        <select class="control js-select2" asp-for="IsSent" asp-items="@CommonSelectList.IsActive"></select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="top-header">
    <div class="search-box">
        <input type="search" id="quick-search" class="control" placeholder="@ViewLang.Search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered" id="payslip-table">
    <thead>
        <tr>
            <th rowspan="2">@ViewLang.SymbolCount</th>
            <th rowspan="2">ID No.</th>
            <th rowspan="2">@ViewLang.EmployeeName</th>
            <th rowspan="2">@ViewLang.Nickname</th>
            <th rowspan="2">@ViewLang.Section</th>
            <th rowspan="2">@ViewLang.Email</th>
            <th rowspan="2">@ViewLang.TelephoneNo</th>
            <th rowspan="2">@ViewLang.MonthlyPayrollStatus</th>
            <th colspan="2">
                @if (Model.IsHost)
                {
                    <form id="send-payslip-form" asp-controller="payslip" asp-action="SendPayslip" method="post">
                        <input type="submit" class="btn -send-payslip" value="@ViewLang.SendPayslip" />
                    </form>
                }
                else
                {
                    <input type="button" class="btn -send-payslip" value="@ViewLang.SendPayslip" disabled />
                }
            </th>
        </tr>
        <tr>
            <th>@ViewLang.Sent</th>
            <th>
                <label>
                    <input type="checkbox" class="@(Model.IsHost ? "js-checkAll" : string.Empty)" @disabled />
                    <span></span>
                </label>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (PayslipModel payslip in Model.Payslips)
        {
            <tr>
                <td class="text-center"></td>
                <td>@payslip.IDNo</td>
                <td>
                    <a target="_blank" class="employee-name" asp-controller="payslip" asp-action="details" asp-route-id="@payslip.PayrollId">@payslip.FullName</a>
                </td>
                <td class="text-center">@payslip.Nickname</td>
                <td>@payslip.Section</td>
                <td>@payslip.Email</td>
                <td>@payslip.Phone</td>
                <td class="text-center">
                    @switch (payslip.PayrollStatus)
                    {
                        case MonthlyPayrollStatus.Default:
                            <span class="status-default"></span>
                            break;

                        case MonthlyPayrollStatus.Satisfied:
                            <span class="status-done"></span>
                            break;

                        case MonthlyPayrollStatus.Unsatisfied:
                            <span class="status-incorrect"></span>
                            break;
                    }
                </td>
                <td class="text-center"><span class="icon-active"></span></td>
                <td class="text-center">
                    <label>
                        <input type="checkbox" name="id[]" value="@payslip.PayrollId"
                               class="@(Model.IsHost ? "js-checkbox" : string.Empty)" @disabled />
                        <span></span>
                    </label>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/select2/dist/js/select2.js"></script>
        <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatables.net/js/dataTables.bootstrap.js"></script>
        <script src="~/lib/moment/moment.js"></script>
        <script src="~/lib/eonasdan-bootstrap-datetimepicker/src/js/bootstrap-datetimepicker.js"></script>
        <script src="~/assets/js/payslip/payslip.js"></script>
    </environment>
    <environment exclude="Development">
    </environment>
}