

@section Styles {
    <environment include="Development">
        <link href="~/lib/select2/dist/css/select2.css" rel="stylesheet" />
        <link href="~/lib/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/payslip/view-pay-slip.css" rel="stylesheet" />
    </environment>

    <environment exclude="Development">
    </environment>
}

<ol class="breadcrumb">
    <li class="active">Payslip</li>
</ol>

<form class="search-form"  method="post">
    <div class="group">
        <label class="text">Month/Year</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker"  readonly />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">Company</label>
        <select class="control select2">
            <option>DAR</option>
            <option>GWG</option>
            <option>WGI</option>
            <option>EHL</option>
            <option>OW</option>
        </select>
    </div>
    <div class="group">
        <label class="text">Send Payslip</label>
        <select class="control select2">
            <option>All</option>
            <option>Yes</option>
            <option>No</option>
        </select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">Submit</button>
    </div>
</form>
<div class="top-header">
    <div class="search-box">
        <input type="search" class="control" placeholder="Search">        
        <span class="icon-search"></span>
    </div>
</div>
