@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Models
@using HRP.Models.Payslip
@model PayslipViewModel
@{
    ViewData["Title"] = ViewLang.Payslip;
    var disabled = Model.IsHost ? string.Empty : "disabled";
}
@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/payslip/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/payslip/index.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/payslip/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/payslip/index.chunk.js" asp-append-version="true"></script>
    </environment>
}
<ol class="breadcrumb">
    <li class="active">@ViewLang.Payslip</li>
</ol>

<form class="search-form" asp-controller="payslip" asp-action="index" method="get">
    <div class="group">
        <label class="text">@ViewLang.MonthYear</label>
        <div class="calendar">
            <input type="text" class="control datetimepicker" asp-for="Month" data-maxdate="@DateTime.Today" />
            <span class="icon-calendar"></span>
        </div>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Company</label>
        <select class="control js-select2" asp-for="CompanyId" asp-items="Model.Companies"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.SendPayslip</label>
        <select class="control js-select2" asp-for="IsSent">
            <option value="">@ViewLang.All</option>
            <option value="true">@ViewLang.Yes</option>
            <option value="false">@ViewLang.No</option>
        </select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="-has-icon msg-success hidden">
    @Message.SentPayslipSuccessful
</div>
<div class="-has-border msg-error hidden"></div>

<div class="top-header">
    <div class="search-box">
        <input type="search" id="quick-search" class="control" placeholder="@ViewLang.Search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered table-hover table-striped dataTable" id="payslip-table" style="width:100%">
    <thead>
        <tr>
            <th rowspan="2">@ViewLang.SymbolCount</th>
            <th rowspan="2">@ViewLang.IDNo</th>
            <th rowspan="2">@ViewLang.EmployeeName</th>
            <th rowspan="2">@ViewLang.Nickname</th>
            <th rowspan="2">@ViewLang.Section</th>
            <th rowspan="2">@ViewLang.Email</th>
            <th rowspan="2">@ViewLang.TelephoneNo</th>
            <th rowspan="2" class="col-150">@ViewLang.MonthlyPayrollStatus</th>
            <th colspan="2">
                @if (Model.IsHost)
                {
                    <input type="button" class="button -add -send-payslip js-btnSendPayslip" value="@ViewLang.SendPayslip" />
                }
                else
                {
                    <input type="button" class="button -add -send-payslip" value="@ViewLang.SendPayslip" disabled />
                }
            </th>
        </tr>
        <tr>
            <th class="col-50">@ViewLang.Sent</th>
            <th class="col-50">
                <label>
                    <input type="checkbox" class="@(Model.IsHost ? "js-checkAll" : string.Empty)" @disabled />
                    <span></span>
                </label>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (PayslipModel payslip in Model.Payslips)
        {
            <tr>
                <td class="text-center"></td>
                <td>@payslip.IDNo</td>
                <td>
                    <a target="_blank" class="employee-name" asp-controller="payslip" asp-action="details"
                       asp-route-id="@payslip.PayrollId" asp-route-companyId="@Model.CompanyId">@payslip.FullName</a>
                </td>
                <td class="text-center">@payslip.Nickname</td>
                <td>@payslip.Section</td>
                <td>@payslip.Email</td>
                <td>@payslip.Phone</td>
                <td class="text-center">
                    @switch (payslip.PayrollStatus)
                    {
                        case MonthlyPayrollStatus.Default:
                            <span class="status-default"></span>
                            break;

                        case MonthlyPayrollStatus.Satisfied:
                            <span class="status-done"></span>
                            break;

                        case MonthlyPayrollStatus.Unsatisfied:
                            <span class="status-incorrect"></span>
                            break;
                    }
                </td>
                <td class="text-center">
                    <span class="icon-active js-sent @(payslip.IsSent ? string.Empty : "hidden")"></span>
                </td>
                <td class="text-center">
                    <label>
                        <input type="checkbox" name="PayrollIds[]" value="@payslip.PayrollId"
                               class="@(Model.IsHost ? "js-checkbox" : string.Empty)" @disabled />
                        <span></span>
                    </label>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" tabindex="-1" role="dialog" id="modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content -has-title">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                <h4 class="modal-title">@ViewLang.Confirmation</h4>
            </div>
            <div class="modal-body">
                <form id="send-payslip-form" class="form-information" asp-controller="payslip" asp-action="SendPayslip"
                      data-ajax-method="post" data-ajax="true"
                      data-ajax-failure="commonFunctions.handleAjaxError" data-ajax-success="payslips.onSendPayslipSuccess">
                    <input type="hidden" name="companyId" value="@Model.CompanyId" />
                    <p>@Message.SendPayslipConfirmationMessage</p>
                    <div class="list-button">
                        <button class="button -primary" type="submit" id="btn-yes">@ViewLang.Yes</button>
                        <button type="button" class="button -second" data-dismiss="modal">@ViewLang.No</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>