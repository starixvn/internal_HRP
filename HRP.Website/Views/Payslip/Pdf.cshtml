@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Core.Extensions
@using HRP.Models.Payslip

@model PayslipDetailModel

@{
    Layout = null;
    var salaryCurrencyCode = Model.SalaryCurrencyCode;
    var allowanceCurrencyCode = Model.AllowanceCurrencyCode;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <environment include="Development">
        <link href="~/css/dev/pages/payslip/pdf.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/payslip/pdf.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
</head>
<body>
    <div class="container">
        <div class="label-company-name bold">@Model.CompanyName</div>
        <div class="bold label-payslip">@ViewLang.Payslip.ToUpperInvariant()</div>
        <div class="red bold label-confidential">(@ViewLang.Confidential.ToUpperInvariant())</div>
        <div class="bold label-month">@Html.DisplayFor(x => x.Month)</div>
        <table>
            <tbody>
                <tr class="employee-info">
                    <td colspan="2" class="align-right">@ViewLang.EmployeeName:</td>
                    <td colspan="2">@Model.FullName</td>
                </tr>
                <tr class="employee-info">
                    <td colspan="2" class="align-right">@ViewLang.IDNo:</td>
                    <td colspan="2">@Model.IDNo</td>
                </tr>
                <tr class="header">
                    <td class="border-top border-left">@ViewLang.MonthlyBasicSalary.ToUpperInvariant()</td>
                    <td class="border-top"></td>
                    <td class="border-top border-left">@ViewLang.MonthlyAllowances.ToUpperInvariant()</td>
                    <td class="border-top border-right"></td>
                </tr>
                <tr class="body">
                    <td class="key border-left">@ViewLang.BasicSalary</td>
                    <td class="value align-right">@Model.SalaryAmount @Model.SalaryCurrencyCode</td>
                    <td class="key border-left">@ViewLang.BasicAllowances</td>
                    <td class="value border-right align-right">@Model.AllowanceAmount @Model.AllowanceCurrencyCode</td>
                </tr>
                @{
                    var salaryLength = Model.SalaryAdditions.Count;
                    var allowanceLength = Model.AllowanceAdditions.Count;
                    var total = salaryLength > allowanceLength ? salaryLength : allowanceLength;
                }

                @for (int i = 0; i < total; i++)
                {
                    <tr class="body">
                        @if (i < salaryLength)
                        {
                            <td class="key border-left">@(((MonthlySalaryAdditionType)Model.SalaryAdditions[i].Type).GetDisplayName())</td>
                            <td class="value align-right">@Model.SalaryAdditions[i].NetSalaryDisplay @Model.SalaryCurrencyCode</td>
                        }
                        else
                        {
                            <td class="border-left"></td>
                            <td></td>
                        }
                        @if (i < allowanceLength)
                        {
                            <td class="key border-left">@(((MonthlyAllowanceAdditionType)Model.AllowanceAdditions[i].Type).GetDisplayName())</td>
                            <td class="value border-right align-right">@Model.AllowanceAdditions[i].NetAllowanceToDisplay @Model.AllowanceCurrencyCode</td>
                        }
                        else
                        {
                            <td class="border-left"></td>
                            <td class="border-right"></td>
                        }
                    </tr>
                }
                <tr class="footer">
                    <td class="key border-left bold">@ViewLang.GrossBasicSalary.ToUpperInvariant()</td>
                    <td class="value align-right bold">@Model.GrossSalaryAmount @Model.SalaryCurrencyCode</td>
                    <td class="key border-left bold">@ViewLang.GrossAllowances.ToUpperInvariant()</td>
                    <td class="value border-right align-right bold">@Model.GrossAllowanceAmount @Model.AllowanceCurrencyCode</td>
                </tr>

                <tr class="header">
                    <td class="border-left">@ViewLang.Deduction.ToUpperInvariant()</td>
                    <td></td>
                    <td class="border-left">@ViewLang.Deduction.ToUpperInvariant()</td>
                    <td class="border-right"></td>
                </tr>
                @{
                    var allowanceDeductions = Model.AllowanceDeductions
                        .Where(x => x.Type != (byte)MonthlyAllowanceAdditionType.SpecialAllowances && x.Type != (byte)MonthlyAllowanceAdditionType.OT).ToList();
                    salaryLength = Model.SalaryDeductions.Count;
                    allowanceLength = allowanceDeductions.Count();
                    total = salaryLength > allowanceLength ? salaryLength : allowanceLength;
                }

                @for (int i = 0; i < total; i++)
                {
                    <tr class="body">
                        @if (i < salaryLength)
                        {
                            <td class="key border-left">@(((MonthlySalaryDeductionType)Model.SalaryDeductions[i].Type).GetDisplayName())</td>
                            <td class="value align-right">@Model.SalaryDeductions[i].NetSalaryDisplay @Model.SalaryCurrencyCode</td>
                        }
                        else
                        {
                            <td class="border-left"></td>
                            <td></td>
                        }
                        @if (i < allowanceLength)
                        {
                            <td class="key border-left">@(((MonthlyAllowanceAdditionType)allowanceDeductions[i].Type).GetDisplayName())</td>
                            <td class="value border-right align-right">@allowanceDeductions[i].NetAllowanceToDisplay @Model.AllowanceCurrencyCode</td>
                        }
                        else
                        {
                            <td class="border-left"></td>
                            <td class="border-right"></td>
                        }
                    </tr>
                }
                <tr class="footer">
                    <td class="key border-left bold">@ViewLang.MonthlyDeductions.ToUpperInvariant()</td>
                    <td class="value align-right red bold">@Model.SalaryDeductionAmount @Model.SalaryCurrencyCode</td>
                    <td class="key border-left bold">@ViewLang.MonthlyDeductions.ToUpperInvariant()</td>
                    <td class="value border-right align-right red bold">@Model.AllowanceDeductionAmount @Model.AllowanceCurrencyCode</td>
                </tr>
                <tr class="footer net-amount">
                    <td class="key bold border-bottom border-left">@ViewLang.NetMonthlyBasicSalary.ToUpperInvariant()</td>
                    <td class="value align-right bold border-bottom">@Model.NetSalaryAmount @salaryCurrencyCode</td>
                    <td class="key bold border-bottom border-left">@ViewLang.NetMonthlyAllowances.ToUpperInvariant()</td>
                    <td class="value align-right bold border-right border-bottom">@Model.NetAllowanceAmount @allowanceCurrencyCode</td>
                </tr>
            </tbody>
        </table>
        <div class="note">
            @ViewLang.PayslipNote
        </div>
    </div>
</body>
</html>