@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Core.Extensions
@using HRP.Models.Payslip
@using HRP.Models.MonthlyPayroll

@model PayslipDetailModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewLang.PayslipDetails</title>
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <environment include="Development">
        <link href="~/assets/styles/pages/payslip/payslip-detail.css" rel="stylesheet" />
    </environment>
    <environment exclude="Development">
        <link href="~/assets/bundles/payslip/css/payslip-details.min.css" rel="stylesheet" />
    </environment>
</head>
<body>
    <input hidden value="@ViewData["RijndaelKey"].ToString()" id="RijndaelKey" />
    <input hidden value="@ViewData["RijndaelIV"].ToString()" id="RijndaelIV" />
    <div class="container payslip-detail-container">
        <div class="employee-info">
            <div class="company-name">@Model.CompanyName</div>
            <div class="payslip-title">
                <div class="bold">@ViewLang.Payslip</div>
                <div class="red bold">(@ViewLang.Confidential)</div>
                <div class="bold">@Html.DisplayFor(x => x.Month)</div>
            </div>
            <table class="tbl-main-info">
                <tbody>
                    <tr>
                        <td>@ViewLang.EmployeeName:</td>
                        <td>@Model.FullName</td>
                    </tr>
                    <tr>
                        <td>@ViewLang.IDNo:</td>
                        <td>@Model.IDNo</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="payslip-detail">
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyBasicSalary</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicSalary</div>
                        <div class="value">
                            <span class="js-encrypted hidden">@Model.SalaryAmount</span> @Model.SalaryCurrencyCode
                        </div>
                    </div>
                    @foreach (MonthlySalaryAdditionModel addition in Model.SalaryAdditions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)addition.Type)</div>
                            <div class="value">
                                <span class="js-encrypted hidden">@addition.NetSalaryDisplay</span> @Model.SalaryCurrencyCode
                            </div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossBasicSalary</div>
                        <div class="value total">
                            <span class="js-encrypted hidden">@Model.GrossSalaryAmount</span> @Model.SalaryCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyAllowances</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicAllowances</div>
                        <div class="value">
                            <span class="js-encrypted hidden">@Model.AllowanceAmount</span> @Model.AllowanceCurrencyCode
                        </div>
                    </div>
                    @foreach (MonthlyAllowanceAdditionModel addition in Model.AllowanceAdditions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((AllowanceType)addition.Type)</div>
                            <div class="value">
                                <span class="js-encrypted hidden">@addition.NetAllowanceToDisplay</span> @Model.AllowanceCurrencyCode
                            </div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossAllowances</div>
                        <div class="value total">
                            <span class="js-encrypted hidden">@Model.GrossAllowanceAmount</span> @Model.AllowanceCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    @foreach (MonthlySalaryDeductionModel deduction in Model.SalaryDeductions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryDeductionType)deduction.Type)</div>
                            <div class="value">
                                <span class="js-encrypted hidden">@deduction.NetSalaryDisplay</span> @Model.SalaryCurrencyCode
                            </div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">
                            <span class="js-encrypted hidden">@Model.SalaryDeductionAmount</span> @Model.SalaryCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    @foreach (MonthlyAllowanceDeductionModel deduction in Model.AllowanceDeductions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((AllowanceType)deduction.Type)</div>
                            <div class="value">
                                <span class="js-encrypted hidden">@deduction.NetAllowanceToDisplay</span> @Model.AllowanceCurrencyCode
                            </div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">
                            <span class="js-encrypted hidden">@Model.AllowanceDeductionAmount</span> @Model.AllowanceCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyBasicSalary</div>
                        <div class="value">
                            <span class="js-encrypted hidden">@Model.NetSalaryAmount</span> @Model.SalaryCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyAllowances</div>
                        <div class="value">
                            <span class="js-encrypted hidden">@Model.NetAllowanceAmount</span> @Model.AllowanceCurrencyCode
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="note">@ViewLang.PayslipNote</div>
    </div>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/CryptoJS/aes.js"></script>
        <script src="~/assets/js/rijndael-service.js"></script>
        <script src="~/assets/js/payslip/payslip-details.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/assets/bundles/payslip/js/payslip-details.min.js"></script>
    </environment>
</body>
</html>