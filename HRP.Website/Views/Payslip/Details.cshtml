@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Core.Extensions
@using HRP.Models.Payslip
@using HRP.Models.MonthlyPayroll

@model PayslipDetailModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/assets/bundles/payslip/css/payslip-details.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="employee-info">
            <div class="company-name">@Model.CompanyName</div>
            <div class="payslip-title">
                <div class="bold">@ViewLang.Payslip</div>
                <div class="red bold">(@ViewLang.Confidential)</div>
                <div class="bold">@Html.DisplayFor(x => x.Month)</div>
            </div>
            <table class="tbl-main-info">
                <tbody>
                    <tr>
                        <td>@ViewLang.EmployeeName:</td>
                        <td>@Model.FullName</td>
                    </tr>
                    <tr>
                        <td>@ViewLang.IDNo:</td>
                        <td>@Model.IDNo</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="payslip-detail">
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyBasicSalary</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicSalary</div>
                        <div class="value">@Model.SalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                    @foreach (MonthlySalaryAdditionModel addition in Model.SalaryAdditions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)addition.Type)</div>
                            <div class="value">@addition.NetSalaryDisplay @Model.SalaryCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossBasicSalary</div>
                        <div class="value total">@Model.GrossSalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyAllowances</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicAllowances</div>
                        <div class="value">@Model.AllowanceAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                    @foreach (MonthlyAllowanceAdditionModel addition in Model.AllowanceAdditions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((AllowanceType)addition.Type)</div>
                            <div class="value">@addition.NetAllowanceToDisplay @Model.AllowanceCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossAllowances</div>
                        <div class="value total">@Model.GrossAllowanceAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    @foreach (MonthlySalaryDeductionModel deduction in Model.SalaryDeductions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)deduction.Type)</div>
                            <div class="value">@deduction.NetSalaryDisplay @Model.SalaryCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">@Model.SalaryDeductionAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    @foreach (MonthlyAllowanceDeductionModel deduction in Model.AllowanceDeductions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((AllowanceType)deduction.Type)</div>
                            <div class="value">@deduction.NetAllowanceToDisplay @Model.AllowanceCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">@Model.AllowanceDeductionAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyBasicSalary</div>
                        <div class="value">@Model.NetSalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyAllowances</div>
                        <div class="value">@Model.NetAllowanceAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="note">@ViewLang.PayslipNote</div>
    </div>
</body>
</html>