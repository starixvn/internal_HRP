@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Core.Extensions
@using HRP.Models.Payslip
@using HRP.Models.MonthlyPayroll

@model PayslipDetailModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/assets/styles/pages/payslip/payslip-detail.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="employee-info">
            <div class="col">
                <div class="row">@Model.CompanyName</div>
                <div class="row bold">@ViewLang.Payslip <span class="red">(@ViewLang.Confidential)</span> @Html.DisplayFor(x => x.Month)</div>
            </div>
            <div class="col">
                <div class="row main-info"><div class="name">@ViewLang.EmployeeName:</div><div class="bold">@Model.FullName</div></div>
                <div class="row main-info"><div class="id">@ViewLang.IDNo:</div><div class="bold">@Model.IDNo</div></div>
            </div>
        </div>
        <div class="payslip-detail">
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyBasicSalary</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicSalary</div>
                        <div class="value">@Model.SalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                    @foreach (MonthlySalaryAdditionModel addition in Model.SalaryAdditions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)addition.Type)</div>
                            <div class="value">@addition.NetSalaryDisplay @Model.SalaryCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossBasicSalary</div>
                        <div class="value total">@Model.GrossSalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.MonthlyAllowances</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.BasicAllowances</div>
                        <div class="value">100.000.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Subsistence</div>
                        <div class="value">2.000.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.HomePassage</div>
                        <div class="value">400.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Housing</div>
                        <div class="value">80.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.MobilePhone</div>
                        <div class="value">70.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.HPI</div>
                        <div class="value">500.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.DutyMeal</div>
                        <div class="value">50.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Secondment</div>
                        <div class="value">5.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Others</div>
                        <div class="value">100.000 @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.GrossAllowances</div>
                        <div class="value total">@Model.GrossAllowanceAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    @foreach (MonthlySalaryDeductionModel deduction in Model.SalaryDeductions)
                    {
                        <div class="row">
                            <div class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)deduction.Type)</div>
                            <div class="value">@deduction.NetSalaryDisplay @Model.SalaryCurrencyCode</div>
                        </div>
                    }
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">@Model.SalaryDeductionAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section">
                <div class="title">@ViewLang.Deduction</div>
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.Subsistence</div>
                        <div class="value">2.000.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.HomePassage</div>
                        <div class="value">400.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Housing</div>
                        <div class="value">80.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.MobilePhone</div>
                        <div class="value">70.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.HPI</div>
                        <div class="value">500.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.DutyMeal</div>
                        <div class="value">50.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Secondment</div>
                        <div class="value">5.000 USD</div>
                    </div>
                    <div class="row">
                        <div class="key">@ViewLang.Others</div>
                        <div class="value">100.000 USD</div>
                    </div>
                </div>
                <div class="footer">
                    <div class="row">
                        <div class="key total">@ViewLang.MonthlyDeductions</div>
                        <div class="value total red">@Model.AllowanceDeductionAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyBasicSalary</div>
                        <div class="value">@Model.NetSalaryAmount @Model.SalaryCurrencyCode</div>
                    </div>
                </div>
            </div>
            <div class="detail-section grand-total">
                <div class="content">
                    <div class="row">
                        <div class="key">@ViewLang.NetMonthlyAllowances</div>
                        <div class="value">@Model.NetAllowanceAmount @Model.AllowanceCurrencyCode</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="note">@ViewLang.PayslipNote</div>
    </div>
</body>
</html>