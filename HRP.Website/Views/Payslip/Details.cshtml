﻿@using HRP.Resources
@using HRP.Core.Enumerations
@using HRP.Core.Extensions
@using HRP.Models.Payslip
@using HRP.Models.MonthlyPayroll

@model PayslipDetailModel

@{
    Layout = null;
    var salaryCurrencyCode = Model.SalaryCurrencyCode;
    var allowanceCurrencyCode = Model.AllowanceCurrencyCode;
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/assets/styles/pages/payslip/payslip-detail.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <table class="info">
            <tbody>
                <tr>
                    <td colspan="2">@Model.CompanyName</td>
                    <td class="align-right">@ViewLang.EmployeeName:</td>
                    <td class="bold">@Model.FullName</td>
                </tr>
                <tr>
                    <td colspan="2" class="bold">@ViewLang.Payslip <span class="red">(@ViewLang.Confidential)</span> @Html.DisplayFor(x => x.Month)</td>
                    <td class="align-right">@ViewLang.IDNo:</td>
                    <td class="bold">@Model.IDNo</td>
                </tr>
            </tbody>
        </table>
        <table>
            <tbody>
                <tr class="header">
                    <td>@ViewLang.MonthlyBasicSalary</td>
                    <td>@ViewLang.MonthlyAllowances</td>
                </tr>
                <tr class="body">
                    <td>
                        <span class="key">@ViewLang.BasicSalary</span>
                        <span class="value">@Model.SalaryAmount @Model.SalaryCurrencyCode</span>
                    </td>
                    <td>
                        <span class="key">@ViewLang.BasicAllowances</span>
                        <span class="value">@Model.AllowanceAmount @Model.AllowanceCurrencyCode</span>
                    </td>
                </tr>
                @{
                    var salaryLength = Model.SalaryAdditions.Count;
                    var allowanceLength = Model.AllowanceAdditions.Count;
                    var total = salaryLength > allowanceLength ? salaryLength : allowanceLength;
                }

                @for (int i = 0; i < total; i++)
                {
                    <tr class="body">
                        @if (i < salaryLength)
                        {
                            <td>
                                <span class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)Model.SalaryAdditions[i].Type)</span>
                                <span class="value">@Model.SalaryAdditions[i].NetSalaryDisplay @Model.SalaryCurrencyCode</span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (i < allowanceLength)
                        {
                            <td>
                                <span class="key">@EnumHelper.GetDescription((AllowanceType)Model.AllowanceAdditions[i].Type)</span>
                                <span class="value">@Model.AllowanceAdditions[i].NetAllowanceToDisplay @Model.AllowanceCurrencyCode</span>
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
                <tr class="footer">
                    <td>
                        <span class="key">@ViewLang.GrossBasicSalary</span>
                        <span class="value">@Model.GrossSalaryAmount @Model.SalaryCurrencyCode</span>
                    </td>
                    <td>
                        <span class="key">@ViewLang.GrossAllowances</span>
                        <span class="value">@Model.GrossAllowanceAmount @Model.AllowanceCurrencyCode</span>
                    </td>
                </tr>
            </tbody>
        </table>

        <table class="row-tbl">
            <tbody>
                <tr>
                    <td class="first-child">
                        <div class="detail-section">
                            <table class="content">
                                <thead>
                                    <tr>
                                        <th class="title" colspan="2">@ViewLang.MonthlyBasicSalary</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.BasicSalary</td>
                                        <td class="value">@Model.SalaryAmount @salaryCurrencyCode</td>
                                    </tr>
                                    @foreach (MonthlySalaryAdditionModel addition in Model.SalaryAdditions)
                                    {
                                        <tr>
                                            <td class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)addition.Type)</td>
                                            <td class="value">@addition.NetSalaryDisplay @salaryCurrencyCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <table class="footer">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.GrossBasicSalary</td>
                                        <td class="value">@Model.GrossSalaryAmount @salaryCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                    <td>
                        <div class="detail-section">
                            <table class="content">
                                <thead>
                                    <tr>
                                        <th class="title" colspan="2">@ViewLang.MonthlyAllowances</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.BasicAllowances</td>
                                        <td class="value">@Model.AllowanceAmount @allowanceCurrencyCode</td>
                                    </tr>
                                    @foreach (MonthlyAllowanceAdditionModel addition in Model.AllowanceAdditions)
                                    {
                                        <tr>
                                            <td class="key">@EnumHelper.GetDescription((AllowanceType)addition.Type)</td>
                                            <td class="value">@addition.NetAllowanceToDisplay @allowanceCurrencyCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <table class="footer">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.GrossAllowances</td>
                                        <td class="value">@Model.GrossAllowanceAmount @allowanceCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <table class="row-tbl">
            <tbody>
                <tr>
                    <td class="first-child">
                        <div class="detail-section">
                            <table class="content">
                                <thead>
                                    <tr>
                                        <th class="title" colspan="2">@ViewLang.Deduction</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (MonthlySalaryDeductionModel deduction in Model.SalaryDeductions)
                                    {
                                        <tr>
                                            <td class="key">@EnumHelper.GetDescription((MonthlySalaryAdditionType)deduction.Type)</td>
                                            <td class="value">@deduction.NetSalaryDisplay @salaryCurrencyCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <table class="footer deduction">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.MonthlyDeductions</td>
                                        <td class="value">@Model.SalaryDeductionAmount @salaryCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                    <td>
                        <div class="detail-section">
                            <table class="content">
                                <thead>
                                    <tr>
                                        <th class="title" colspan="2">@ViewLang.Deduction</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (MonthlyAllowanceDeductionModel deduction in Model.AllowanceDeductions)
                                    {
                                        <tr>
                                            <td class="key">@EnumHelper.GetDescription((AllowanceType)deduction.Type)</td>
                                            <td class="value">@deduction.NetAllowanceToDisplay @allowanceCurrencyCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <table class="footer deduction">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.MonthlyDeductions</td>
                                        <td class="value">@Model.AllowanceDeductionAmount @allowanceCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <table class="row-tbl grand-total">
            <tbody>
                <tr>
                    <td class="first-child">
                        <div class="detail-section">
                            <table class="content">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.NetMonthlyBasicSalary</td>
                                        <td class="value">@Model.NetSalaryAmount @salaryCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                    <td>
                        <div class="detail-section">
                            <table class="content">
                                <tbody>
                                    <tr>
                                        <td class="key">@ViewLang.NetMonthlyAllowances</td>
                                        <td class="value">@Model.NetAllowanceAmount @allowanceCurrencyCode</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="note">
            @ViewLang.PayslipNote
        </div>
    </div>
</body>
</html>