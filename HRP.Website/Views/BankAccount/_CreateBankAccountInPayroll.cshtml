@using HRP.Models.Bank
@using HRP.Resources
@model CreateBankAccountViewModel

@if (Model.HaveCreatePermission)
{
    if (Model.CanCreate)
    {
        <div class="modal fade" tabindex="-1" role="dialog" data-backdrop="static">
            <div class="modal-dialog" role="document">
                <div class="modal-content -has-title">
                    <form class="form-information bank-account-form"
                          asp-action="CreateBankAccount"
                          asp-controller="BankAccount"
                          method="post"
                          data-formstyle="@Model.TypeOfForm"
                          data-ajax="true"
                          data-ajax-method="post"
                          data-ajax-begin="bankAccountForm.onSaveBegin"
                          data-ajax-complete="bankAccountForm.onSaveComplete"
                          data-ajax-success="bankAccountForm.onSaveSuccess"
                          data-ajax-failure="bankAccountForm.onAjaxFailure">
                        <div class="modal-header">
                            <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                            <h4 class="modal-title">New Banking Account</h4>
                        </div>
                        <div class="modal-body">
                            @Html.Partial("_EditBankAccount", Model)
                            <div class="list-button">                                
                                <button class="button -primary"
                                        data-loading-text="@ViewLang.Saving ..."
                                        type="submit">
                                    Save
                                </button>
                                <button type="button" class="button -second" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        @Html.Partial("_CannotCreateMoreBankAccountModal")
    }
}