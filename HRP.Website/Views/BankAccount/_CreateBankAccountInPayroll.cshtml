@using HRP.Models.BankAccount
@using HRP.Resources
@model CreateBankAccountViewModel

@if (Model.HaveHostPermission)
{
    <div class="modal fade modal-bank-account-form" tabindex="-1" role="dialog" data-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content -has-title">

                <form class="form-information bank-account-form" asp-action="CreateBankAccountInPayroll" asp-controller="BankAccount" method="post">

                    <div class="modal-header">
                        <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title">@ViewLang.NewBankingAccount</h4>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" asp-for="EmployeeId" value="@Model.EmployeeId" />

                        <div asp-validation-summary="ModelOnly"></div>

                        <div class="list-message-error hidden">
                            <span asp-validation-for="BankTypeId" class="message"></span>
                            <span asp-validation-for="AccountName" class="message"></span>
                            <span asp-validation-for="AccountNumber" class="message"></span>
                            <span asp-validation-for="BeneficiaryName" class="message"></span>
                            <span asp-validation-for="BankName" class="message"></span>
                            <span asp-validation-for="BankBranch" class="message"></span>
                            <span asp-validation-for="BankAddress" class="message"></span>
                            <span asp-validation-for="AccountTypeId" class="message"></span>
                            <span asp-validation-for="BankSwiftCode" class="message"></span>
                        </div>

                        @if (Model.IsSuccessful)
                        {
                            <input type="hidden" asp-for="IsSuccessful" id="is-successful" />
                            <div class="-has-icon msg-success hidden">
                                <span>@Message.CreateBankAccountSuccessedForModal</span>
                                <span class="count-down-remaining">5</span>
                                <span>@Message.CreateBankAccountSuccessedDimissTime</span>
                            </div>
                        }

                        @*<div class="-has-icon msg-error hidden">
                            </div>*@

                        <div class="layout-two-col">
                            <div>
                                <requiredlabel asp-for="BankTypeId"></requiredlabel>
                                <div class="group-control">
                                    <select class="control check-validate" asp-for="BankTypeId" asp-items="Model.BankTypes"></select>
                                </div>
                            </div>
                            <div>
                                <requiredlabel asp-for="AccountName"></requiredlabel>
                                <div class="group-control">
                                    <input class="control revalidate" asp-for="AccountName" />
                                </div>
                            </div>
                        </div>

                        <requiredlabel asp-for="AccountNumber"></requiredlabel>
                        <div class="group-control">
                            <input class="control revalidate" asp-for="AccountNumber" />
                        </div>


                        <requiredlabel asp-for="BeneficiaryName"></requiredlabel>
                        <div class="group-control">
                            <input class="control" asp-for="BeneficiaryName" />
                        </div>

                        <requiredlabel asp-for="BankName"></requiredlabel>
                        <div class="group-control">
                            <input class="control" asp-for="BankName" />
                        </div>
                        <requiredlabel asp-for="BankBranch"></requiredlabel>
                        <div class="group-control">
                            <input class="control" asp-for="BankBranch" />
                        </div>

                        <requiredlabel asp-for="BankAddress"></requiredlabel>
                        <div class="group-control">
                            <input class="control" asp-for="BankAddress" />
                        </div>

                        <div class="layout-two-col">
                            <div>
                                <requiredlabel asp-for="AccountTypeId"></requiredlabel>
                                <div class="group-control">
                                    <select class="control" asp-for="AccountTypeId" asp-items="Model.BankAccountTypes"></select>
                                </div>
                            </div>
                            <div>
                                <requiredlabel class="text" asp-for="BankSwiftCode"></requiredlabel>
                                <div class="group-control">
                                    <input class="control" asp-for="BankSwiftCode" />
                                </div>
                            </div>
                        </div>
                        <div class="group-control">
                            <label>
                                <input asp-for="IsActive" />
                                <span>@ViewLang.Active</span>
                            </label>
                        </div>
                        <div class="list-button">
                            <button class="button -primary" type="submit" data-ismodal="true">@ViewLang.Save</button>
                            <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Close</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}