@using HRP.Models.BankAccount
@using HRP.Resources
@model CreateBankAccountViewModel

@{
    ViewBag.Title = Message.CreateBankAccount;
    Layout = "_Layout";
}

@section Styles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" />
}

@section Scripts {
    <script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script type="text/javascript" src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
    <script type="text/javascript" src="~/lib/select2/dist/js/select2.min.js"></script>
    <script type="text/javascript" src="~/assets/js/bank/transform-select.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/assets/js/bank/bank-account-form.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/assets/js/bank/state-handler.js" asp-append-version="true"></script>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-action="Index" asp-controller="Employee">@ViewLang.EmployeeList</a></li>
    <li>
        <a id="index-link" asp-action="EmployeeBankAccounts" asp-controller="BankAccount" asp-route-EmployeeId="@Model.EmployeeId">
            @string.Format(ViewLang.EditBankDetailsOfEmployee, Model.NickName)
        </a>
    </li>
    <li class="active">@ViewBag.Title</li>
</ol>

<form class="form-information block bank-account-form" asp-action="CreateBankAccount" asp-controller="BankAccount" method="post">

    <div asp-validation-summary="ModelOnly"></div>

    <div class="list-message-error hidden">
        <span asp-validation-for="BankTypeId" class="message"></span>
        <span asp-validation-for="AccountName" class="message"></span>
        <span asp-validation-for="AccountNumber" class="message"></span>
        <span asp-validation-for="BeneficiaryName" class="message"></span>
        <span asp-validation-for="BankName" class="message"></span>
        <span asp-validation-for="BankBranch" class="message"></span>
        <span asp-validation-for="BankAddress" class="message"></span>
        <span asp-validation-for="AccountTypeId" class="message"></span>
        <span asp-validation-for="BankSwiftCode" class="message"></span>
    </div>

    @if (Model.IsSuccessful)
    {
        <input type="hidden" asp-for="IsSuccessful" id="is-successful" data-ismodal="false" />
        <div class="-has-icon msg-success">
            <span>@Message.CreateBankAccountSuccessedForPage</span>
            <span class="count-down-remaining">5</span>
            <span>@Message.CreateBankAccountSuccessedDimissTime</span>
        </div>
    }

    <div class="-has-border msg-error hidden"></div>

    <input type="hidden" asp-for="EmployeeId" />

    <div class="layout-two-col">
        <div>
            <requiredlabel asp-for="BankTypeId"></requiredlabel>
            <div class="group-control">
                <select class="control" asp-for="BankTypeId" asp-items="Model.BankTypes"></select>
            </div>
        </div>
        <div>
            <requiredlabel asp-for="AccountName"></requiredlabel>
            <div class="group-control">
                <input class="control" asp-for="AccountName" />
            </div>
        </div>
    </div>

    <requiredlabel asp-for="AccountNumber"></requiredlabel>
    <div class="group-control">
        <input class="control" asp-for="AccountNumber" />
    </div>

    <requiredlabel asp-for="BeneficiaryName"></requiredlabel>
    <div class="group-control">
        <input class="control" asp-for="BeneficiaryName" />
    </div>

    <requiredlabel asp-for="BankName"></requiredlabel>
    <div class="group-control">
        <input class="control" asp-for="BankName" />
    </div>
    <requiredlabel asp-for="BankBranch"></requiredlabel>
    <div class="group-control">
        <input class="control" asp-for="BankBranch" />
    </div>

    <requiredlabel asp-for="BankAddress"></requiredlabel>
    <div class="group-control">
        <input class="control" asp-for="BankAddress" />
    </div>

    <div class="layout-two-col">
        <div>
            <requiredlabel asp-for="AccountTypeId"></requiredlabel>
            <div class="group-control">
                <select class="control" asp-for="AccountTypeId" asp-items="Model.BankAccountTypes"></select>
            </div>
        </div>
        <div>
            <requiredlabel class="text" asp-for="BankSwiftCode"></requiredlabel>
            <div class="group-control">
                <input class="control" asp-for="BankSwiftCode" />
            </div>
        </div>
    </div>
    <div class="group-control">
        <label>
            <input asp-for="IsActive" />
            <span>@ViewLang.Active</span>
        </label>
    </div>

    <div class="list-button">
        <a class="button -second back" asp-action="EmployeeBankAccounts" asp-controller="BankAccount" asp-route-Id="@Model.EmployeeId">@ViewLang.Cancel</a>
        <button class="button -primary" type="submit">@ViewLang.Save</button>
    </div>
</form>