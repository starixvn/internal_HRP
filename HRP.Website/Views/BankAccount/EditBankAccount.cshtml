@model HRP.Models.Bank.EditBankAccountViewModel

@{
    ViewBag.Title = "Create Bank Account";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" />
}

@section Scripts {
    <script type="text/javascript" src="~/lib/jquery/dist/jquery.js"></script>
    <script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script type="text/javascript" src="~/assets/js/bank/create-bank-account.js"></script>
}

<ol class="breadcrumb">
    <li><a asp-action="Index" asp-controller="EmployeeManagement">Employee Management</a></li>
    <li>
        <a href="#">Employee List</a>
    </li>
    <li>
        <a asp-action="EditEmployeeBankDetails"
           asp-controller="BankAccount"
           asp-route-EmployeeId="@Model.EmployeeId">Edit Bank Details of Employee '@Model.EmployeeName'</a>
    </li>
    <li class="active">Edit Bank Account</li>
</ol>

<form class="form-information block" asp-action="EditBankAccount" asp-controller="BankAccount" method="post">
    <input type="hidden" asp-for="BankAccount.Id" />
    @Html.Partial("_EditBankAccount", Model)
</form>