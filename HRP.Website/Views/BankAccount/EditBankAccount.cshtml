@model HRP.Models.Bank.EditBankAccountViewModel

@{
    ViewBag.Title = "Edit Bank Account";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" />
}

@section Scripts {
    <script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script type="text/javascript" src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script type="text/javascript" src="~/lib/Microsoft.jQuery.Unobtrusive.Ajax/jquery.unobtrusive-ajax.js"></script>
    <script type="text/javascript" src="~/lib/select2/dist/js/select2.min.js"></script>
    <script type="text/javascript" src="~/assets/js/bank/transform-select.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/assets/js/bank/bank-account-form.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/assets/js/bank/state-handler.js" asp-append-version="true"></script>
}

<ol class="breadcrumb">
    <li class="like-link">Employee Management</li>
    <li><a asp-action="Index" asp-controller="EmployeeManagement">Employee List</a></li>
    <li>
        <a asp-action="EmployeeBankAccounts"
           asp-controller="BankAccount"
           asp-route-EmployeeId="@Model.EmployeeId">Edit Bank Details of Employee '@Model.EmployeeName'</a>
    </li>
    <li class="active">@ViewBag.Title</li>
</ol>

<form class="form-information block bank-account-form"
      asp-action="EditBankAccount"
      asp-controller="BankAccount"
      method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="bankAccountForm.onSaveBegin"
      data-ajax-complete="bankAccountForm.onSaveComplete"
      data-ajax-success="bankAccountForm.onSaveSuccess"
      data-ajax-failure="bankAccountForm.onAjaxFailure">
    <input type="hidden" asp-for="BankAccount.Id" />
    @Html.Partial("_EditBankAccount", Model)
</form>