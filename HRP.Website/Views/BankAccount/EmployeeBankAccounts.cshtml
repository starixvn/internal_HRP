@using HRP.Resources
@using HRP.Models.BankAccount
@using HRP.Models
@model EmployeeBankAccountsViewModel

@{
    ViewBag.Title = string.Format(Model.HaveHostPermission ? Message.EditBankAccountTitle : Message.ViewBankAccountTitle, Model.EmployeeName);
    Layout = "_Layout";
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
        <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
        <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" asp-append-version="true" href="~/assets/bundles/bank/css/bank.min.css"/>
    </environment>
}

@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
        <script type="text/javascript" src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
        <script type="text/javascript" src="~/lib/select2/dist/js/select2.min.js"></script>
        <script type="text/javascript" src="~/assets/js/bank/transform-select.js" asp-append-version="true"></script>
        <script type="text/javascript" src="~/assets/js/bank/employee-bank.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/assets/bundles/bank/js/bank.min.js" asp-append-version="true"></script>
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-action="Index" asp-controller="Employee">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewBag.Title</li>
</ol>

@*Filter form*@
<form asp-action="EmployeeBankAccounts" asp-controller="BankAccount" asp-antiforgery="false" method="get" class="search-form">
    <input asp-for="EmployeeId" type="hidden" />
    <div class="group">
        <label class="text">@ViewLang.BankType</label>
        <select asp-for="BankTypeId" asp-items="@Model.BankTypes"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Active</label>
        <select class="control" asp-for="IsActive" asp-items="@CommonSelectList.IsActive"></select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div id="bank-account-limit-reached-modal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>@Message.BankAccountLimitReached</p>
            </div>
            <div class="modal-footer only-button">
                <button type="button" class="button -second" data-dismiss="modal">@ViewLang.Close</button>
            </div>
        </div>
    </div>
</div>

<div class="top-header">
    <div class="pull-left">
        @if (Model.HaveHostPermission)
        {
            if (Model.BankAccountsLimitReached)
            {
                <a class="button -add create-user" data-toggle="modal" data-target="#bank-account-limit-reached-modal">
                    <span class="icon-add"></span>
                    @ViewLang.CreateNewBankAccount
                </a>
            }
            else
            {
                <a class="button -add create-user" asp-action="CreateBankAccount" asp-controller="BankAccount" asp-route-employeeId="@Model.EmployeeId">
                    <span class="icon-add"></span>
                    @ViewLang.CreateNewBankAccount
                </a>
            }
        }
    </div>

    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" id="quick-search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered table-hover table-striped data-table">
    <thead>
        <tr>
            <th class="col-number">#</th>
            <th>@ViewLang.BankType</th>
            <th>@ViewLang.AccountName</th>
            <th>@ViewLang.AccountNo</th>
            <th>@ViewLang.BeneficiaryName</th>
            <th>@ViewLang.BankName</th>
            <th>@ViewLang.BankBranch</th>
            <th>@ViewLang.TypeOfAccount</th>
            <th>@ViewLang.SwiftCode</th>
            <th>@ViewLang.Active</th>
            @if (Model.HaveHostPermission)
            {
                <th>@ViewLang.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model?.BankAccounts != null && Model.BankAccounts.Any())
        {
            foreach (BankAccount bankAccount in Model.BankAccounts)
            {
                <tr>
                    <td class="text-center"></td>
                    <td>@bankAccount.BankTypeName</td>
                    <td>@bankAccount.AccountName</td>
                    <td>@bankAccount.AccountNumber</td>
                    <td>@bankAccount.BeneficiaryName</td>
                    <td>@bankAccount.BankName</td>
                    <td>@bankAccount.BankBranch</td>
                    <td>@bankAccount.AccountTypeName</td>
                    <td>@bankAccount.BankSwiftCode</td>
                    <td class="text-center has-icon">
                        @if (bankAccount.IsActive)
                        {
                            <span class="icon-active"></span>
                        }
                    </td>
                    @if (Model.HaveHostPermission)
                    {
                        <td class="text-center has-icon">
                            <a class="icon-edit" asp-action="EditBankAccount" asp-controller="BankAccount" asp-route-bankAccountId="@bankAccount.BankAccountId"></a>
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
