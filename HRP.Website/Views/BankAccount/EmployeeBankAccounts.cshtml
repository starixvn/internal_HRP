@using HRP.Resources
@model HRP.Models.Bank.EmployeeBankAccountsViewModel

@{
    ViewBag.Title = string.Format(Model.HaveCreatePermission
        ? ViewLang.EditBankDetailsOfEmployee
        : ViewLang.ViewBankDetailsOfEmployee, Model.EmployeeName);

    Layout = "_Layout";
}

@section Styles {
    <link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" />
    <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/lib/select2/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    @*<script src="~/lib/fanex-multiselect/fanex.multiSelect.js" type="text/javascript"></script>*@
    <script type="text/javascript" src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
    <script type="text/javascript" src="~/lib/select2/dist/js/select2.min.js"></script>
    <script type="text/javascript" src="~/assets/js/bank/transform-select.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/assets/js/bank/employee-bank.js" asp-append-version="true"></script>
}

<ol class="breadcrumb">
    <li class="like-link">Employee Management</li>
    <li><a asp-action="Index" asp-controller="EmployeeManagement">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewBag.Title</li>
</ol>


@*Filter form*@
<form asp-action="EmployeeBankAccounts"
      asp-controller="BankAccount"
      asp-antiforgery="false"
      method="get"
      class="search-form">
    <input asp-for="EmployeeId" type="hidden" />
    <div class="group">
        <label class="text">@ViewLang.BankType</label>
        <select asp-for="SelectedBankType" asp-items="@Model.BankTypes"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Active</label>
        <select class="control" asp-for="IsActiveBankAccount" asp-items="@Model.BankAccountActive"></select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<!--Cannot create more bank account modal-->
@Html.Partial("_CannotCreateMoreBankAccountModal")

<div class="top-header">
    <div class="pull-left">
        @if (Model.HaveCreatePermission)
        {
            if (Model.CanCreate)
            {
                <a class="button -add create-user"
                   asp-action="CreateBankAccount"
                   asp-controller="BankAccount"
                   asp-route-employeeId="@Model.EmployeeId">
                    <span class="icon-add"></span>
                    @ViewLang.CreateNewBankAccount
                </a>
            }
            else
            {
                <button class="button -add create-user" data-toggle="modal" data-target="#reach-limit-modal">
                    <span class="icon-add"></span>
                    @ViewLang.CreateNewBankAccount
                </button>
            }
        }
    </div>

    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" id="quick-search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered table-hover table-striped data-table">
    <thead>
        <tr>
            <th class="col-number">#</th>
            <th>@ViewLang.BankType</th>
            <th>@ViewLang.AccountName</th>
            <th>@ViewLang.AccountNumber</th>
            <th>@ViewLang.BeneficiaryName</th>
            <th>@ViewLang.BankName</th>
            <th>@ViewLang.BankBranch</th>
            <th>@ViewLang.TypeOfAccount</th>
            <th>@ViewLang.SwiftCode</th>
            <th>@ViewLang.Active</th>
            @if (Model.CanEdit)
            {
                <th>@ViewLang.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @for (var index = 0; index < Model.BankAccounts.Count; index++)
        {
            <tr>
                <td class="text-center">@(index + 1)</td>
                @{
                    var bankType = Model.BankTypes.First(x => x.Value == Model.BankAccounts[index].BankType.ToString()).Text;
                    var bankAccountType = Model.BankAccountTypes.First(x => x.Id == Model.BankAccounts[index].AccountType).Name;
                }
                <td>@bankType</td>
                <td>@Model.BankAccounts[index].AccountName</td>
                <td>@Model.BankAccounts[index].AccountNumber</td>
                <td>@Model.BankAccounts[index].BeneficiaryName</td>
                <td>@Model.BankAccounts[index].BankName</td>
                <td>@Model.BankAccounts[index].BankBranch</td>
                <td>@bankAccountType</td>
                <td>@Model.BankAccounts[index].BankSwiftCode</td>
                <td class="text-center has-icon">
                    @if (Model.BankAccounts[index].IsActive)
                    {
                        <span class="icon-active"></span>
                    }
                </td>
                @if (Model.CanEdit)
                {
                    <td class="text-center has-icon">
                        <a class="icon-edit"
                           asp-action="EditBankAccount"
                           asp-controller="BankAccount"
                           asp-route-bankAccountId="@Model.BankAccounts[index].Id"></a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
