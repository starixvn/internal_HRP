@using HRP.Resources
@using HRP.Models.BankAccount
@using HRP.Models
@model EmployeeBankAccountsViewModel
@{
    ViewBag.Title = string.Format(Model.HaveHostPermission ? Message.EditBankAccountTitle : Message.ViewBankAccountTitle, Model.EmployeeName);
    Layout = "_Layout";
}

@section Styles {
    <environment include="Development">
        <link href="~/css/dev/pages/employee/bank-details.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pro/pages/employee/bank-details.chunk.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@section Scripts {
    <environment include="Development">
        <script type="text/javascript" src="~/js/dev/pages/bank-account/index.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script type="text/javascript" src="~/js/pro/pages/bank-account/index.chunk.js" asp-append-version="true"></script>
    </environment>
}

<ol class="breadcrumb">
    <li class="like-link">@ViewLang.EmployeeManagement</li>
    <li><a asp-action="Index" asp-controller="Employee">@ViewLang.EmployeeList</a></li>
    <li class="active">@ViewBag.Title</li>
</ol>

@*Filter form*@
<form asp-action="EmployeeBankAccounts" asp-controller="BankAccount" asp-antiforgery="false" method="get" class="search-form">
    <input asp-for="EmployeeId" type="hidden" />
    <div class="group">
        <label class="text">@ViewLang.BankType</label>
        <select asp-for="BankTypeId" asp-items="@Model.BankTypes"></select>
    </div>
    <div class="group">
        <label class="text">@ViewLang.Active</label>
        <select class="control" asp-for="IsActive">
            <option value="">@ViewLang.All</option>
            <option value="true">@ViewLang.Yes</option>
            <option value="false">@ViewLang.No</option>
        </select>
    </div>
    <div class="group">
        <button type="submit" class="button -primary">@ViewLang.Submit</button>
    </div>
</form>

<div class="top-header">
    <div class="pull-left">
        @if (Model.HaveHostPermission)
        {
            <a class="button -add create-user" asp-action="CreateBankAccount" asp-controller="BankAccount" asp-route-employeeId="@Model.EmployeeId">
                <span class="icon-add"></span>
                @ViewLang.CreateNewBankAccount
            </a>
        }
    </div>

    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" id="quick-search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered table-hover table-striped data-table">
    <thead>
        <tr>
            <th class="col-number">@ViewLang.SymbolCount</th>
            <th>@ViewLang.BankType</th>
            <th>@ViewLang.PaymentTransaction</th>
            <th>@ViewLang.AccountNo</th>
            <th>@ViewLang.BeneficiaryName</th>
            <th>@ViewLang.BankName</th>
            <th>@ViewLang.BankBranch</th>
            <th>@ViewLang.TypeOfAccount</th>
            <th>@ViewLang.SwiftCode</th>
            <th>@ViewLang.Active</th>
            @if (Model.HaveHostPermission)
            {
                <th>@ViewLang.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model?.BankAccounts != null && Model.BankAccounts.Any())
        {
            foreach (BankAccount bankAccount in Model.BankAccounts)
            {
                <tr>
                    <td class="text-center"></td>
                    <td>@bankAccount.BankTypeName</td>
                    <td>@bankAccount.PaymentTransaction</td>
                    <td>@bankAccount.AccountNumber</td>
                    <td>@bankAccount.BeneficiaryName</td>
                    <td>@bankAccount.BankName</td>
                    <td>@bankAccount.BankBranch</td>
                    <td>@bankAccount.AccountTypeName</td>
                    <td>@bankAccount.BankSwiftCode</td>
                    <td class="text-center has-icon">
                        @if (bankAccount.IsActive)
                        {
                            <span class="icon-active"></span>
                        }
                    </td>
                    @if (Model.HaveHostPermission)
                    {
                        <td class="text-center has-icon">
                            <a class="icon-edit" asp-action="EditBankAccount" asp-controller="BankAccount" asp-route-bankAccountId="@bankAccount.BankAccountId"></a>
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>