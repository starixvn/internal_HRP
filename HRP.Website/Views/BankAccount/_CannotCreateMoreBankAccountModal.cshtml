<div id="reach-limit-modal" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog -small" role="document">
        <div class="modal-content -has-icon">
            <div class="modal-header">
                <span class="icon-delete close" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="circle">
                    <span class="icon-warning"></span>
                </div>
                <p>@HRP.Resources.Message.BankAccountLimitReached</p>
            </div>
            <div class="modal-footer only-button">
                <button type="button" class="button -second" data-dismiss="modal">@HRP.Resources.ViewLang.Close</button>
            </div>
        </div>
    </div>
</div>