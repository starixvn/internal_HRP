@model HRP.Models.Bank.EditEmployeeBankDetailsViewModel

@{
    ViewBag.Title = "Edit Bank Details of Employee '" + Model.EmployeeName + "'";
    Layout = "_Layout";
}

@section Styles {
    @*<link href="~/lib/fanex-multiselect/fanex.multiSelect.css" rel="stylesheet" />*@
    <link href="~/lib/datatables.net-bs/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/lib/ultraselect/jquery.ultraselect.css" rel="stylesheet" />
    <link href="~/assets/styles/pages/employee/bank-details.css" rel="stylesheet" />
}

@section Scripts {
    @*<script src="~/lib/fanex-multiselect/fanex.multiSelect.js"></script>*@
    <script src="~/lib/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatables.net-bs/js/dataTables.bootstrap.js"></script>
    <script src="~/lib/ultraselect/jquery.ultraselect.js"></script>
    <script src="~/assets/js/bank/employee-bank.js"></script>
}

<ol class="breadcrumb">
    <li><a asp-action="Index" asp-controller="EmployeeManagement">Employee Management</a></li>
    <li class="active">Edit Bank Details of Employee '@Model.EmployeeName'</li>
</ol>


@*Filter form*@
<form asp-action="EditEmployeeBankDetails" asp-controller="BankAccount" method="get" class="search-form">
    <input asp-for="EmployeeId" type="hidden" />
    <div class="group">
        <label class="text">Bank Type</label>
        <select asp-for="SelectedBankTypes" asp-items="@Model.BankTypes"></select>
    </div>
    <div class="group">
        <label class="text">Active</label>
        <select asp-for="IsActiveBankAccount" asp-items="@Model.BankAccountActive"></select>
    </div>
    <button type="submit" class="button -primary">Submit</button>
</form>

<div class="top-header">
    <div class="pull-left">
        <a class="button -add create-user"
           asp-action="CreateNewBankAccount"
           asp-controller="BankAccount"
           asp-route-employeeId="@Model.EmployeeId">
            <span class="icon-add"></span>
            Create New Bank Account
        </a>
    </div>

    <div class="pull-right search-box">
        <input type="search" class="control" placeholder="Search" id="quick-search" />
        <span class="icon-search"></span>
    </div>
</div>

<table class="table table-bordered table-hover table-striped data-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Bank Type</th>
            <th>Account Name</th>
            <th>Account No.</th>
            <th>Beneficiary Name</th>
            <th>Bank Name</th>
            <th>Branch</th>
            <th>Type of Account</th>
            <th>SWIFT Code</th>
            <th>Active</th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
        @for (var index = 0; index < Model.BankAccounts.Count; index++)
        {
            <tr>
                <td class="text-center">@(index + 1)</td>
                @{
                    var bankType = Model.BankTypes.First(x => x.Value == Model.BankAccounts[index].BankType.ToString()).Text;
                    var bankAccountType = Model.BankAccountTypes.First(x => x.ResourceId == Model.BankAccounts[index].AccountType).Value;
                }
                <td>@bankType</td>
                <td>@Model.BankAccounts[index].AccountName</td>
                <td>@Model.BankAccounts[index].AccountNumber</td>
                <td>@Model.BankAccounts[index].BeneficiaryName</td>
                <td>@Model.BankAccounts[index].BankName</td>
                <td>@Model.BankAccounts[index].BankBranch</td>
                <td>@bankAccountType</td>
                <td>@Model.BankAccounts[index].BankSwiftCode</td>
                <td class="text-center has-icon">
                    @if (Model.BankAccounts[index].IsActive)
                    {
                        <span class="icon-active"></span>
                    }
                </td>
                <td class="text-center has-icon">
                    <a class="icon-edit"
                       asp-action="EditBankAccount"
                       asp-controller="BankAccount"
                       asp-route-bankAccountId="@Model.BankAccounts[index].Id"></a>
                </td>
            </tr>
        }
    </tbody>
</table>
