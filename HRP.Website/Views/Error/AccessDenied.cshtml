@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied</title>
    <link rel="icon" type="image/ico" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/error.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/error.chunk.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <div class="block">
        <img src="~/css/images/405.png" title="Access Denied" />
        <h1 class="title">Access Denied</h1>
        <p class="info">You are not authorized to access this page.</p>
        <a asp-controller="home" asp-action="index" class="button -primary">Back to Home</a>
    </div>
</body>
</html>