@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Page Not Found</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <environment include="Development">
        <link rel="stylesheet" href="~/assets/styles/base/font-roboto.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/assets/styles/base/reset.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/assets/styles/pages/errors/error.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/assets/bundles/errors/error.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <div class="block">
        <img src="~/assets/styles/images/404.png" title="The page not found">
        <h1 class="title">OOPS!</h1>
        <p class="info">Sorry, The Page Not Found</p>
        <button class="button -primary">Back to Home</button>
    </div>    
</body>
</html>